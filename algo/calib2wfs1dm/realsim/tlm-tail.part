
# ==========================================================================================
# calib_2wfs1dm_realsim tail. Everything above this line is lines 1-867 of
# benches/ao3k_scexao/sim-ao3k-scexao.milk, unchanged: bench deployment, calibration of the
# three stages, calibration selfRM, turbulence on, stage 1 and stage 2 closed.
#
# This tail records closed-loop modal telemetry windows for the 2-WFS + 1-DM calibration test.
# For each window it
#   (1) sets the stage-3 (LLOWFS) loop open or closed and lets the loops settle,
#   (2) logs only the modal streams (no camera cubes) for TLW ticks,
#   (3) measures the stage-2 self-response matrix as the optical-gain reference,
#   (4) runs the shipped milk-mlt-calib2wfs1dm on the window.
#
# Parameters (environment):
#   TLW_WINDOWS       comma list of label:lowfs:ticks[:gain2]  (lowfs 0 = stage 3 open, 1 = closed)
#   TLW_SRM_ITER      selfRM averaging iterations per window
#   TLW_SETTLE_TICKS  master ticks (2 kHz) to wait after changing the loop state
# ==========================================================================================
TLW_WINDOWS="${TLW_WINDOWS:-lowfs_open:0:8000}"
TLW_SRM_ITER="${TLW_SRM_ITER:-16}"
TLW_SETTLE_TICKS="${TLW_SETTLE_TICKS:-4000}"
TLW_LOG_SRM="${TLW_LOG_SRM:-0}"          # 1 = log the modal streams during the selfRM pokes
TLW_SRM_AMPL="${TLW_SRM_AMPL:-0.020}"    # poke amplitude of the logged selfRM
TLW_SRM_FPCAM="${TLW_SRM_FPCAM:-OFF}"    # science cameras during the logged selfRM
# stream:divisor (frames = ticks / divisor)
TLW_STREAMS="aol1_modevalWFS:2 aol1_modevalDM:2 aol2_modevalWFS:1 aol2_modevalDM:1"
TLW_STREAMS+=" aol3_modevalWFS:4 aol3_modevalDM:4 aol3_dmC:4"

tlw_wait_ticks() {
    local n="$1" step
    while (( n > 0 )); do
        step=$(( n < 400 ? n : 400 ))
        milk-stream-wait -q -t 120 "csim_wfs_vis+${step}"
        n=$(( n - step ))
    done
}

tlw_p=0
tlw_a=0
tlw_b=0
tlw_counts() {
    @get tlw_p="s.outarraypha.cnt0" tlw_a="s.csim_wfs_nir.cnt0" tlw_b="s.csim_wfs_vis.cnt0"
}

tlw_start_loggers() {
    local tdir="$1" ticks="$2" ent sname div exp_n u csz mfc idx=0
    ln -sfn "${tdir}" "${TLM_LINK}"
    TLM_UNITS=()
    for ent in ${TLW_STREAMS}; do
        sname="${ent%%:*}"
        div="${ent#*:}"
        if ! @exists "s.${sname}"; then
            continue
        fi
        exp_n=$(( ticks / div ))
        printf -v u "tlog_%02d" "${idx}"
        idx=$(( idx + 1 ))
        csz=$(( exp_n + 64 ))
        (( csz > 2500 )) && csz=2500
        (( csz < 32 )) && csz=32
        mfc=$(( (exp_n + csz - 1) / csz + 8 ))
        milk-fps-rm -f -q --ignore-missing "${u}" >/dev/null 2>&1 || true
        milk-fps-init -q "${u}" milk-fpsexec-mem-streamFITSlog >/dev/null
        milk-fps-set -q \
            "${u}.sname=${sname}" \
            "${u}.dirname=${TLM_LINK}" \
            "${u}.cubesize=${csz}" \
            "${u}.maxframecnt=${exp_n}" \
            "${u}.maxfilecnt=${mfc}" \
            "${u}.zslice=-1" \
            "${u}.saveON=ON" \
            "${u}.procinfo.loopcntMax=-1" \
            "${u}.procinfo.triggermode=3" \
            "${u}.procinfo.triggersname=${sname}" \
            "${u}.procinfo.triggertimeout=0.5"
        TLM_UNITS+=("${u}")
    done
    milk-fps-runstart -q "${TLM_UNITS[@]}"
    sleep 0.3
    echo "[tlm]      armed ${#TLM_UNITS[@]} modal stream loggers -> ${tdir}"
}

for stg_pair in "1:${STG1_ROOT}" "2:${STG2_ROOT}" "3:${STG3_ROOT}"; do
    sn="${stg_pair%%:*}"
    sroot="${stg_pair#*:}"
    mkdir -p "${OUT_DIR}/calib_stg${sn}"
    for cf in CMmodesDM.fits CMmodesWFS.fits dmmask.fits wfsmask.fits mgainfact.fits rm_meta.env \
              mlat_hardwlatency.dat calib_timings.json; do
        if [[ -f "${sroot}/conf/${cf}" ]]; then
            cp -fL "${sroot}/conf/${cf}" "${OUT_DIR}/calib_stg${sn}/${cf}"
        fi
    done
done
cp -f "${ACTIVE_BENCH}" "${OUT_DIR}/ao3k_scexao.bench"

TLW_CSV="${OUT_DIR}/tlm_windows_counts.csv"
echo "window,lowfs,phase,d_pha,d_wfs1,d_wfs2,wall_s" > "${TLW_CSV}"

IFS=',' read -r -a TLW_LIST <<< "${TLW_WINDOWS}"
for tlw_ent in "${TLW_LIST[@]}"; do
    tlw_gain=""
    IFS=':' read -r tlw_label tlw_lowfs tlw_ticks tlw_gain <<< "${tlw_ent}"
    tlw_gain="${tlw_gain:-${GAIN2}}"
    tlw_dir="${OUT_DIR}/win_${tlw_label}"
    tlw_tdir="${tlw_dir}/telemetry"
    rm -rf "${tlw_tdir}"
    mkdir -p "${tlw_tdir}"
    sysmon.mark "win_${tlw_label}" "Telemetry window ${tlw_label} (lowfs=${tlw_lowfs})"
    echo "[tlm] ---- window ${tlw_label}: LLOWFS=${tlw_lowfs}, stage-2 gain ${tlw_gain}," \
         "${tlw_ticks} ticks ----"
    CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 close "${tlw_gain}"
    if (( tlw_lowfs )); then
        CACAO_LOOPROOTDIR="${STG3_ROOT}" "${LOOP_CTRL}" --stage 3 close "${GAIN3}"
    else
        CACAO_LOOPROOTDIR="${STG3_ROOT}" "${LOOP_CTRL}" --stage 3 zero
    fi
    tlw_wait_ticks "${TLW_SETTLE_TICKS}"

    # (2) modal telemetry
    tlw_start_loggers "${tlw_tdir}" "${tlw_ticks}"
    tlw_counts
    p0="${tlw_p}" a0="${tlw_a}" b0="${tlw_b}"
    t0="$(date +%s.%N)"
    if (( TLW_LOG_SRM )); then
        # diagnostic mode: keep logging while the self-response pokes run
        tlw_wait_ticks 1000
        @set "f.csim_htsim.enable_fpcam=${TLW_SRM_FPCAM}"
        CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 selfrm \
            "${tlw_dir}/selfRM_logged_stg2.fits" \
            --nbmode "${SELFRM_MODES}" --ampl "${TLW_SRM_AMPL}" --nbiter "${TLW_SRM_ITER}" \
            --nbsettle 6 --timeout 5400
        @set "f.csim_htsim.enable_fpcam=ON"
        tlw_wait_ticks 600
    else
        tlw_wait_ticks "$(( tlw_ticks + 200 ))"
    fi
    tlw_counts
    t1="$(date +%s.%N)"
    cleanup_tlm_loggers
    wall="$(awk -v a="${t0}" -v b="${t1}" 'BEGIN { printf "%.1f", b - a }')"
    echo "${tlw_label},${tlw_lowfs},telemetry,$(( tlw_p - p0 )),$(( tlw_a - a0 ))" \
         ",$(( tlw_b - b0 )),${wall}" | tr -d ' ' >> "${TLW_CSV}"
    echo "[tlm]      telemetry: d(pha)=$(( tlw_p - p0 )) d(wfs1)=$(( tlw_a - a0 ))" \
         "d(wfs2)=$(( tlw_b - b0 )) in ${wall} s"
    lon="" lg="" lm="" l3=""
    @get lon="f.mfilt-2.loopON" lg="f.mfilt-2.loopgain" lm="f.mfilt-2.loopmult" \
         l3="f.mfilt-3.loopON"
    echo "stage2: loopON=${lon} loopgain=${lg} loopmult=${lm} | stage3: loopON=${l3}" \
        > "${tlw_dir}/loop_state.txt"
    for n in 1 2 3; do
        for sfx in mgain mgainfact mmult; do
            if @exists "s.aol${n}_${sfx}"; then
                fpspipe.savefits "aol${n}_${sfx}" "${tlw_dir}/aol${n}_${sfx}.fits"
            fi
        done
    done

    if (( TLW_LOG_SRM )); then
        continue
    fi

    # (3) stage-2 self-response matrix: optical-gain reference for this window
    @set "f.csim_htsim.enable_fpcam=OFF"
    milk-stream-wait -q -t 60 "csim_wfs_vis+40"
    tlw_counts
    p0="${tlw_p}" a0="${tlw_a}" b0="${tlw_b}"
    t0="$(date +%s.%N)"
    CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 selfrm \
        "${tlw_dir}/selfRM_onsky_stg2.fits" \
        --nbmode "${SELFRM_MODES}" --ampl 0.020 --nbiter "${TLW_SRM_ITER}" --nbsettle 6 \
        --timeout 5400
    tlw_counts
    t1="$(date +%s.%N)"
    wall="$(awk -v a="${t0}" -v b="${t1}" 'BEGIN { printf "%.1f", b - a }')"
    echo "${tlw_label},${tlw_lowfs},selfrm,$(( tlw_p - p0 )),$(( tlw_a - a0 ))" \
         ",$(( tlw_b - b0 )),${wall}" | tr -d ' ' >> "${TLW_CSV}"
    echo "[tlm]      selfRM: d(pha)=$(( tlw_p - p0 )) d(wfs1)=$(( tlw_a - a0 ))" \
         "d(wfs2)=$(( tlw_b - b0 )) in ${wall} s"
    @set "f.csim_htsim.enable_fpcam=ON"

    # (4) shipped tool on this window (same arguments as the stock --calib-2wfs1dm step)
    if command -v milk-mlt-calib2wfs1dm >/dev/null 2>&1; then
        rm -rf "${tlw_dir}/calib_2wfs1dm"
        OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=1 \
            milk-mlt-calib2wfs1dm \
            "${tlw_tdir}" "${tlw_dir}/calib_2wfs1dm" \
            aol1_modevalWFS aol2_modevalWFS aol2_modevalDM \
            60 40 40 auto auto 4 0.02 0.70 \
            "${OUT_DIR}/selfRM_calib_stg2.fits" "${tlw_dir}/selfRM_onsky_stg2.fits" \
            > "${tlw_dir}/calib_2wfs1dm.log" 2>&1 || echo "[tlm]      shipped tool failed"
        if [[ -f "${tlw_dir}/calib_2wfs1dm/sysid_summary.txt" ]]; then
            echo "[tlm]      shipped tool: ${tlw_dir}/calib_2wfs1dm/sysid_summary.txt"
        fi
    fi
done

milk-fps-runstop -q csim_atmturb
sysmon.stop
sysmon.report "${OUT_DIR}" "${OUT_DIR}/ao3k_scexao_metrics.json" "" \
    "${OUT_DIR}/calib_stg1/calib_timings.json" "${OUT_DIR}/calib_stg2/calib_timings.json" "" \
    || true
echo "[tlm] Done: ${OUT_DIR}"
