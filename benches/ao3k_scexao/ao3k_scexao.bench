#
# Subaru Telescope (7.95 m Nasmyth-IR Pupil) AO3k + SCExAO + Lyot Coronagraph + LLOWFS Bench
#
# Entrance Pupil  : Subaru Nasmyth-IR (D=7.95 m, cobs=0.307, 4 offset-V spiders @ +/-51.75 deg,
#                   offset=0.08289 D, width=0.02314 D), end-to-end telescope throughput = 20%
# Atmosphere      : Maunakea (4205 m, 615 hPa, 2 C, 20% RH) at default zenith_deg = 30.0 deg,
#                   refractive dispersion + 3-wl [0.75, 1.22, 1.65] um chromatic turbulence shear
# Fore-Optics ADC : Subaru AO188 counter-rotating prism ADC (Egner 2009 Table 11, whole-band LUT)
# Stage 1 (AO3k)  : 64x64 DM (D=60 act, dm01disp) + J-band (1.22 um, 20% BW, 5ch) 160x160 PyWFS 1kHz
# Stage 2 (SCExAO): 50x50 DM (D=46 act, dm02disp) + Vis PyWFS TTM (dm_vis_pyrwfs_tt) +
#                   Vis (0.75 um, 20% BW, 5ch) 120x120 PyWFS @ 2 kHz
# Stage 3 (LLOWFS): H-band (1.65 um, 18% BW, 5ch) 3.0 l/D Lyot coronagraph with reflective Lyot stop
#                   feeding a defocused (200 nm Z4) 64x64 focal-plane LLOWFS @ 500 Hz (ZPO -> Stg2)
# Science PSFs    : Simultaneous Visible (0.75 um, 15% BW, 7-9ch), Near-IR H (1.65 um, 18% BW, 5ch)
#                   unocculted cameras (Pre-AO/ADC, Post-Stg1, Final Stg2) + Post-Lyot Coro Cam.

[bench]
name                 = "subaru_ao3k_scexao"
nwf                  = 256
pup_diam             = 0.9375
cobs                 = 0.307
nspider              = 4
spider_w             = 0.02314
spider_deg           = 51.75
spider_offset        = 0.08289
tel_diam_m           = 7.95
star_mag             = 6.0
star_teff            = 9600.0
tput_tel             = 0.20
master_hz            = 2000.0
oversample           = 4
in_wf                = "outarraypha"
in_pup               = "csim_pup"
out_beam             = "b_pup"
wf_unit              = 1
ref_lambda           = 0.50
turb_gain            = 0.0
atm_disp_enable      = 1
zenith_deg           = 30.0
disp_pa_deg          = 0.0
imr_mode             = "pupil_track"
parallactic_rate_dps = 0.0
site_alt_m           = 4205.0
atm_pressure_hpa     = 615.0
atm_temp_c           = 2.0
atm_rh_pct           = 20.0
atm_disp_ref_um      = 1.65
chrom_turb           = 1
chrom_lambdas        = "0.75,1.22,1.65"

# --- Stage 0: Uncorrected Pre-ADC Entrance Pupil PSFs (Visible & Near-IR) ---
[fpcam.vis_raw]
in            = "b_pup"
out_cam       = "psf_vis_raw"
out_long      = "psf_vis_raw_long"
ncam          = 256
prop_mode     = "mft"
lambda_um     = 0.75
bw_frac       = 0.15
nlambda       = 9
qe            = 0.85
pixscale_ld   = 2.20
use_beam_flux = 1
rate_hz       = 100.0
ron_e         = 0.3
sat_adu       = 1.0e9
out_dtype     = "float32"

[fpcam.nir_raw]
in            = "b_pup"
out_cam       = "psf_nir_raw"
out_long      = "psf_nir_raw_long"
ncam          = 256
prop_mode     = "mft"
lambda_um     = 1.65
bw_frac       = 0.18
nlambda       = 5
qe            = 0.85
pixscale_ld   = 2.50
use_beam_flux = 1
rate_hz       = 100.0
ron_e         = 0.5
sat_adu       = 1.0e9
out_dtype     = "float32"

# --- Fore-Optics: Subaru AO188 Atmospheric Dispersion Compensator (Egner 2009 Table 11) ---
[adc.ao188]
in            = "b_pup"
out           = "b_adc"
preset        = "ao188"
mode          = "lut"
opt_band      = "whole"
ideal_mech    = 1
tput_enable   = 1
tput_base     = 0.96
in_cmd        = "ao188_adc_cmd"
out_state     = "ao188_adc_state"

# --- Stage 1 (AO3k): 64x64 ALPAO Magnetic DM (Plate PDE, D=60 act) + 160x160 J-Band PyWFS ---
[dm.ao3k]
in           = "b_adc"
out          = "b_post_stg1"
in_cmd       = "dm01disp"
out_opd      = "csim_dm01_opd"
nact_x       = 64
nact_y       = 64
dm_diam      = 0.984375
if_coupling  = 0.08
tput         = 0.98
max_stroke   = 8.0
dac_bits     = 16
dyn_mode     = "plate"
tau_us       = 20.0
f0_hz        = 1000.0
act_pitch_mm = 1.5
wave_c       = 14.0
bend_beta    = 0.0085
damp_g0      = 195.0
damp_g2      = 1.5
plate_drive  = "force"
rim_bc       = "free"
delay_us     = 1000.0

[fpcam.vis_stg1]
in            = "b_post_stg1"
out_cam       = "psf_vis_stg1"
out_long      = "psf_vis_stg1_long"
ncam          = 256
prop_mode     = "mft"
lambda_um     = 0.75
bw_frac       = 0.15
nlambda       = 7
qe            = 0.85
pixscale_ld   = 2.20
use_beam_flux = 1
rate_hz       = 100.0
ron_e         = 0.3
sat_adu       = 1.0e9
out_dtype     = "float32"

[fpcam.nir_stg1]
in            = "b_post_stg1"
out_cam       = "psf_nir_stg1"
out_long      = "psf_nir_stg1_long"
ncam          = 256
prop_mode     = "mft"
lambda_um     = 1.65
bw_frac       = 0.18
nlambda       = 5
qe            = 0.85
pixscale_ld   = 2.50
use_beam_flux = 1
rate_hz       = 100.0
ron_e         = 0.5
sat_adu       = 1.0e9
out_dtype     = "float32"

[splitter.dichroic_stg1]
in         = "b_post_stg1"
out_refl   = "b_nir_wfs"
out_trans  = "b_stg2_in"
mode       = "dichroic_bp"
lambda_cut = 1.22
band_width = 0.30
roll_um    = 0.03
eff_refl   = 0.95
eff_trans  = 0.95

[pyrwfs.wfs_nir]
in            = "b_nir_wfs"
out_cam       = "csim_wfs_nir"
ncam          = 160
lambda_um     = 1.22
bw_frac       = 0.20
nlambda       = 5
chrom_sep     = -0.031
qe            = 0.80
use_beam_flux = 1
rate_hz       = 1000.0
mod_rad       = 3.0
mod_npts      = 16
ron_e         = 0.8
out_dtype     = "float32"

# --- Stage 2 (SCExAO): 50x50 DM (D=46 act) + 120x120 Vis PyWFS (2 kHz) + Final PSFs ---
[dm.scexao]
in           = "b_stg2_in"
out          = "b_post_stg2"
in_cmd       = "dm02disp"
out_opd      = "csim_dm02_opd"
nact_x       = 50
nact_y       = 50
dm_diam      = 0.9986413
if_coupling  = 0.15
tput         = 0.98
max_stroke   = 3.0
dac_bits     = 16
dyn_mode     = 1
tau_us       = 60.0
delay_us     = 500.0

[splitter.dichroic_stg2]
in         = "b_post_stg2"
out_refl   = "b_vis_arm"
out_trans  = "b_nir_sci"
mode       = "dichroic_lp"
lambda_cut = 1.00
roll_um    = 0.03
eff_refl   = 0.95
eff_trans  = 0.95

[splitter.vis_pickoff]
in        = "b_vis_arm"
out_refl  = "b_vis_wfs"
out_trans = "b_vis_sci"
mode      = "gray"
r_gray    = 0.90
t_gray    = 0.10

# SCExAO Visible Pyramid WFS 2-axis Tip-Tilt Mount (corrects differential Vis-NIR TT)
[ttm.vis_pyrwfs]
in         = "b_vis_wfs"
out        = "b_vis_wfs_tt"
in_cmd     = "dm_vis_pyrwfs_tt"
dm_diam    = 0.9375
tput       = 0.99
max_stroke = 5.0
dac_bits   = 16
dyn_mode   = "rc"
tau_us     = 500.0
delay_us   = 500.0

[pyrwfs.wfs_vis]
in            = "b_vis_wfs_tt"
out_cam       = "csim_wfs_vis"
ncam          = 120
lambda_um     = 0.75
bw_frac       = 0.20
nlambda       = 5
qe            = 0.85
use_beam_flux = 1
rate_hz       = 2000.0
mod_rad       = 3.0
mod_npts      = 16
ron_e         = 0.2
out_dtype     = "float32"

[fpcam.vis_final]
in            = "b_vis_sci"
out_cam       = "psf_vis_final"
out_long      = "psf_vis_final_long"
ncam          = 256
prop_mode     = "mft"
lambda_um     = 0.75
bw_frac       = 0.15
nlambda       = 7
qe            = 0.85
pixscale_ld   = 2.20
use_beam_flux = 1
rate_hz       = 100.0
ron_e         = 0.3
sat_adu       = 1.0e9
out_dtype     = "float32"

[fpcam.nir_final]
in            = "b_nir_sci"
out_cam       = "psf_nir_final"
out_long      = "psf_nir_final_long"
ncam          = 256
prop_mode     = "mft"
lambda_um     = 1.65
bw_frac       = 0.18
nlambda       = 5
qe            = 0.85
pixscale_ld   = 2.50
use_beam_flux = 1
rate_hz       = 100.0
ron_e         = 0.5
sat_adu       = 1.0e9
out_dtype     = "float32"

# --- Stage 3: H-Band Lyot Coronagraph + Reflective-Lyot Defocused Focal-Plane LLOWFS (500 Hz) ---
[coro.coro_nir]
in                 = "b_nir_sci"
out                = "b_nir_coro"
out_lowfs          = "b_lowfs"
out_pre_lyot       = "coro_pre_lyot"
out_pre_lyot_long  = "coro_pre_lyot_long"
mode               = "lyot_spot"
lambda_um          = 1.65
bw_frac            = 0.18
nlambda            = 5
fpm_rad_ld         = 3.0
fpm_amp            = 0.0
lowfs_mode         = "lyot_refl"
lowfs_refl         = 0.95
tput               = 0.92
lyot_outer         = 0.85
lyot_obs           = 0.38
lyot_nspider       = 4
lyot_spider_w      = 0.040
lyot_spider_deg    = 51.75
lyot_spider_offset = 0.08289

[fpcam.nir_coro]
in            = "b_nir_coro"
out_cam       = "psf_nir_coro"
out_long      = "psf_nir_coro_long"
ncam          = 256
prop_mode     = "mft"
lambda_um     = 1.65
bw_frac       = 0.18
nlambda       = 5
qe            = 0.85
pixscale_ld   = 2.50
use_beam_flux = 1
rate_hz       = 100.0
ron_e         = 0.5
sat_adu       = 1.0e9
out_dtype     = "float32"

[wfe.lowfs_defoc]
in         = "b_lowfs"
out        = "b_lowfs_defoc"
in_wfe     = "csim_lowfs_defoc"
rms_nm     = 0.0
defocus_nm = 200.0
wfe_gain   = 1.0
tput       = 0.98

[fpcam.wfs_lowfs]
in            = "b_lowfs_defoc"
out_cam       = "csim_wfs_lowfs"
is_wfs        = 1
ncam          = 64
prop_mode     = "mft"
lambda_um     = 1.65
bw_frac       = 0.18
nlambda       = 5
qe            = 0.85
pixscale_ld   = 2.00
use_beam_flux = 1
rate_hz       = 500.0
ron_e         = 0.5
sat_adu       = 1.0e9
out_dtype     = "float32"
