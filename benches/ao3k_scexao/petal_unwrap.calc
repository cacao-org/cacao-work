#
# Stage-1 Passive Petal-Unwrap Compute Unit (milk-fpsexec-milk-calc, triggered on aol1_imWFS2)
#
# Streams read:
#   aol1_imWFS2   (160x160 f32) : Stage-1 normalized ref-subtracted WFS frame (trigger)
#   aol1_petalM   (7x25600 f32) : [ev_sn, ev_ew, ev_adj, sg_e, sg_n, sg_w, sg_s] matched filter
#   aol1_petalDM  (64x64x4 f32) : zero-mean Voronoi DM1 petal modes [E, N, W, S] (+1 lambda_J OPD)
#
# Streams written:
#   aol1_petal_raw (7 f32)      : instantaneous matched-filter projection per frame
#   aol1_petal_ema (7 f32)      : unbiased startup/post-reset causal EMA
#   aol1_petal_cmd (8 f32)      : [w_e, w_n, w_w, w_s, n_jumps, n_aborts, n_rollbacks, trial_p]
#   dm01disp06     (64x64 f32)  : free DM1 offset channel (atomic integer-wave jumps only!)
#
# Complete rank-3 petal topology coverage (modulo global piston):
#   - Single petals (E, N, W, S)  : ev_sn / ev_ew + chromatic sign sg_p
#   - Adjacent pairs (S+E / S+W)  : ev_adj (> th_adj) + 4-petal chromatic sign
#   - Opposite pair / Waffle (N+S vs E+W): fused-silica 4-petal checkerboard sign sg_waf
#
# Universal 2-stage post-jump verifier (active in BOTH signed & achromatic modes):
#   - Single petals (trial_p in 0..3):
#       1) eff_n >= abort_win (~0.25s): ev_after > th_abort AND ev_after > trial_ev0 + 1.40
#          AND (use_sign == 0 OR -trial_dir * sg_after > 1.30) -> snap -2*trial_dir (wrong-way +-2w)
#       2) eff_n >= verify_win (~0.50s): ev_after > trial_ev0 + 0.05 -> rollback -trial_dir
#   - Waffle pair (trial_p == 4, trial_dir = +1 for N+S or -1 for E+W):
#       eff_n >= verify_win: trial_dir * sg_waf < -0.55 -> rollback waffle jump + cooldown

# 1. Matched-filter projection (7 x 25600 BLAS GEMV -> ~3 us per frame)
aol1_petal_raw = aol1_petalM @ vec(aol1_imWFS2)

# 2. Unbiased causal slow EMA + optional fast EMA with post-jump latency blanking (settle_fr)
age_fr = age_fr + 1
if age_fr <= settle_fr {
    aol1_petal_ema = aol1_petal_ema * 0.0
    fev_sn = 0.0
    fev_ew = 0.0
    fsg_e = 0.0
    fsg_n = 0.0
    fsg_w = 0.0
    fsg_s = 0.0
    fast_cand = -1
    fast_streak = 0
} else {
    local eff_age = age_fr - settle_fr
    local a_eff = alpha
    if eff_age * alpha < 1.0 {
        a_eff = 1.0 / eff_age
    }
    aol1_petal_ema = (1.0 - a_eff) * aol1_petal_ema + a_eff * aol1_petal_raw
    if alpha_fast > 0.0 {
        local af_eff = alpha_fast
        if eff_age * alpha_fast < 1.0 {
            af_eff = 1.0 / eff_age
        }
        local om_af = 1.0 - af_eff
        fev_sn = om_af * fev_sn + af_eff * aol1_petal_raw[0]
        fev_ew = om_af * fev_ew + af_eff * aol1_petal_raw[1]
        fsg_e  = om_af * fsg_e  + af_eff * aol1_petal_raw[3]
        fsg_n  = om_af * fsg_n  + af_eff * aol1_petal_raw[4]
        fsg_w  = om_af * fsg_w  + af_eff * aol1_petal_raw[5]
        fsg_s  = om_af * fsg_s  + af_eff * aol1_petal_raw[6]
    }
}

# 3. Extract scalar telemetry readbacks into FPS params
ev_sn  = aol1_petal_ema[0]
ev_ew  = aol1_petal_ema[1]
ev_adj = aol1_petal_ema[2]
sg_e   = aol1_petal_ema[3]
sg_n   = aol1_petal_ema[4]
sg_w   = aol1_petal_ema[5]
sg_s   = aol1_petal_ema[6]
local sg_waf = 0.421 * ((sg_n + sg_s) - (sg_e + sg_w))

# 4. State machine (only applies jumps when enable != 0)
if enable != 0 {
    local eff_n = age_fr - settle_fr
    local jpet = -1
    local jdir = 0
    local next_verify_p = -1
    local next_verify_dir = 0
    local next_verify_ev0 = 0.0
    local post_cooldown = 0
    local is_abort = 0
    local is_rollback = 0

    # Priority 1: Universal 2-stage post-jump verification
    if trial_p >= 0 {
        if trial_p == 4 {
            # Verify checkerboard waffle jump (N+S or E+W)
            if eff_n >= verify_win {
                local waf_chk = trial_dir * sg_waf
                if waf_chk < -0.55 {
                    # Waffle sign flipped to opposite -> false alarm on phased loop -> roll back!
                    jpet = 4
                    jdir = -trial_dir
                    is_rollback = 1
                    trial_p = -1
                    trial_dir = 0
                    trial_ev0 = 0.0
                    post_cooldown = 1
                } else {
                    trial_p = -1
                    trial_dir = 0
                    trial_ev0 = 0.0
                }
            }
        } elif eff_n >= abort_win {
            local ev_chk = 0.0
            local sg_chk = 0.0
            if trial_p == 3 {
                ev_chk = ev_sn
                sg_chk = sg_s
            } elif trial_p == 1 {
                ev_chk = -ev_sn
                sg_chk = sg_n
            } elif trial_p == 0 {
                ev_chk = ev_ew
                sg_chk = sg_e
            } elif trial_p == 2 {
                ev_chk = -ev_ew
                sg_chk = sg_w
            }
            local do_abort = 0
            local opp_sg = 0.0 - trial_dir * sg_chk
            if ev_chk > th_abort {
                if ev_chk > trial_ev0 + 1.40 {
                    if use_sign == 0 {
                        do_abort = 1
                    } elif opp_sg > 1.30 {
                        do_abort = 1
                    }
                }
            }
            local early_ok = 0
            if ev_chk < 0.35 {
                if use_sign == 0 {
                    early_ok = 1
                } elif opp_sg < 0.45 {
                    early_ok = 1
                }
            }
            if do_abort != 0 {
                # Wrong-way jump pushed petal to +-2 lambda_J (Even jumped sharply above trial_ev0) -> snap -2*trial_dir!
                jpet = trial_p
                jdir = -2 * trial_dir
                is_abort = 1
                trial_p = -1
                trial_dir = 0
                trial_ev0 = 0.0
            } elif early_ok != 0 {
                # Fast unwrap confirmation: Even collapsed cleanly below 0.35w without opposite-sign wrap
                trial_p = -1
                trial_dir = 0
                trial_ev0 = 0.0
            } elif eff_n >= verify_win {
                local do_rb = 0
                if ev_chk > trial_ev0 + 0.05 {
                    if use_sign == 0 {
                        do_rb = 1
                    } elif opp_sg > 0.50 {
                        do_rb = 1
                    }
                }
                if do_rb != 0 {
                    # False-alarm jump on phased petal made Even worse (with opposite-sign wrap) -> roll back!
                    jpet = trial_p
                    jdir = -trial_dir
                    is_rollback = 1
                    trial_p = -1
                    trial_dir = 0
                    trial_ev0 = 0.0
                    post_cooldown = 1
                } else {
                    # Verified unwrap success! Clear verifier lock.
                    trial_p = -1
                    trial_dir = 0
                    trial_ev0 = 0.0
                }
            }
        }
    }

    # Priority 2a: Optional fast single-petal branch (dual-timescale EMA + 3-other-petal contrast guard + dwell)
    if jpet < 0 {
        if trial_p < 0 {
            if use_sign != 0 {
                if alpha_fast > 0.0 {
                    if eff_n >= fast_warmup {
                        local fa_sn = abs(fev_sn)
                        local fa_ew = abs(fev_ew)
                        local fc_p = -1
                        local fc_ev = 0.0
                        local fc_sg = 0.0
                        local fo1 = 0.0
                        local fo2 = 0.0
                        local fo3 = 0.0
                        if fa_sn >= fa_ew {
                            if fa_sn > fast_th_even {
                                fc_ev = fa_sn
                                if fev_sn > 0.0 {
                                    fc_p = 3
                                    fc_sg = fsg_s
                                    fo1 = fsg_e
                                    fo2 = fsg_n
                                    fo3 = fsg_w
                                } else {
                                    fc_p = 1
                                    fc_sg = fsg_n
                                    fo1 = fsg_e
                                    fo2 = fsg_w
                                    fo3 = fsg_s
                                }
                            }
                        } else {
                            if fa_ew > fast_th_even {
                                fc_ev = fa_ew
                                if fev_ew > 0.0 {
                                    fc_p = 0
                                    fc_sg = fsg_e
                                    fo1 = fsg_n
                                    fo2 = fsg_w
                                    fo3 = fsg_s
                                } else {
                                    fc_p = 2
                                    fc_sg = fsg_w
                                    fo1 = fsg_e
                                    fo2 = fsg_n
                                    fo3 = fsg_s
                                }
                            }
                        }
                        local fast_ok = 0
                        local fc_dir = 0
                        if fc_p >= 0 {
                            if fc_sg >= 0.0 {
                                fc_dir = 1
                            } else {
                                fc_dir = -1
                            }
                            local fc_abs_sg = fc_dir * fc_sg
                            local fc_con = fc_dir * (fc_sg - (fo1 + fo2 + fo3) * 0.33333333)
                            if fc_abs_sg > fast_th_sign {
                                if fc_dir * fo1 < 0.0 {
                                    if fc_dir * fo2 < 0.0 {
                                        if fc_dir * fo3 < 0.0 {
                                            if fc_con > fast_th_con {
                                                fast_ok = 1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if fast_ok != 0 {
                            local fc_key = fc_p * 2
                            if fc_dir > 0 {
                                fc_key = fc_key + 1
                            }
                            if fc_key == fast_cand {
                                fast_streak = fast_streak + 1
                            } else {
                                fast_cand = fc_key
                                fast_streak = 1
                            }
                            if fast_streak >= fast_dwell {
                                jpet = fc_p
                                jdir = fc_dir
                                next_verify_p = fc_p
                                next_verify_dir = fc_dir
                                next_verify_ev0 = fc_ev
                                fast_streak = 0
                                fast_cand = -1
                            }
                        } else {
                            fast_streak = 0
                            fast_cand = -1
                        }
                    }
                }
            }
        } else {
            fast_streak = 0
            fast_cand = -1
        }
    }

    # Priority 2b: Normal slow-EMA passive unwrap trigger after warmup window
    if jpet < 0 {
        if trial_p < 0 {
            if eff_n >= min_warmup {
                local a_sn  = abs(ev_sn)
                local a_ew  = abs(ev_ew)
                local a_adj = abs(ev_adj)

                local cand_p = -1
                local cand_ev = 0.0
                local cand_sg = 0.0
                local is_adj = 0

                # Check dominant single-petal axis (S-N or E-W) first; adjacent pair requires th_adj
                if a_sn >= a_ew {
                    if a_sn > th_even {
                        cand_ev = a_sn
                        if ev_sn > 0.0 {
                            cand_p = 3
                            cand_sg = sg_s
                        } else {
                            cand_p = 1
                            cand_sg = sg_n
                        }
                    }
                } else {
                    if a_ew > th_even {
                        cand_ev = a_ew
                        if ev_ew > 0.0 {
                            cand_p = 0
                            cand_sg = sg_e
                        } else {
                            cand_p = 2
                            cand_sg = sg_w
                        }
                    }
                }

                # Adjacent-pair fallback (only if neither single-petal axis triggered)
                if cand_p < 0 {
                    if a_adj > th_adj {
                        is_adj = 1
                        cand_p = 3
                        cand_ev = a_adj
                        if ev_adj > 0.0 {
                            cand_sg = 0.36 * ((sg_s + sg_e) - (sg_n + sg_w))
                        } else {
                            cand_sg = 0.36 * ((sg_s + sg_w) - (sg_n + sg_e))
                        }
                    }
                }

                if cand_p >= 0 {
                    if use_sign != 0 {
                        local req_sg = th_sign
                        if is_adj != 0 {
                            req_sg = 0.55
                        }
                        if cand_sg > req_sg {
                            jpet = cand_p
                            jdir = 1
                        } elif cand_sg < -req_sg {
                            jpet = cand_p
                            jdir = -1
                        } elif is_adj == 0 {
                            if cand_ev > 2.20 {
                                # Unmistakable wrap even if severe DM windup dilutes sign -> verify!
                                jpet = cand_p
                                if cand_sg >= 0.0 {
                                    jdir = 1
                                } else {
                                    jdir = -1
                                }
                            }
                        }
                    } else {
                        # Achromatic fallback: trial +1 wave jump
                        jpet = cand_p
                        jdir = 1
                    }
                    if jpet >= 0 {
                        if is_adj == 0 {
                            next_verify_p = jpet
                            next_verify_dir = jdir
                            next_verify_ev0 = cand_ev
                        }
                    }
                } elif use_sign != 0 {
                    # Priority 2b: Opposite-pair Waffle (N+S vs E+W) detected via fused-silica sign!
                    # A true checkerboard waffle has ev_sn ~ 0 and ev_ew ~ 0 (opposite pairs cancel),
                    # AND strong balanced all-4-petal sign agreement (> 0.55 on all 4 islands).
                    # Guarding on a_sn < 0.35 and a_ew < 0.35 prevents waffle from hijacking a rising single-petal wrap!
                    if a_sn < 0.35 {
                        if a_ew < 0.35 {
                            if sg_waf > th_waf {
                                if sg_n > 0.55 {
                                    if sg_s > 0.55 {
                                        if sg_e < -0.55 {
                                            if sg_w < -0.55 {
                                                jpet = 4
                                                jdir = 1
                                                next_verify_p = 4
                                                next_verify_dir = 1
                                                next_verify_ev0 = sg_waf
                                            }
                                        }
                                    }
                                }
                            } elif sg_waf < -th_waf {
                                if sg_e > 0.55 {
                                    if sg_w > 0.55 {
                                        if sg_n < -0.55 {
                                            if sg_s < -0.55 {
                                                jpet = 4
                                                jdir = -1
                                                next_verify_p = 4
                                                next_verify_dir = -1
                                                next_verify_ev0 = -sg_waf
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    # 5. Stroke safety clamp & atomic DM1 offset jump on free channel dm01disp06
    if jpet >= 0 {
        local ok_stroke = 0
        if post_cooldown != 0 {
            ok_stroke = 1
        } elif jpet == 0 {
            if abs(w_e + jdir) <= max_waves { ok_stroke = 1 }
        } elif jpet == 1 {
            if abs(w_n + jdir) <= max_waves { ok_stroke = 1 }
        } elif jpet == 2 {
            if abs(w_w + jdir) <= max_waves { ok_stroke = 1 }
        } elif jpet == 3 {
            if abs(w_s + jdir) <= max_waves { ok_stroke = 1 }
        } elif jpet == 4 {
            if jdir > 0 {
                if abs(w_n + 1) <= max_waves {
                    if abs(w_s + 1) <= max_waves { ok_stroke = 1 }
                }
            } else {
                if abs(w_e + 1) <= max_waves {
                    if abs(w_w + 1) <= max_waves { ok_stroke = 1 }
                }
            }
        }

        if ok_stroke != 0 {
            local amp = jdir * step_scale
            if jpet == 0 {
                dm01disp06 = dm01disp06 + amp * aol1_petalDM[:, :, 0]
                w_e = w_e + jdir
            } elif jpet == 1 {
                dm01disp06 = dm01disp06 + amp * aol1_petalDM[:, :, 1]
                w_n = w_n + jdir
            } elif jpet == 2 {
                dm01disp06 = dm01disp06 + amp * aol1_petalDM[:, :, 2]
                w_w = w_w + jdir
            } elif jpet == 3 {
                dm01disp06 = dm01disp06 + amp * aol1_petalDM[:, :, 3]
                w_s = w_s + jdir
            } elif jpet == 4 {
                # Checkerboard Waffle: jdir > 0 unwraps N+S (+1 on N & S), jdir < 0 unwraps E+W (+1 on E & W)
                # (Or rollback: if post_cooldown != 0, jdir = -trial_dir subtracts 1 from that same pair!)
                if post_cooldown != 0 {
                    if jdir < 0 {
                        dm01disp06 = dm01disp06 - step_scale * (aol1_petalDM[:, :, 1] + aol1_petalDM[:, :, 3])
                        w_n = w_n - 1
                        w_s = w_s - 1
                    } else {
                        dm01disp06 = dm01disp06 - step_scale * (aol1_petalDM[:, :, 0] + aol1_petalDM[:, :, 2])
                        w_e = w_e - 1
                        w_w = w_w - 1
                    }
                } else {
                    if jdir > 0 {
                        dm01disp06 = dm01disp06 + step_scale * (aol1_petalDM[:, :, 1] + aol1_petalDM[:, :, 3])
                        w_n = w_n + 1
                        w_s = w_s + 1
                    } else {
                        dm01disp06 = dm01disp06 + step_scale * (aol1_petalDM[:, :, 0] + aol1_petalDM[:, :, 2])
                        w_e = w_e + 1
                        w_w = w_w + 1
                    }
                }
            }
            n_jumps = n_jumps + 1
            if is_abort != 0 { n_aborts = n_aborts + 1 }
            if is_rollback != 0 { n_rollbacks = n_rollbacks + 1 }
            last_petal = jpet
            last_dir = jdir
            trial_p = next_verify_p
            trial_dir = next_verify_dir
            trial_ev0 = next_verify_ev0
            if post_cooldown != 0 {
                age_fr = -400
            } else {
                age_fr = 0
            }
            aol1_petal_ema = aol1_petal_ema * 0.0
            fev_sn = 0.0
            fev_ew = 0.0
            fsg_e = 0.0
            fsg_n = 0.0
            fsg_w = 0.0
            fsg_s = 0.0
            fast_cand = -1
            fast_streak = 0
        } else {
            trial_p = -1
            trial_dir = 0
            trial_ev0 = 0.0
        }
    }
}

# 6. Publish atomic 1 kHz applied-correction & state vector [w_e, w_n, w_w, w_s, n_jumps, n_aborts, n_rollbacks, trial_p]
aol1_petal_cmd = w_e * aol1_petal_eye[:, 0] + w_n * aol1_petal_eye[:, 1] + w_w * aol1_petal_eye[:, 2] + w_s * aol1_petal_eye[:, 3] + n_jumps * aol1_petal_eye[:, 4] + n_aborts * aol1_petal_eye[:, 5] + n_rollbacks * aol1_petal_eye[:, 6] + trial_p * aol1_petal_eye[:, 7]
