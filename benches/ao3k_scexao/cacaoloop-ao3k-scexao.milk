#!/usr/bin/env -S milk-script -q
# SPDX-FileCopyrightText: 2026 Olivier Guyon et al
#
# SPDX-License-Identifier: LGPL-3.0-or-later
#
# cacaoloop-ao3k-scexao.milk - Stage-parameterized CACAO AO loop controller for:
#   - Stage 1 (ao3k)  : aol1, dm01 64x64 (D=60 act), 160x160 J-band PyWFS @ 1 kHz
#   - Stage 2 (scexao): aol2, dm02 50x50 (D=46 act), 120x120 Vis PyWFS @ 2 kHz + ZPO MVM
#   - Stage 3 (llowfs): aol3, dm02 50x50 ZPO ch04/05, 64x64 H-band Lyot-Refl LLOWFS @ 500 Hz

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
CALLER_PWD="${PWD}"

STAGE="1"
if [[ "${1:-}" == "--stage" ]]; then
    STAGE="${2:-1}"
    shift 2
fi

OWNS_DM=1
USE_ZPO_MVM=0
MODAL_DIRECT=0
DEF_NMODES_DIRECT=14
DEF_WFSMASK_RAD="20.0"
DEF_MLAT_CPA="4.0"
DEF_MGAIN_ALPHA="0.8"
DEF_MGAIN_FLOOR="0.10"

if [[ "${STAGE}" == "1" || "${STAGE}" == "ao3k" ]]; then
    DEF_NAME="ao3k"
    DEF_NUM=1
    DEF_DM="01"
    DEF_DMX=64
    DEF_DMY=64
    DEF_PUP_DIAM="60.0"
    DEF_WFS="csim_wfs_nir"
    DEF_WFSX=160
    DEF_WFSY=160
    DEF_GAIN="0.35"
    DEF_MULT="0.98"
    DEF_SVDLIM="0.004"
    DEF_CPAMAX="28"
    DEF_RCPAMAX="28.5"
    DEF_DELTACPA="1.0"
    DEF_AMPL="0.015"
    DEF_PF_MIX="0.90"
elif [[ "${STAGE}" == "2" || "${STAGE}" == "scexao" ]]; then
    DEF_NAME="scexao"
    DEF_NUM=2
    DEF_DM="02"
    DEF_DMX=50
    DEF_DMY=50
    DEF_PUP_DIAM="46.0"
    DEF_WFS="csim_wfs_vis"
    DEF_WFSX=120
    DEF_WFSY=120
    DEF_GAIN="0.35"
    DEF_MULT="0.98"
    DEF_SVDLIM="0.004"
    DEF_CPAMAX="22"
    DEF_RCPAMAX="22.5"
    DEF_DELTACPA="1.0"
    DEF_AMPL="0.010"
    DEF_PF_MIX="0.90"
    USE_ZPO_MVM=1
elif [[ "${STAGE}" == "3" || "${STAGE}" == "llowfs" || "${STAGE}" == "lowfs" ]]; then
    DEF_NAME="llowfs"
    DEF_NUM=3
    DEF_DM="02"
    DEF_DMX=50
    DEF_DMY=50
    DEF_PUP_DIAM="46.0"
    DEF_WFS="csim_wfs_lowfs"
    DEF_WFSX=64
    DEF_WFSY=64
    DEF_GAIN="0.20"
    DEF_MULT="0.99"
    DEF_SVDLIM="0.02"
    DEF_CPAMAX="4"
    DEF_RCPAMAX="4.5"
    DEF_DELTACPA="1.0"
    DEF_AMPL="0.015"
    DEF_PF_MIX="0.50"
    OWNS_DM=0
    MODAL_DIRECT=1
    DEF_MLAT_CPA="1.0"
    DEF_MGAIN_ALPHA="0.4"
    DEF_MGAIN_FLOOR="0.40"
else
    echo "${SCRIPT_NAME}: invalid --stage '${STAGE}' (expected 1, 2, or 3)" >&2
    exit 2
fi

LOOPNAME="${CACAO_LOOPNAME:-${DEF_NAME}}"
N="${CACAO_LOOPNUMBER:-${DEF_NUM}}"
PFX="aol${N}_"
DM="${CACAO_DMINDEX:-${DEF_DM}}"
DMX="${CACAO_DMX:-${DEF_DMX}}"
DMY="${CACAO_DMY:-${DEF_DMY}}"
PUP_DIAM_ACT="${CACAO_PUP_DIAM_ACT:-${DEF_PUP_DIAM}}"
WFS_STREAM="${CACAO_WFSSTREAM:-${DEF_WFS}}"
WFSX="${CACAO_WFSX:-${DEF_WFSX}}"
WFSY="${CACAO_WFSY:-${DEF_WFSY}}"
ROOTDIR="${CACAO_LOOPROOTDIR:-${PWD}/${LOOPNAME}-rootdir}"
GPUINDEX="${CACAO_GPUINDEX:-0}"
RATE="${CACAO_WFSFRATE:-100}"
LAT_FR="${CACAO_LATENCYHARDWFR:-1.5}"
SOFT_LAT_FR="${CACAO_LATENCYSOFTWFR:-1.65}"
PSOL_WFSFACT="${CACAO_PSOL_WFSFACT:-1.0}"
TBUFF_SIZE="${CACAO_TBUFF_SIZE:-256}"
PF_MODE="${CACAO_PF_MODE:-ar}"
PF_ORDER="${CACAO_PF_ORDER:-8}"
PF_DIAGORDER="${CACAO_PF_DIAGORDER:-16}"
PF_BLOCKSIZE="${CACAO_PF_BLOCKSIZE:-128}"
PF_NBTRAIN="${CACAO_PF_NBTRAIN:-2048}"
PF_MINSAMPLES="${CACAO_PF_MINSAMPLES:-256}"
PF_DIAGMINSAMPLES="${CACAO_PF_DIAGMINSAMPLES:-256}"
DEF_PF_UPD=4
(( N == 2 )) && DEF_PF_UPD=8
PF_UPDATEPERIOD="${CACAO_PF_UPDATEPERIOD:-${DEF_PF_UPD}}"
PF_REG="${CACAO_PF_REG:-0.005}"
PF_MAXNORM2="${CACAO_PF_MAXNORM2:-}"
PF_NTHREADS="${CACAO_PF_NTHREADS:-4}"
PF_MKTHREADS="${CACAO_PF_MKTHREADS:-8}"
PF_MIX="${CACAO_PF_MIX:-${DEF_PF_MIX}}"
PF_MGAIN_EXP="${CACAO_PF_MGAIN_EXP:-0.50}"
PF_MAXWAITUS="${CACAO_PF_MAXWAITUS:-3000}"

if [[ "${PF_MODE}" == "eof" ]]; then
    PF_MK_UNIT="mkEOFPF-${N}"
    PF_APP_UNIT="applyEOFPF-${N}"
    PF_MK_EXEC="cacao-fpsexec-cacaopc-mkEOFPF"
    PF_APP_EXEC="cacao-fpsexec-cacaopc-applyEOFPF"
    PF_MAT_SFX="eofPFmat"
else
    PF_MK_UNIT="mkARPF-${N}"
    PF_APP_UNIT="applyARPF-${N}"
    PF_MK_EXEC="cacao-fpsexec-cacaopc-mkARPF"
    PF_APP_EXEC="cacao-fpsexec-cacaopc-applyARPF"
    PF_MAT_SFX="arPFmat"
fi
GAIN="${CACAO_LOOPGAIN:-${DEF_GAIN}}"
MULT="${CACAO_LOOPMULT:-${DEF_MULT}}"
SVDLIM="${CACAO_SVDLIM:-${DEF_SVDLIM}}"
CPAMAX="${CACAO_CPAMAX:-${DEF_CPAMAX}}"
RCPAMAX="${CACAO_RCPAMAX:-${DEF_RCPAMAX}}"
DELTACPA="${CACAO_DELTACPA:-${DEF_DELTACPA}}"
MGAIN_ALPHA="${CACAO_MGAIN_ALPHA:-${DEF_MGAIN_ALPHA}}"
MGAIN_FLOOR="${CACAO_MGAIN_FLOOR:-${DEF_MGAIN_FLOOR}}"
MGAIN_TT="${CACAO_MGAIN_TT:-1.0}"
MLAT_NBITER="${CACAO_MLAT_NBITER:-30}"
MLAT_CPA="${CACAO_MLAT_CPA:-${DEF_MLAT_CPA}}"
NMODES_DIRECT="${CACAO_NMODES_DIRECT:-${DEF_NMODES_DIRECT}}"
WFSMASK_RAD="${CACAO_WFSMASK_RAD:-${DEF_WFSMASK_RAD}}"
SELFRM_ZSIZE="${CACAO_SELFRM_ZSIZE:-8}"
POKE_AMPL="${CACAO_POKEAMPL:-${DEF_AMPL}}"
FAST_CALIB="${CACAO_FAST_CALIB:-0}"
HTSIM_UNIT="${CACAO_HTSIM_UNIT:-csim_htsim}"

XCENT="$(awk -v n="${DMX}" 'BEGIN { printf "%.2f", 0.5 * (n - 1.0) }')"
YCENT="$(awk -v n="${DMY}" 'BEGIN { printf "%.2f", 0.5 * (n - 1.0) }')"
WFS_XCENT="$(awk -v n="${WFSX}" 'BEGIN { printf "%.2f", 0.5 * (n - 1.0) }')"
WFS_YCENT="$(awk -v n="${WFSY}" 'BEGIN { printf "%.2f", 0.5 * (n - 1.0) }')"
RAD="$(awk -v d="${PUP_DIAM_ACT}" 'BEGIN { printf "%.2f", 0.5 * d }')"
HAD_RAD="$(awk -v r="${RAD}" 'BEGIN { printf "%.2f", r + 1.2 }')"
RAD_IN="$(awk -v r="${RAD}" 'BEGIN { printf "%.2f", 0.307 * r - 1.4 }')"

DESC_SHORT="deploy, calibrate, and control Stage-1 AO3k, Stage-2 SCExAO, or Stage-3 LLOWFS loop"
DESC_LONG="Deploy, calibrate, and operate Stage-1 AO3k (64x64 NIR PyWFS), Stage-2 SCExAO
(50x50 Vis PyWFS + ZPO), or Stage-3 LLOWFS (50x50 ZPO + 64x64 Lyot-Refl LLOWFS) AO loops."

usage() {
    cat <<EOF
${SCRIPT_NAME} - ${DESC_SHORT}

Usage:
  ${SCRIPT_NAME} [--stage 1|2|3] deploy [--restart] [--init-only]
  ${SCRIPT_NAME} [--stage 1|2|3] calibrate [--nframes N] [--nbloop N] [--svdlim F]
                                           [--save-rm DIR] [--load-rm DIR]
  ${SCRIPT_NAME} [--stage 1|2|3] save-rm <dir>
  ${SCRIPT_NAME} [--stage 1|2|3] load-rm <dir> [--svdlim F] [--takeref] [--nframes N]
  ${SCRIPT_NAME} [--stage 1|2|3] takeref [nframes]
  ${SCRIPT_NAME} [--stage 1|2|3] mlat [nbiter]
  ${SCRIPT_NAME} [--stage 1|2|3] setmgains [alpha [floor [mgainTT]]]
  ${SCRIPT_NAME} [--stage 1|2|3] selfrm <out.fits> [--nbmode M] [--ampl A] [--nbiter K] [--fast]
  ${SCRIPT_NAME} [--stage 1|2|3] close [gain]
  ${SCRIPT_NAME} [--stage 1|2|3] pf-on [mixcoeff [pflatency]]
  ${SCRIPT_NAME} [--stage 1|2|3] pf-freeze
  ${SCRIPT_NAME} [--stage 1|2|3] pf-off
  ${SCRIPT_NAME} [--stage 1|2|3] testol [mode [ampl [nbsample]]]
  ${SCRIPT_NAME} [--stage 1|2|3] open
  ${SCRIPT_NAME} [--stage 1|2|3] zero
  ${SCRIPT_NAME} [--stage 1|2|3] status
  ${SCRIPT_NAME} [--stage 1|2|3] teardown [--purge-dm]
EOF
}

case "${1:-}" in
    -h1|--help-oneline)     echo "${DESC_SHORT}"; exit 0 ;;
    -h2|--help-description) echo "${DESC_LONG}"; exit 0 ;;
    -h|--help|-hm|--help-mono|"") usage; exit 0 ;;
esac

ALL_UNITS=()
(( OWNS_DM )) && ALL_UNITS+=("DMch2disp-${DM}")
ALL_UNITS+=(
    "acquWFS-${N}"
    "wfs2cmodeval-${N}"
    "mfilt-${N}"
    "${PF_MK_UNIT}"
    "${PF_APP_UNIT}"
    "mvalC2dm-${N}"
    "mlat-${N}"
    "measlinresp-${N}"
    "compstrCM-${N}"
    "mctrlstats-${N}"
)
(( USE_ZPO_MVM )) && ALL_UNITS+=("zpo-${N}")

ensure_stream_zeros() {
    local sfx="$1" dims="$2"
    local sname="${PFX}${sfx}"
    __fpspipe_track_stream "${sname}"
    if ! @exists "s.${sname}"; then
        @calc "@S:${sname} = zeros(${dims})"
        FPSPIPE_CREATED_STREAMS+=("${sname}")
    fi
}

ensure_stream_ones() {
    local sfx="$1" nx="$2" ny="$3"
    local sname="${PFX}${sfx}"
    __fpspipe_track_stream "${sname}"
    if ! @exists "s.${sname}"; then
        @calc "@S:${sname} = zeros(${nx}, ${ny}) + 1"
        FPSPIPE_CREATED_STREAMS+=("${sname}")
    fi
}

enter_workdir() {
    local restart="${1:-0}"
    cacaoloop.workdir "${LOOPNAME}" "${N}" "${ROOTDIR}" \
        .dm="${DM}" .dmx="${DMX}" .dmy="${DMY}" .wfs="${WFS_STREAM}" .restart="${restart}"
}

append_extra_cacaovars() {
    local dmch_on="OFF" zpo_on="OFF"
    (( OWNS_DM )) && dmch_on="ON"
    (( USE_ZPO_MVM )) && zpo_on="ON"
    local cvfile="${FPSPIPE_ROOTDIR}/cacaovars.${LOOPNAME}.bash"
    cat >> "${cvfile}" <<EOF
export CACAO_DMSIMINDEX="${DM}"
export CACAO_DM_beam_xcent="${XCENT}"
export CACAO_DM_beam_ycent="${YCENT}"
export CACAO_DM_beam_rad="${RAD}"
export CACAO_WFSSTREAM_PROCESSED="OFF"
export CACAO_WFSFRATE="${RATE}"
export CACAO_LATENCYHARDWFR="${LAT_FR}"
export CACAO_FPSPROC_DMCH2DISP="${dmch_on}"
export CACAO_FPSPROC_ACQUWFS="ON"
export CACAO_FPSPROC_MLAT="ON"
export CACAO_FPSPROC_MEASURELINRESP="ON"
export CACAO_FPSPROC_COMPSTRCM="ON"
export CACAO_FPSPROC_MVMGPU_WFS2CMODEVAL="ON"
export CACAO_FPSPROC_MODALFILTERING="ON"
export CACAO_FPSPROC_MVMGPU_CMODEVAL2DM="ON"
export CACAO_FPSPROC_MVMGPU_ZPO="${zpo_on}"
export CACAO_FPSPROC_MODALCTRL_STATS="ON"
EOF
    ln -sfn "${FPSPIPE_ROOTDIR%/*}/logdir-${LOOPNAME}" "${FPSPIPE_ROOTDIR}/logdir"
}

do_takeref() {
    local nframes="${1:-60}"
    local ave_fps="takeref-${N}"
    local save_fps="savefits-${N}"
    local tmp_shm="${PFX}wfsref_tmp"

    milk-stream-wait -q -t 15 "${PFX}imWFS1"
    milk-fps-rm -f -q --ignore-missing "${ave_fps}" "${save_fps}" >/dev/null 2>&1 || true

    milk-fps-init -q "${ave_fps}" milk-fpsexec-mem-streamave >/dev/null
    milk-fps-set -q \
        "${ave_fps}.in_name=${PFX}imWFS1" \
        "${ave_fps}.outave_name=${tmp_shm}" \
        "${ave_fps}.out_shared=1" \
        "${ave_fps}.NBcoadd=${nframes}" \
        "${ave_fps}.procinfo.triggersname=${PFX}imWFS1" \
        "${ave_fps}.procinfo.triggermode=3" \
        "${ave_fps}.procinfo.loopcntMax=${nframes}" \
        "${ave_fps}.procinfo.enabled=ON"
    milk-fps-runstart -q "${ave_fps}"
    milk-fps-wait -q -t 45 "${ave_fps}"
    milk-fps-rm -f -q --ignore-missing "${ave_fps}" >/dev/null 2>&1 || true

    milk-fpsexec-iofits-saveFITS --no-procinfo -n "${save_fps}" exec \
        "${tmp_shm}" "!../conf/wfsref.fits" >/dev/null
    milk-fps-rm -f -q --ignore-missing "${save_fps}" >/dev/null 2>&1 || true

    @calc "@S:${PFX}wfsref = s.${tmp_shm}"
    @calc "@S:${PFX}wfsrefc = s.${tmp_shm}"
    milk-stream-rm -q --ignore-missing "${tmp_shm}" >/dev/null 2>&1 || true
    printf '%s\n' "${FPSPIPE_ROOTDIR}/conf/wfsref.fits" > "../conf/shmim.wfsref.name.txt"
    ln -sfn "${FPSPIPE_ROOTDIR}/conf/wfsref.fits" "../conf/shmim.wfsref.fits"
    printf '%s\n' "${FPSPIPE_ROOTDIR}/conf/wfsref.fits" > "../conf/shmim.wfsrefc.name.txt"
    ln -sfn "${FPSPIPE_ROOTDIR}/conf/wfsref.fits" "../conf/shmim.wfsrefc.fits"
}

cmd_deploy() {
    local restart=0 init_only=0
    while (( $# > 0 )); do
        case "$1" in
            --restart)   restart=1 ;;
            --init-only) init_only=1 ;;
            *) echo "${SCRIPT_NAME}: unknown deploy option '$1'" >&2; return 2 ;;
        esac
        shift
    done

    enter_workdir "${restart}"
    append_extra_cacaovars

    ensure_stream_zeros wfsdark     "${WFSX}, ${WFSY}"
    ensure_stream_zeros wfszpo      "${WFSX}, ${WFSY}"
    ensure_stream_zeros DMastrogrid "${DMX}, ${DMY}"
    if (( ! init_only )); then
        if [[ -f ../conf/dmmask.fits ]]; then
            fpspipe.loadfits dmmask ../conf/dmmask
        else
            ensure_stream_ones dmmask "${DMX}" "${DMY}"
        fi
        if [[ -f ../conf/wfsmask.fits ]]; then
            fpspipe.loadfits wfsmask ../conf/wfsmask
        else
            ensure_stream_ones wfsmask "${WFSX}" "${WFSY}"
        fi
        if [[ -f ../conf/wfsref.fits ]]; then
            fpspipe.loadfits wfsref  ../conf/wfsref
            fpspipe.loadfits wfsrefc ../conf/wfsref
        else
            ensure_stream_zeros wfsref  "${WFSX}, ${WFSY}"
            ensure_stream_zeros wfsrefc "${WFSX}, ${WFSY}"
        fi
        if [[ -f ../conf/CMmodesWFS.fits && -f ../conf/CMmodesDM.fits ]]; then
            fpspipe.loadfits CMmodesWFS ../conf/CMmodesWFS
            fpspipe.loadfits CMmodesDM  ../conf/CMmodesDM
        else
            ensure_stream_zeros CMmodesWFS "${WFSX}, ${WFSY}, 16"
            ensure_stream_zeros CMmodesDM  "${DMX}, ${DMY}, 16"
        fi
    fi

    local init_manifest=""
    if (( OWNS_DM )); then
        init_manifest+=$'DMch2disp-'"${DM}"$'       cacao-fpsexec-dmcomb\n'
    fi
    init_manifest+="$(cat <<EOF
acquWFS-${N}          cacao-fpsexec-cacaoiot-acquireWFS
wfs2cmodeval-${N}     milk-fpsexec-linalg-MVMextract
mfilt-${N}            cacao-fpsexec-mfilt
${PF_MK_UNIT}         ${PF_MK_EXEC}
${PF_APP_UNIT}        ${PF_APP_EXEC}
mvalC2dm-${N}         milk-fpsexec-linalg-MVMextract
mlat-${N}             cacao-fpsexec-cacaopt-mlat
measlinresp-${N}      cacao-fpsexec-cacaoac-measlinresp
compstrCM-${N}        cacao-fpsexec-cacaocc-compstrcm
mctrlstats-${N}       cacao-fpsexec-modalCTRLstats
EOF
)"
    if (( USE_ZPO_MVM )); then
        init_manifest+=$'\nzpo-'"${N}"$'             milk-fpsexec-linalg-MVMextract'
    fi

    fpspipe.init <<EOF
${init_manifest}
EOF

    if (( OWNS_DM )); then
        local zpo_en="OFF" zpo_ch04="OFF" zpo_ch05="OFF"
        if (( USE_ZPO_MVM )); then
            zpo_en="ON"
            zpo_ch04="ON"
            zpo_ch05="ON"
        fi
        fpspipe.setparams <<EOF
DMch2disp-${DM}.DMindex               = ${DM}
DMch2disp-${DM}.DMxsize               = ${DMX}
DMch2disp-${DM}.DMysize               = ${DMY}
DMch2disp-${DM}.NBchannel             = 12
DMch2disp-${DM}.DMcombout             = dm${DM}disp
DMch2disp-${DM}.DMmode                = 0
DMch2disp-${DM}.option.voltmode       = OFF
DMch2disp-${DM}.option.DClevel        = 0.0
DMch2disp-${DM}.astrogrid.sname       = ${PFX}DMastrogrid
DMch2disp-${DM}.zpoffset.DMcomboutzpo = ${PFX}dmzpo
DMch2disp-${DM}.zpoffset.ch04         = ${zpo_ch04}
DMch2disp-${DM}.zpoffset.ch05         = ${zpo_ch05}
DMch2disp-${DM}.zpoffset.enable       = ${zpo_en}
DMch2disp-${DM}.option.semwaitall     = ON
DMch2disp-${DM}.procinfo.loopcntMax   = -1
DMch2disp-${DM}.procinfo.triggermode  = 0
DMch2disp-${DM}.procinfo.MeasureTiming = ON
EOF
    fi

    if (( USE_ZPO_MVM )); then
        fpspipe.setparams <<EOF
zpo-${N}.GPUindex                = ${GPUINDEX}
zpo-${N}.insname                 = ${PFX}dmzpo
zpo-${N}.immodes                 = ${PFX}zrespM
zpo-${N}.outcoeff                = ${PFX}wfszpo
zpo-${N}.axmode                  = 1
zpo-${N}.option.MODENORM         = OFF
zpo-${N}.procinfo.loopcntMax     = -1
zpo-${N}.procinfo.triggermode    = 3
zpo-${N}.procinfo.triggersname   = ${PFX}dmzpo
zpo-${N}.procinfo.MeasureTiming  = ON
EOF
    fi

    local pf_lat
    pf_lat="$(awk -v h="${LAT_FR}" -v s="${SOFT_LAT_FR}" 'BEGIN { printf "%.3f", h + s }')"

    fpspipe.setparams <<EOF
acquWFS-${N}.AOloopindex              = ${N}
acquWFS-${N}.insname                  = ${PFX}wfsim
acquWFS-${N}.WFSnormfloor             = 1.0
acquWFS-${N}.comp.darksub             = OFF
acquWFS-${N}.comp.WFSnormalize        = ON
acquWFS-${N}.comp.WFSrefsub           = ON
acquWFS-${N}.comp.WFSsigav            = ON
acquWFS-${N}.comp.WFSrefc             = ON
acquWFS-${N}.wfszpo                   = ${PFX}wfszpo
acquWFS-${N}.procinfo.loopcntMax      = -1
acquWFS-${N}.procinfo.triggermode     = 3
acquWFS-${N}.procinfo.triggersname    = ${PFX}wfsim
acquWFS-${N}.procinfo.MeasureTiming   = ON

wfs2cmodeval-${N}.GPUindex            = ${GPUINDEX}
wfs2cmodeval-${N}.insname             = ${PFX}imWFS2
wfs2cmodeval-${N}.inmasksname         = ${PFX}wfsmask
wfs2cmodeval-${N}.immodes             = ${PFX}CMmodesWFS
wfs2cmodeval-${N}.outcoeff            = ${PFX}modevalWFS
wfs2cmodeval-${N}.axmode              = 0
wfs2cmodeval-${N}.option.MODENORM     = ON
wfs2cmodeval-${N}.procinfo.loopcntMax = -1
wfs2cmodeval-${N}.procinfo.triggermode  = 3
wfs2cmodeval-${N}.procinfo.triggersname = ${PFX}imWFS2
wfs2cmodeval-${N}.procinfo.MeasureTiming = ON

mfilt-${N}.AOloopindex                = ${N}
mfilt-${N}.inmval                     = ${PFX}modevalWFS
mfilt-${N}.outmval                    = ${PFX}modevalDM
mfilt-${N}.loopON                     = OFF
mfilt-${N}.loopgain                   = ${GAIN}
mfilt-${N}.loopmult                   = ${MULT}
mfilt-${N}.looplimit                  = 1.0
mfilt-${N}.comp.OLmodes               = ON
mfilt-${N}.comp.WFSfact               = ${PSOL_WFSFACT}
mfilt-${N}.comp.latencyhardwfr        = ${LAT_FR}
mfilt-${N}.comp.latencysoftwfr        = ${SOFT_LAT_FR}
mfilt-${N}.comp.tbuff                 = ON
mfilt-${N}.comp.tbuffsize             = ${TBUFF_SIZE}
mfilt-${N}.PF.enable                  = OFF
mfilt-${N}.PF.NBblock                 = 1
mfilt-${N}.PF.maxwaitus               = ${PF_MAXWAITUS}
mfilt-${N}.PF.mixcoeff                = ${PF_MIX}
mfilt-${N}.selfRM.zsize               = ${SELFRM_ZSIZE}
mfilt-${N}.selfRM.NBmode              = 2000
mfilt-${N}.selfRM.pokeampl            = ${POKE_AMPL}
mfilt-${N}.selfRM.nbiter              = 1
mfilt-${N}.selfRM.nbsettle            = 2
mfilt-${N}.procinfo.loopcntMax        = -1
mfilt-${N}.procinfo.triggermode       = 3
mfilt-${N}.procinfo.triggersname      = ${PFX}modevalWFS
mfilt-${N}.procinfo.MeasureTiming     = ON

${PF_MK_UNIT}.AOloopindex               = ${N}
${PF_MK_UNIT}.inbuff                    = ${PFX}modevalOL_buff
${PF_MK_UNIT}.outPF                     = ${PFX}${PF_MAT_SFX}
${PF_MK_UNIT}.PForder                   = ${PF_ORDER}
${PF_MK_UNIT}.PFlatency                 = ${pf_lat}
${PF_MK_UNIT}.NBtrain                   = ${PF_NBTRAIN}
${PF_MK_UNIT}.minsamples                = ${PF_MINSAMPLES}
${PF_MK_UNIT}.reglambda                 = ${PF_REG}
${PF_MK_UNIT}.procinfo.loopcntMax       = -1
${PF_MK_UNIT}.procinfo.triggermode      = 3
${PF_MK_UNIT}.procinfo.triggersname     = ${PFX}modevalOL_buff
${PF_MK_UNIT}.procinfo.MeasureTiming    = ON

${PF_APP_UNIT}.AOloopindex            = ${N}
${PF_APP_UNIT}.indata                 = ${PFX}modevalOL
${PF_APP_UNIT}.PFmat                  = ${PFX}${PF_MAT_SFX}
${PF_APP_UNIT}.outdata                = ${PFX}modevalPF
${PF_APP_UNIT}.outPFstat              = ${PFX}outPFstat
${PF_APP_UNIT}.PForder                = ${PF_ORDER}
${PF_APP_UNIT}.rampsteps              = 32
${PF_APP_UNIT}.procinfo.loopcntMax    = -1
${PF_APP_UNIT}.procinfo.triggermode   = 3
${PF_APP_UNIT}.procinfo.triggersname  = ${PFX}modevalOL
${PF_APP_UNIT}.procinfo.MeasureTiming = ON

mvalC2dm-${N}.GPUindex                = ${GPUINDEX}
mvalC2dm-${N}.insname                 = ${PFX}modevalDM
mvalC2dm-${N}.inmasksname             = ${PFX}dmmask
mvalC2dm-${N}.immodes                 = ${PFX}CMmodesDM
mvalC2dm-${N}.outcoeff                = ${PFX}dmC
mvalC2dm-${N}.axmode                  = 1
mvalC2dm-${N}.option.MODENORM         = OFF
mvalC2dm-${N}.procinfo.loopcntMax     = -1
mvalC2dm-${N}.procinfo.triggermode    = 3
mvalC2dm-${N}.procinfo.triggersname   = ${PFX}modevalDM
mvalC2dm-${N}.procinfo.MeasureTiming  = ON

mlat-${N}.frameratewait               = 0.5
mlat-${N}.CPA                         = ${MLAT_CPA}
mlat-${N}.NBiter                      = ${MLAT_NBITER}
mlat-${N}.OPDamp                      = 0.03
mlat-${N}.wfsNBframemax               = 12
mlat-${N}.option.seqNBframe           = 25
mlat-${N}.option.saveseq              = ON
mlat-${N}.dmstream                    = ${PFX}dmRM
mlat-${N}.wfsstream                   = ${PFX}imWFS2
mlat-${N}.procinfo.loopcntMax         = 1

measlinresp-${N}.streamin             = ${PFX}dmRM
measlinresp-${N}.streamout            = ${PFX}imWFS2
measlinresp-${N}.inmodes              = ../conf/HpokeC.fits
measlinresp-${N}.outmodes             = ../conf/HrespC.fits
measlinresp-${N}.ampl                 = ${POKE_AMPL}
measlinresp-${N}.timing.WFSfrequ      = ${RATE}
measlinresp-${N}.timing.hardwlatfr    = ${LAT_FR}
measlinresp-${N}.timing.NBave         = 2
measlinresp-${N}.timing.NBexcl        = 2
measlinresp-${N}.timing.NBinnerCycle  = 1
measlinresp-${N}.procinfo.loopcntMax  = 1

compstrCM-${N}.RMmodesDM              = ../conf/zpokeC.fits
compstrCM-${N}.RMmodesWFS             = ../conf/zrespC.fits
compstrCM-${N}.dmmask                 = ../conf/dmmask.fits
compstrCM-${N}.wfsmask                = ../conf/wfsmask.fits
compstrCM-${N}.CMmodesDM              = ../conf/CMmodesDM.fits
compstrCM-${N}.CMmodesWFS             = ../conf/CMmodesWFS.fits
compstrCM-${N}.svdlim                 = ${SVDLIM}
compstrCM-${N}.GPUdevice              = ${GPUINDEX}
compstrCM-${N}.procinfo.loopcntMax    = 1
compstrCM-${N}.procinfo.MeasureTiming = ON

mlat-${N}.procinfo.MeasureTiming      = ON
measlinresp-${N}.procinfo.MeasureTiming = ON
mctrlstats-${N}.AOloopindex           = ${N}
mctrlstats-${N}.procinfo.MeasureTiming = ON
EOF

    if [[ "${PF_MODE}" == "eof" ]]; then
        milk-fps-set -q \
            "${PF_MK_UNIT}.blocksize=${PF_BLOCKSIZE}" \
            "${PF_MK_UNIT}.diagorder=${PF_DIAGORDER}" \
            "${PF_MK_UNIT}.diagminsamples=${PF_DIAGMINSAMPLES}" \
            "${PF_MK_UNIT}.updateperiod=${PF_UPDATEPERIOD}" \
            "${PF_APP_UNIT}.blocksize=${PF_BLOCKSIZE}" \
            "${PF_APP_UNIT}.diagorder=${PF_DIAGORDER}" \
            "${PF_APP_UNIT}.nthreads=${PF_NTHREADS}"
    fi
    if [[ -n "${PF_MAXNORM2}" ]]; then
        milk-fps-set -q "${PF_MK_UNIT}.maxnorm2=${PF_MAXNORM2}"
    fi

    milk-stream-wait -q -t 20 "${WFS_STREAM}:${WFSX}x${WFSY}"
    milk-stream-link -q --no-conf --allow-missing "${WFS_STREAM}=${PFX}wfsim"
    __fpspipe_track_stream "${PFX}wfsim"

    if (( init_only )); then
        fpspipe.commit
        return 0
    fi

    if (( OWNS_DM )); then
        milk-fps-runstart -q "DMch2disp-${DM}"
        milk-stream-wait -q -t 15 "dm${DM}disp00:${DMX}x${DMY}" "dm${DM}disp:${DMX}x${DMY}"
        cacaoloop.link_dm "${DM}" "${DMX}" "${DMY}"
        if (( USE_ZPO_MVM )); then
            milk-stream-wait -q -t 15 "${PFX}dmzpo:${DMX}x${DMY}"
            __fpspipe_track_stream "${PFX}dmzpo"
            if [[ -f ../conf/zrespC.fits ]]; then
                fpspipe.loadfits zrespM ../conf/zrespC .force=1
                milk-fps-runstart -q "zpo-${N}"
            fi
        fi
    else
        milk-stream-wait -q -t 15 \
            "dm${DM}disp00:${DMX}x${DMY}" \
            "dm${DM}disp04:${DMX}x${DMY}" \
            "dm${DM}disp05:${DMX}x${DMY}" \
            "dm${DM}disp:${DMX}x${DMY}"
        milk-stream-link -q --no-conf --expect-size "${DMX}x${DMY}" -p "${PFX}" \
            "dm${DM}disp00=dmO" \
            "dm${DM}disp04=dmC" \
            "dm${DM}disp05=dmRM" \
            "dm${DM}disp=dmdisp"
        for _sfx in dmO dmC dmRM dmdisp; do
            __fpspipe_track_stream "${PFX}${_sfx}"
        done
    fi

    milk-fps-runstart -q "acquWFS-${N}"
    milk-stream-wait -q -t 15 "${PFX}imWFS0" "${PFX}imWFS1" "${PFX}imWFS2+1"

    milk-fps-runstart -q "wfs2cmodeval-${N}"
    milk-stream-wait -q -t 15 "${PFX}modevalWFS+1"

    milk-fps-runstart -q "mfilt-${N}"
    milk-stream-wait -q -t 15 "${PFX}modevalDM"

    milk-fps-runstart -q "mvalC2dm-${N}"
    fpspipe.commit
}

resolve_caller_path() {
    local p="$1"
    if [[ "${p}" == /* ]]; then
        realpath -m "${p}"
    else
        realpath -m "${CALLER_PWD}/${p}"
    fi
}

write_rm_meta() {
    local fps_hz="$1" lat_fr="$2" svdlim="$3"
    cat > "../conf/rm_meta.env" <<EOF
export RM_LOOPNAME="${LOOPNAME}"
export RM_DMX="${DMX}"
export RM_DMY="${DMY}"
export RM_WFSX="${WFSX}"
export RM_WFSY="${WFSY}"
export RM_WFSFRATE="${fps_hz}"
export RM_LATENCYHARDWFR="${lat_fr}"
export RM_SVDLIM="${svdlim}"
EOF
}

apply_modal_gains() {
    local alpha="${1:-${MGAIN_ALPHA}}"
    local floor="${2:-${MGAIN_FLOOR}}"
    local gtt="${3:-${MGAIN_TT}}"
    milk-stream-wait -q -t 15 "${PFX}mgainfact" "${PFX}modevalDMf"
    local nmodes=1 save_fps="savemgf-${N}-$$"
    @get nmodes="s.${PFX}mgainfact.xsize"
    local expr="(1.0 - ${floor}) * pow(1.0 - imd / ${nmodes}, ${alpha}) + ${floor}"
    cacao-cli -q >/dev/null <<EOF
imgen.mkdist imd ${nmodes} 1 0 0
@calc "s.${PFX}mgainfact = ${expr}"
@calc "s.${PFX}mgainfact[0, 0] = ${gtt}; s.${PFX}mgainfact[1, 0] = ${gtt}"
exit
EOF
    milk-fpsexec-iofits-saveFITS --no-procinfo -n "${save_fps}" exec \
        "${PFX}mgainfact" "!../conf/mgainfact.fits" >/dev/null
    milk-fps-rm -f -q --ignore-missing "${save_fps}" >/dev/null 2>&1 || true
}

elapsed_s() {
    awk -v t0="$1" -v t1="$2" 'BEGIN { printf "%.4f", (t1 > t0 ? t1 - t0 : 0.0) }'
}

write_calib_timings() {
    local dst="../conf/calib_timings.json"
    local prev_mlr="${PREV_MEASLINRESP_S:-null}"
    local prev_had="${PREV_HADDEC_S:-null}"
    local prev_mkh="${PREV_MKHADAMARD_S:-null}"
    local v_tr="${LAST_TAKEREF_S:-0.0}"
    local v_ml="${LAST_MLAT_S:-0.0}"
    local v_mk="${LAST_MKHADAMARD_S:-${prev_mkh}}"
    local v_mr="${LAST_MEASLINRESP_S:-${prev_mlr}}"
    local v_hd="${LAST_HADDEC_S:-${prev_had}}"
    local v_mx="${LAST_MASKEXTRAP_S:-0.0}"
    local v_sg="${LAST_SGEMM_S:-0.0}"
    local v_sv="${LAST_COMPSTRCM_S:-0.0}"
    local v_rl="${LAST_RELOAD_CM_S:-0.0}"
    cat > "${dst}" <<EOF
{
  "stage": ${N},
  "loopname": "${LOOPNAME}",
  "takeref_s": ${v_tr},
  "mlat_s": ${v_ml},
  "mkhadamard_s": ${v_mk},
  "measlinresp_s": ${v_mr},
  "haddec_and_masks_s": ${v_hd},
  "maskextrapolate_s": ${v_mx},
  "sgemm_s": ${v_sg},
  "compstrcm_svd_s": ${v_sv},
  "reload_cm_s": ${v_rl}
}
EOF
}

build_and_load_cm() {
    local svdlim="$1" lat_fr="$2" norm_scale="${3:-1.0}"
    local rad_ext rad_fact zcmd fcmd scale_cmds="" t0 t1 t2 t3
    if [[ "${norm_scale}" != "1.0" && "${norm_scale}" != "1.00000000" ]]; then
        scale_cmds=$'@calc "zrespM = zrespM * '"${norm_scale}"$'"\n'
        scale_cmds+='iofits.saveFITS zrespM "!../conf/zrespC.fits"'
    fi

    if (( MODAL_DIRECT )); then
        t0="$(date +%s.%N)"
        if [[ -n "${scale_cmds}" ]]; then
            cacao-cli -q >/dev/null 2>&1 <<EOF
iofits.loadfits "../conf/zrespC.fits" zrespM .
${scale_cmds}
exit
EOF
        fi
        cp -f "../conf/zpokeC.fits" "../conf/RMsyn_modesDM.fits"
        cp -f "../conf/zrespC.fits" "../conf/RMsyn_modesWFS.fits"
        t2="$(date +%s.%N)"
        LAST_MASKEXTRAP_S="0.0"
        LAST_SGEMM_S="$(elapsed_s "${t0}" "${t2}")"
    else
        rad_ext="$(awk -v r="${RAD}" -v n="${DMX}" \
            'BEGIN { mx = 0.5 * n; v = r + 1.8; printf "%.4f", (v < mx ? v : mx) }')"
        rad_fact="$(awk -v r="${RAD}" -v re="${rad_ext}" 'BEGIN { printf "%.4f", re / r }')"
        zcmd="zern.mkzerc zerc ${DMX} ${DMY} ${XCENT} ${YCENT} ${RAD} 5"
        zcmd+=" .TTfactor=8.0 .radmaskfact=${rad_fact}"
        fcmd="lintools.mkFouriermodes Fmodes ${DMX} ${DMY} ${CPAMAX} ${DELTACPA}"
        fcmd+=" ${RAD} ${rad_fact} 0"
        fcmd+=" .fpowerlaw=-0.5 .rCPAmin=0.8 .rCPAmax=${RCPAMAX}"
        fcmd+=" .align.centered=0 .align.xcenter=${XCENT} .align.ycenter=${YCENT}"

        local ts_file="/tmp/.cacaoloop_ts_$$"
        rm -f "${ts_file}"
        t0="$(date +%s.%N)"
        OMP_NUM_THREADS=32 OPENBLAS_NUM_THREADS=32 cacao-cli -q >/dev/null 2>&1 <<EOF
${zcmd}
${fcmd}
arith.immerge zerc Fmodes syn0 2
imgen.mkdisk dmmaskext ${DMX} ${DMY} ${XCENT} ${YCENT} ${rad_ext}
iofits.loadfits "../conf/dmmask.fits" dmmask .
cacaocc.maskextrapolate syn0 dmmask dmmaskext RMsynDM 1.0
iofits.saveFITS RMsynDM "!../conf/RMsyn_modesDM.fits"
date +%s.%N > "${ts_file}"
iofits.loadfits "../conf/zrespC.fits" zrespM .
${scale_cmds}
cacaocc.generateRMWFS zrespM RMsynDM RMsynWFS
iofits.saveFITS RMsynWFS "!../conf/RMsyn_modesWFS.fits"
exit
EOF
        t2="$(date +%s.%N)"
        t1="$(cat "${ts_file}" 2>/dev/null || printf '%s\n' "${t2}")"
        rm -f "${ts_file}"
        LAST_MASKEXTRAP_S="$(elapsed_s "${t0}" "${t1}")"
        LAST_SGEMM_S="$(elapsed_s "${t1}" "${t2}")"
    fi

    milk-fps-set -q \
        "compstrCM-${N}.svdlim=${svdlim}" \
        "compstrCM-${N}.RMmodesDM=../conf/RMsyn_modesDM.fits" \
        "compstrCM-${N}.RMmodesWFS=../conf/RMsyn_modesWFS.fits" \
        "compstrCM-${N}.dmmask=../conf/dmmask.fits" \
        "compstrCM-${N}.wfsmask=../conf/wfsmask.fits" \
        "compstrCM-${N}.CMmodesDM=../conf/CMmodesDM.fits" \
        "compstrCM-${N}.CMmodesWFS=../conf/CMmodesWFS.fits"
    OMP_NUM_THREADS=32 OPENBLAS_NUM_THREADS=32 milk-fps-runstart -q "compstrCM-${N}"
    milk-fps-wait -q -t 600 "compstrCM-${N}"
    t3="$(date +%s.%N)"
    LAST_COMPSTRCM_S="$(elapsed_s "${t2}" "${t3}")"

    milk-fps-runstop -q "${PF_MK_UNIT}" "${PF_APP_UNIT}" >/dev/null 2>&1 || true
    milk-fps-runstop -q "mvalC2dm-${N}" "mfilt-${N}" "wfs2cmodeval-${N}"
    milk-stream-rm -r -f -q --ignore-missing \
        "^${PFX}(CMmodes|modeval|mWFSfact|outPFstat|mPFmix|mgain|mmult|mlimit)" \
        "^${PFX}(mzeropoint|offload|mval|mfiltselfRM|arPFmat|eofPFmat)"
    fpspipe.loadfits CMmodesWFS ../conf/CMmodesWFS .force=1
    fpspipe.loadfits CMmodesDM  ../conf/CMmodesDM  .force=1

    local pf_lat
    pf_lat="$(awk -v h="${lat_fr}" -v s="${SOFT_LAT_FR}" 'BEGIN { printf "%.3f", h + s }')"
    milk-fps-runstart -q "wfs2cmodeval-${N}"
    milk-stream-wait -q -t 30 "${PFX}modevalWFS+1"
    milk-fps-set -q \
        "mfilt-${N}.comp.OLmodes=ON" \
        "mfilt-${N}.comp.tbuff=ON" \
        "mfilt-${N}.comp.WFSfact=${PSOL_WFSFACT}" \
        "mfilt-${N}.comp.latencyhardwfr=${lat_fr}" \
        "mfilt-${N}.comp.latencysoftwfr=${SOFT_LAT_FR}" \
        "mfilt-${N}.selfRM.zsize=${SELFRM_ZSIZE}" \
        "${PF_MK_UNIT}.PFlatency=${pf_lat}"
    milk-fps-runstart -q "mfilt-${N}"
    milk-stream-wait -q -t 30 \
        "${PFX}modevalDM" "${PFX}modevalOL" "${PFX}modevalOL_buff" \
        "${PFX}mgainfact" "${PFX}mPFmixfact" "${PFX}modevalDMf" "${PFX}mfiltselfRM"
    apply_modal_gains "${MGAIN_ALPHA}" "${MGAIN_FLOOR}" "${MGAIN_TT}"
    milk-fps-runstart -q "mvalC2dm-${N}"
    milk-stream-wait -q -t 30 "${PFX}dmC"

    if (( USE_ZPO_MVM )) && [[ -f ../conf/zrespC.fits ]]; then
        milk-fps-runstop -q "zpo-${N}" >/dev/null 2>&1 || true
        milk-stream-rm -q --ignore-missing "${PFX}zrespM" >/dev/null 2>&1 || true
        fpspipe.loadfits zrespM ../conf/zrespC .force=1
        milk-stream-wait -q -t 15 "${PFX}dmzpo"
        milk-fps-runstart -q "zpo-${N}"
    fi

    local t4
    t4="$(date +%s.%N)"
    LAST_RELOAD_CM_S="$(elapsed_s "${t3}" "${t4}")"
}

run_and_stage_mlat() {
    local nbiter="${1:-${MLAT_NBITER}}"
    milk-fps-set -q \
        "mlat-${N}.NBiter=${nbiter}" \
        "mlat-${N}.option.saveseq=ON"
    milk-fps-runstart -q "mlat-${N}"
    milk-fps-wait -q -t 120 "mlat-${N}"
    @calc "s.${PFX}dmRM = s.${PFX}dmRM * 0.0"

    local mdir="fps.mlat-${N}.datadir"
    if [[ -f "${mdir}/hardwlatency.dat" ]]; then
        cp -f "${mdir}/hardwlatency.dat" "../conf/mlat_hardwlatency.dat"
    fi
    if [[ -f "${mdir}/hardwlatencypts.dat" ]]; then
        cp -f "${mdir}/hardwlatencypts.dat" "../conf/mlat_hardwlatencypts.dat"
    fi
    if [[ -f "${mdir}/cacaovars.bash" ]]; then
        cp -f "${mdir}/cacaovars.bash" "../conf/mlat_cacaovars.bash"
    fi
    if [[ -f "${mdir}/mlat-diffseq.fits" ]]; then
        cp -f "${mdir}/mlat-diffseq.fits" "../conf/mlat_diffseq.fits"
    fi
}

do_save_rm() {
    local rm_dir="$1"
    if [[ ! -f ../conf/zpokeC.fits || ! -f ../conf/zrespC.fits ]]; then
        echo "${SCRIPT_NAME}: missing calibrated RM in ${FPSPIPE_ROOTDIR}/conf" >&2
        return 1
    fi
    mkdir -p "${rm_dir}"
    local fname
    for fname in \
        zpokeC.fits zrespC.fits DMmask.fits HpokeC.fits Hpixindex.fits Hmat.fits \
        HrespC.fits dmmap.fits wfsmap.fits dmmask.fits wfsmask.fits wfsref.fits \
        RMsyn_modesDM.fits RMsyn_modesWFS.fits CMmodesDM.fits CMmodesWFS.fits \
        mlat_hardwlatency.dat mlat_hardwlatencypts.dat mlat_cacaovars.bash \
        mlat_diffseq.fits selfRM_calib.fits mgainfact.fits rm_meta.env \
        calib_timings.json; do
        if [[ -f "../conf/${fname}" ]]; then
            cp -f "../conf/${fname}" "${rm_dir}/${fname}"
        fi
    done
    for fname in VTmat.fits mode_norm.txt mode_norm_1.txt; do
        if [[ -f "mkmodestmp/${fname}" ]]; then
            cp -f "mkmodestmp/${fname}" "${rm_dir}/${fname}"
        fi
    done
    ln -sfn "zpokeC.fits" "${rm_dir}/RMmodesDM.fits"
    ln -sfn "zrespC.fits" "${rm_dir}/RMmodesWFS.fits"
    ln -sfn "zrespC.fits" "${rm_dir}/zrespM.fits"
}

do_load_rm() {
    local rm_dir="$1" svdlim="$2" svdlim_set="$3" retake_ref="$4" nframes="$5"
    local src_poke="" src_resp=""
    if [[ -f "${rm_dir}/zpokeC.fits" ]]; then
        src_poke="${rm_dir}/zpokeC.fits"
    elif [[ -f "${rm_dir}/RMmodesDM.fits" ]]; then
        src_poke="${rm_dir}/RMmodesDM.fits"
    fi
    if [[ -f "${rm_dir}/zrespC.fits" ]]; then
        src_resp="${rm_dir}/zrespC.fits"
    elif [[ -f "${rm_dir}/RMmodesWFS.fits" ]]; then
        src_resp="${rm_dir}/RMmodesWFS.fits"
    elif [[ -f "${rm_dir}/zrespM.fits" ]]; then
        src_resp="${rm_dir}/zrespM.fits"
    fi
    if [[ -z "${src_poke}" || -z "${src_resp}" ]]; then
        echo "${SCRIPT_NAME}: saved RM not found in '${rm_dir}'" >&2
        return 1
    fi

    @set "f.mfilt-${N}.loopON=OFF" "f.mfilt-${N}.loopZERO=ON"
    @calc "s.${PFX}dmRM = s.${PFX}dmRM * 0.0"
    @calc "s.${PFX}dmC = s.${PFX}dmC * 0.0"

    cp -fL "${src_poke}" "../conf/zpokeC.fits"
    cp -fL "${src_resp}" "../conf/zrespC.fits"
    local fname
    for fname in \
        DMmask.fits HpokeC.fits Hpixindex.fits Hmat.fits HrespC.fits \
        dmmap.fits wfsmap.fits dmmask.fits wfsmask.fits wfsref.fits \
        mlat_hardwlatency.dat mlat_hardwlatencypts.dat mlat_cacaovars.bash \
        mlat_diffseq.fits selfRM_calib.fits rm_meta.env calib_timings.json; do
        if [[ -f "${rm_dir}/${fname}" ]]; then
            cp -fL "${rm_dir}/${fname}" "../conf/${fname}"
        fi
    done

    PREV_MEASLINRESP_S="null"
    PREV_HADDEC_S="null"
    PREV_MKHADAMARD_S="null"
    if [[ -f "../conf/calib_timings.json" ]]; then
        PREV_MKHADAMARD_S="$(awk -F'[:,]' '/"mkhadamard_s"/{gsub(/ /,"",$2); print $2}' \
            ../conf/calib_timings.json || echo "null")"
        PREV_MEASLINRESP_S="$(awk -F'[:,]' '/"measlinresp_s"/{gsub(/ /,"",$2); print $2}' \
            ../conf/calib_timings.json || echo "null")"
        PREV_HADDEC_S="$(awk -F'[:,]' '/"haddec_and_masks_s"/{gsub(/ /,"",$2); print $2}' \
            ../conf/calib_timings.json || echo "null")"
    fi

    local fps_hz="${RATE}" lat_fr="${LAT_FR}"
    if [[ -f "../conf/rm_meta.env" ]]; then
        # shellcheck disable=SC1091
        source "../conf/rm_meta.env"
        fps_hz="${RM_WFSFRATE:-${fps_hz}}"
        lat_fr="${RM_LATENCYHARDWFR:-${lat_fr}}"
        if (( ! svdlim_set )) && [[ -n "${RM_SVDLIM:-}" ]]; then
            svdlim="${RM_SVDLIM}"
        fi
    fi

    if [[ ! -f "../conf/dmmask.fits" || ! -f "../conf/wfsmask.fits" ]]; then
        if (( MODAL_DIRECT )); then
            cacao-cli -q >/dev/null <<EOF
imgen.mkdisk dmmask ${DMX} ${DMY} ${XCENT} ${YCENT} ${HAD_RAD}
imgen.mkdisk wfsmask ${WFSX} ${WFSY} ${WFS_XCENT} ${WFS_YCENT} ${WFSMASK_RAD}
iofits.saveFITS dmmask "!../conf/dmmap.fits"
iofits.saveFITS wfsmask "!../conf/wfsmap.fits"
iofits.saveFITS dmmask "!../conf/dmmask.fits"
iofits.saveFITS wfsmask "!../conf/wfsmask.fits"
exit
EOF
        else
            cacao-cli -q >/dev/null <<EOF
iofits.loadfits "../conf/zrespC.fits" zrespC .
cacaocc.compmasksWFSDM zrespC ${DMX} ${DMY} 0.2 0.5 0.5 0.15 0.2 0.5 0.5 0.20
iofits.saveFITS dmmap "!../conf/dmmap.fits"
iofits.saveFITS wfsmap "!../conf/wfsmap.fits"
iofits.saveFITS dmmask "!../conf/dmmask.fits"
iofits.saveFITS wfsmask "!../conf/wfsmask.fits"
exit
EOF
        fi
    fi

    fpspipe.loadfits dmmask  ../conf/dmmask  .force=1
    fpspipe.loadfits wfsmask ../conf/wfsmask .force=1

    if (( retake_ref )) || [[ ! -f "../conf/wfsref.fits" ]]; then
        milk-stream-wait -q -t 15 "${PFX}imWFS1+15"
        local _tr0 _tr1
        _tr0="$(date +%s.%N)"
        do_takeref "${nframes}"
        _tr1="$(date +%s.%N)"
        LAST_TAKEREF_S="$(elapsed_s "${_tr0}" "${_tr1}")"
    else
        LAST_TAKEREF_S="0.0"
        fpspipe.loadfits wfsref  ../conf/wfsref .force=1
        fpspipe.loadfits wfsrefc ../conf/wfsref .force=1
        milk-stream-wait -q -t 15 "${PFX}imWFS2+5"
    fi

    if [[ ! -f "../conf/mlat_hardwlatencypts.dat" ]]; then
        local _ml0 _ml1
        _ml0="$(date +%s.%N)"
        run_and_stage_mlat "${MLAT_NBITER}"
        _ml1="$(date +%s.%N)"
        LAST_MLAT_S="$(elapsed_s "${_ml0}" "${_ml1}")"
        local m_fps=0.0 m_lat=0.0 min_hz max_hz
        @get m_fps="f.mlat-${N}.out.framerateHz" m_lat="f.mlat-${N}.out.latencyfr"
        min_hz="$(awk -v r="${RATE}" 'BEGIN { printf "%.3f", r * 0.4 }')"
        max_hz="$(awk -v r="${RATE}" 'BEGIN { printf "%.3f", r * 2.5 }')"
        if @test "${m_fps} >= ${min_hz} && ${m_fps} <= ${max_hz}"; then
            fps_hz="${m_fps}"
        fi
        if @test "${m_lat} >= 0.5 && ${m_lat} <= 3.5"; then
            lat_fr="${m_lat}"
        fi
    else
        LAST_MLAT_S="0.0"
    fi

    write_rm_meta "${fps_hz}" "${lat_fr}" "${svdlim}"
    build_and_load_cm "${svdlim}" "${lat_fr}"
    write_calib_timings
}

cmd_takeref() {
    local nframes="${1:-60}"
    enter_workdir 0
    fpspipe.commit
    do_takeref "${nframes}"
}

cmd_save_rm() {
    if (( $# < 1 )); then
        echo "${SCRIPT_NAME}: 'save-rm' requires <dir>" >&2
        return 2
    fi
    local rm_dir
    rm_dir="$(resolve_caller_path "$1")"
    enter_workdir 0
    fpspipe.commit
    do_save_rm "${rm_dir}"
}

cmd_load_rm() {
    if (( $# < 1 )); then
        echo "${SCRIPT_NAME}: 'load-rm' requires <dir>" >&2
        return 2
    fi
    local rm_dir svdlim="${SVDLIM}" svdlim_set=0 retake_ref=0 nframes=60
    rm_dir="$(resolve_caller_path "$1")"
    shift
    while (( $# > 0 )); do
        case "$1" in
            --svdlim)  svdlim="$2"; svdlim_set=1; shift 2 ;;
            --takeref) retake_ref=1; shift ;;
            --nframes) nframes="$2"; shift 2 ;;
            *) echo "${SCRIPT_NAME}: unknown load-rm option '$1'" >&2; return 2 ;;
        esac
    done
    enter_workdir 0
    fpspipe.commit
    do_load_rm "${rm_dir}" "${svdlim}" "${svdlim_set}" "${retake_ref}" "${nframes}"
}

cmd_calibrate() {
    local nframes=60 nbloop=1 svdlim="${SVDLIM}" svdlim_set=0
    local save_rm="" load_rm="" retake_ref=0
    while (( $# > 0 )); do
        case "$1" in
            --nframes) nframes="$2"; shift 2 ;;
            --nbloop)  nbloop="$2"; shift 2 ;;
            --svdlim)  svdlim="$2"; svdlim_set=1; shift 2 ;;
            --save-rm) save_rm="$(resolve_caller_path "$2")"; shift 2 ;;
            --load-rm) load_rm="$(resolve_caller_path "$2")"; shift 2 ;;
            --takeref) retake_ref=1; shift ;;
            *) echo "${SCRIPT_NAME}: unknown calibrate option '$1'" >&2; return 2 ;;
        esac
    done

    enter_workdir 0
    fpspipe.commit

    if [[ -n "${load_rm}" ]]; then
        do_load_rm "${load_rm}" "${svdlim}" "${svdlim_set}" "${retake_ref}" "${nframes}"
        if [[ -n "${save_rm}" ]]; then
            do_save_rm "${save_rm}"
        fi
        return 0
    fi

    @set "f.mfilt-${N}.loopON=OFF" "f.mfilt-${N}.loopZERO=ON"
    @calc "s.${PFX}dmRM = s.${PFX}dmRM * 0.0"
    @calc "s.${PFX}dmC = s.${PFX}dmC * 0.0"

    if (( MODAL_DIRECT )); then
        local _tc0 _tc1 _tc2 _tc3 _tc4
        _tc0="$(date +%s.%N)"
        cacao-cli -q >/dev/null 2>&1 <<EOF
imgen.mkdisk dmmask ${DMX} ${DMY} ${XCENT} ${YCENT} ${HAD_RAD}
imgen.mkdisk wfsmask ${WFSX} ${WFSY} ${WFS_XCENT} ${WFS_YCENT} ${WFSMASK_RAD}
zern.mkzerc zpokeC ${DMX} ${DMY} ${XCENT} ${YCENT} ${RAD} ${NMODES_DIRECT} \
    .TTfactor=2.0 .radmaskfact=1.08
iofits.saveFITS dmmask "!../conf/dmmask.fits"
iofits.saveFITS dmmask "!../conf/DMmask.fits"
iofits.saveFITS dmmask "!../conf/dmmap.fits"
iofits.saveFITS wfsmask "!../conf/wfsmask.fits"
iofits.saveFITS wfsmask "!../conf/wfsmap.fits"
iofits.saveFITS zpokeC "!../conf/zpokeC.fits"
exit
EOF
        _tc1="$(date +%s.%N)"
        LAST_MKHADAMARD_S="$(elapsed_s "${_tc0}" "${_tc1}")"

        fpspipe.loadfits dmmask  ../conf/dmmask  .force=1
        fpspipe.loadfits wfsmask ../conf/wfsmask .force=1
        milk-stream-wait -q -t 15 "${PFX}imWFS1+8"

        do_takeref "${nframes}"
        _tc2="$(date +%s.%N)"
        LAST_TAKEREF_S="$(elapsed_s "${_tc1}" "${_tc2}")"

        run_and_stage_mlat "${MLAT_NBITER}"
        _tc3="$(date +%s.%N)"
        LAST_MLAT_S="$(elapsed_s "${_tc2}" "${_tc3}")"

        local fps_hz="${RATE}" lat_fr="${LAT_FR}" min_hz=0.0 max_hz=0.0
        @get fps_hz="f.mlat-${N}.out.framerateHz" lat_fr="f.mlat-${N}.out.latencyfr"
        min_hz="$(awk -v r="${RATE}" 'BEGIN { printf "%.3f", r * 0.4 }')"
        max_hz="$(awk -v r="${RATE}" 'BEGIN { printf "%.3f", r * 2.5 }')"
        if ! @test "${fps_hz} >= ${min_hz} && ${fps_hz} <= ${max_hz}"; then
            fps_hz="${RATE}"
        fi
        if ! @test "${lat_fr} >= 0.5 && ${lat_fr} <= 3.5"; then
            lat_fr="${LAT_FR}"
        fi

        if (( FAST_CALIB )) && @exists "f.${HTSIM_UNIT}"; then
            milk-fps-set -q \
                "${HTSIM_UNIT}.calib_wfs=${WFS_STREAM}" \
                "${HTSIM_UNIT}.calib_trig=dm${DM}disp" \
                "${HTSIM_UNIT}.calib_fast=ON" \
                "measlinresp-${N}.timing.WFSfrequ=2000" \
                "measlinresp-${N}.timing.hardwlatfr=1.5" \
                "measlinresp-${N}.timing.NBave=1" \
                "measlinresp-${N}.timing.NBexcl=0" \
                "measlinresp-${N}.procinfo.loopcntMax=${nbloop}" \
                "measlinresp-${N}.inmodes=../conf/zpokeC.fits" \
                "measlinresp-${N}.outmodes=../conf/zrespC.fits"
            sleep 0.05
            local mlr_rc=0
            milk-fps-runstart -q "measlinresp-${N}" || mlr_rc=$?
            if (( mlr_rc == 0 )); then
                milk-fps-wait -q -t 600 "measlinresp-${N}" || mlr_rc=$?
            fi
            @set "f.${HTSIM_UNIT}.calib_fast=OFF"
            milk-fps-set -q "${HTSIM_UNIT}.calib_trig=none" "${HTSIM_UNIT}.calib_wfs=none"
            (( mlr_rc == 0 )) || return "${mlr_rc}"
        else
            milk-fps-set -q \
                "measlinresp-${N}.timing.WFSfrequ=${fps_hz}" \
                "measlinresp-${N}.timing.hardwlatfr=${lat_fr}" \
                "measlinresp-${N}.timing.NBave=2" \
                "measlinresp-${N}.timing.NBexcl=2" \
                "measlinresp-${N}.procinfo.loopcntMax=${nbloop}" \
                "measlinresp-${N}.inmodes=../conf/zpokeC.fits" \
                "measlinresp-${N}.outmodes=../conf/zrespC.fits"
            milk-fps-runstart -q "measlinresp-${N}"
            milk-fps-wait -q -t 600 "measlinresp-${N}"
        fi
        @calc "s.${PFX}dmRM = s.${PFX}dmRM * 0.0"
        _tc4="$(date +%s.%N)"
        LAST_MEASLINRESP_S="$(elapsed_s "${_tc3}" "${_tc4}")"
        LAST_HADDEC_S="0.0"

        write_rm_meta "${fps_hz}" "${lat_fr}" "${svdlim}"
        build_and_load_cm "${svdlim}" "${lat_fr}" "1.0"
        write_calib_timings

        if [[ -n "${save_rm}" ]]; then
            do_save_rm "${save_rm}"
        fi
        return 0
    fi

    local _tc0 _tc1 _tc2 _tc3 _tc4 _tc5
    _tc0="$(date +%s.%N)"
    do_takeref "${nframes}"
    _tc1="$(date +%s.%N)"
    LAST_TAKEREF_S="$(elapsed_s "${_tc0}" "${_tc1}")"

    run_and_stage_mlat "${MLAT_NBITER}"
    _tc2="$(date +%s.%N)"
    LAST_MLAT_S="$(elapsed_s "${_tc1}" "${_tc2}")"

    local fps_hz="${RATE}" lat_fr="${LAT_FR}" min_hz=0.0 max_hz=0.0
    @get fps_hz="f.mlat-${N}.out.framerateHz" lat_fr="f.mlat-${N}.out.latencyfr"
    min_hz="$(awk -v r="${RATE}" 'BEGIN { printf "%.3f", r * 0.4 }')"
    max_hz="$(awk -v r="${RATE}" 'BEGIN { printf "%.3f", r * 2.5 }')"
    if ! @test "${fps_hz} >= ${min_hz} && ${fps_hz} <= ${max_hz}"; then
        fps_hz="${RATE}"
    fi
    if ! @test "${lat_fr} >= 0.5 && ${lat_fr} <= 3.5"; then
        lat_fr="${LAT_FR}"
    fi

    cacao-cli -q >/dev/null 2>&1 <<EOF
imgen.mkdisk DMouter ${DMX} ${DMY} ${XCENT} ${YCENT} ${HAD_RAD}
imgen.mkdisk DMinner ${DMX} ${DMY} ${XCENT} ${YCENT} ${RAD_IN}
@calc "DMmask = DMouter - DMinner"
cacaocc.mkHadamard DMmask HpokeC
iofits.saveFITS DMmask "!../conf/DMmask.fits"
iofits.saveFITS HpokeC "!../conf/HpokeC.fits"
iofits.saveFITS Hpixindex "!../conf/Hpixindex.fits"
iofits.saveFITS Hmat "!../conf/Hmat.fits"
exit
EOF
    _tc3="$(date +%s.%N)"
    LAST_MKHADAMARD_S="$(elapsed_s "${_tc2}" "${_tc3}")"

    if (( FAST_CALIB )) && @exists "f.${HTSIM_UNIT}"; then
        milk-fps-set -q \
            "${HTSIM_UNIT}.calib_wfs=${WFS_STREAM}" \
            "${HTSIM_UNIT}.calib_trig=dm${DM}disp" \
            "${HTSIM_UNIT}.calib_fast=ON" \
            "measlinresp-${N}.timing.WFSfrequ=2000" \
            "measlinresp-${N}.timing.hardwlatfr=1.5" \
            "measlinresp-${N}.timing.NBave=1" \
            "measlinresp-${N}.timing.NBexcl=0" \
            "measlinresp-${N}.procinfo.loopcntMax=${nbloop}" \
            "measlinresp-${N}.inmodes=../conf/HpokeC.fits" \
            "measlinresp-${N}.outmodes=../conf/HrespC.fits"
        # Wait >1 wall tick so csim_htsim arms calib_sem before measlinresp emits frame 0
        sleep 0.05
        local mlr_rc=0
        milk-fps-runstart -q "measlinresp-${N}" || mlr_rc=$?
        if (( mlr_rc == 0 )); then
            milk-fps-wait -q -t 1800 "measlinresp-${N}" || mlr_rc=$?
        fi
        @set "f.${HTSIM_UNIT}.calib_fast=OFF"
        milk-fps-set -q "${HTSIM_UNIT}.calib_trig=none" "${HTSIM_UNIT}.calib_wfs=none"
        (( mlr_rc == 0 )) || return "${mlr_rc}"
    else
        milk-fps-set -q \
            "measlinresp-${N}.timing.WFSfrequ=${fps_hz}" \
            "measlinresp-${N}.timing.hardwlatfr=${lat_fr}" \
            "measlinresp-${N}.timing.NBave=2" \
            "measlinresp-${N}.timing.NBexcl=2" \
            "measlinresp-${N}.procinfo.loopcntMax=${nbloop}" \
            "measlinresp-${N}.inmodes=../conf/HpokeC.fits" \
            "measlinresp-${N}.outmodes=../conf/HrespC.fits"
        milk-fps-runstart -q "measlinresp-${N}"
        milk-fps-wait -q -t 1800 "measlinresp-${N}"
    fi
    @calc "s.${PFX}dmRM = s.${PFX}dmRM * 0.0"
    _tc4="$(date +%s.%N)"
    LAST_MEASLINRESP_S="$(elapsed_s "${_tc3}" "${_tc4}")"

    OMP_NUM_THREADS=32 OPENBLAS_NUM_THREADS=32 cacao-cli -q >/dev/null <<EOF
iofits.loadfits "../conf/Hpixindex.fits" pixiind .
iofits.loadfits "../conf/Hmat.fits" Hmat .
iofits.loadfits "../conf/HpokeC.fits" HpokeC .
iofits.loadfits "../conf/HrespC.fits" HrespC .
cacaocc.aolHaddec HpokeC Hmat pixiind zpokeC
cacaocc.aolHaddec HrespC Hmat pixiind zrespC
cacaocc.compmasksWFSDM zrespC ${DMX} ${DMY} 0.2 0.5 0.5 0.15 0.2 0.5 0.5 0.20
iofits.saveFITS zpokeC "!../conf/zpokeC.fits"
iofits.saveFITS zrespC "!../conf/zrespC.fits"
iofits.saveFITS dmmap "!../conf/dmmap.fits"
iofits.saveFITS wfsmap "!../conf/wfsmap.fits"
iofits.saveFITS dmmask "!../conf/dmmask.fits"
iofits.saveFITS wfsmask "!../conf/wfsmask.fits"
exit
EOF
    _tc5="$(date +%s.%N)"
    LAST_HADDEC_S="$(elapsed_s "${_tc4}" "${_tc5}")"

    local flux_pre=0.0 flux_post=0.0 norm_scale="1.0"
    milk-stream-wait -q -t 15 "${PFX}imWFS1+4"
    @get flux_pre="f.acquWFS-${N}.out.fluxtotal"

    fpspipe.loadfits dmmask  ../conf/dmmask  .force=1
    fpspipe.loadfits wfsmask ../conf/wfsmask .force=1
    milk-stream-wait -q -t 15 "${PFX}imWFS1+15"
    @get flux_post="f.acquWFS-${N}.out.fluxtotal"
    norm_scale="$(awk -v a="${flux_pre}" -v b="${flux_post}" \
        -v nx="${WFSX}" -v ny="${WFSY}" 'BEGIN {
            off = 1.0 * nx * ny
            da = a + off; db = b + off
            if (da > 0.0 && db > 0.0) printf "%.8f", da / db
            else printf "1.0"
        }')"
    do_takeref "${nframes}"

    write_rm_meta "${fps_hz}" "${lat_fr}" "${svdlim}"
    build_and_load_cm "${svdlim}" "${lat_fr}" "${norm_scale}"
    write_calib_timings

    if [[ -n "${save_rm}" ]]; then
        do_save_rm "${save_rm}"
    fi
}

cmd_mlat() {
    local nbiter="${1:-${MLAT_NBITER}}"
    enter_workdir 0
    fpspipe.commit
    run_and_stage_mlat "${nbiter}"
}

cmd_selfrm() {
    if (( $# < 1 )); then
        echo "${SCRIPT_NAME}: 'selfrm' requires <out.fits>" >&2
        return 2
    fi
    local out_fits nbmode=2000 ampl="${POKE_AMPL}" nbiter=1 nbsettle=2 timeout=1800 fast_srm=0
    out_fits="$(resolve_caller_path "$1")"
    shift
    while (( $# > 0 )); do
        case "$1" in
            --nbmode)   nbmode="$2"; shift 2 ;;
            --ampl)     ampl="$2"; shift 2 ;;
            --nbiter)   nbiter="$2"; shift 2 ;;
            --nbsettle) nbsettle="$2"; shift 2 ;;
            --timeout)  timeout="$2"; shift 2 ;;
            --fast)     fast_srm=1; shift ;;
            *) echo "${SCRIPT_NAME}: unknown selfrm option '$1'" >&2; return 2 ;;
        esac
    done

    enter_workdir 0
    fpspipe.commit

    local armed_fast=0 srm_rc=0
    if (( fast_srm )) && @exists "f.${HTSIM_UNIT}"; then
        milk-fps-set -q \
            "${HTSIM_UNIT}.calib_wfs=${WFS_STREAM}" \
            "${HTSIM_UNIT}.calib_trig=dm${DM}disp" \
            "${HTSIM_UNIT}.calib_poke_offset=0.0" \
            "${HTSIM_UNIT}.calib_temporal=ON" \
            "${HTSIM_UNIT}.calib_ring=ON" \
            "${HTSIM_UNIT}.calib_fast=ON"
        armed_fast=1
    fi

    milk-fps-set -q \
        "mfilt-${N}.selfRM.saveFITS=OFF" \
        "mfilt-${N}.selfRM.NBmode=${nbmode}" \
        "mfilt-${N}.selfRM.pokeampl=${ampl}" \
        "mfilt-${N}.selfRM.nbiter=${nbiter}" \
        "mfilt-${N}.selfRM.nbsettle=${nbsettle}" \
        "mfilt-${N}.selfRM.enable=ON"
    milk-stream-wait -q -t "${timeout}" "${PFX}mfiltselfRM+1" || srm_rc=$?

    if (( armed_fast )); then
        milk-fps-set -q \
            "${HTSIM_UNIT}.calib_fast=OFF" \
            "${HTSIM_UNIT}.calib_ring=OFF" \
            "${HTSIM_UNIT}.calib_temporal=OFF" \
            "${HTSIM_UNIT}.calib_trig=none" \
            "${HTSIM_UNIT}.calib_wfs=none"
    fi
    (( srm_rc == 0 )) || return "${srm_rc}"

    mkdir -p "$(dirname "${out_fits}")"
    fpspipe.savefits "${PFX}mfiltselfRM" "${out_fits}"
}

cmd_setmgains() {
    local alpha="${1:-${MGAIN_ALPHA}}"
    local floor="${2:-${MGAIN_FLOOR}}"
    local gtt="${3:-${MGAIN_TT}}"
    enter_workdir 0
    apply_modal_gains "${alpha}" "${floor}" "${gtt}"
}

cmd_close() {
    if [[ -n "${1:-}" ]]; then
        @set "f.mfilt-${N}.loopgain=$1"
    fi
    @set "f.mfilt-${N}.loopON=ON"
    milk-fps-runstart -q "mctrlstats-${N}" >/dev/null 2>&1 || true
}

cmd_pf_on() {
    local mix="${1:-${PF_MIX}}" pflat="${2:-}"
    if @exists "s.${PFX}mgainfact" && @exists "s.${PFX}mPFmixfact"; then
        @calc "s.${PFX}mPFmixfact = pow(s.${PFX}mgainfact, ${PF_MGAIN_EXP})"
    fi
    milk-fps-set -q \
        "mfilt-${N}.comp.OLmodes=ON" \
        "mfilt-${N}.comp.tbuff=ON" \
        "mfilt-${N}.PF.NBblock=1" \
        "mfilt-${N}.PF.maxwaitus=${PF_MAXWAITUS}" \
        "mfilt-${N}.PF.mixcoeff=${mix}" \
        "${PF_MK_UNIT}.PForder=${PF_ORDER}" \
        "${PF_MK_UNIT}.NBtrain=${PF_NBTRAIN}" \
        "${PF_MK_UNIT}.reglambda=${PF_REG}" \
        "${PF_APP_UNIT}.PForder=${PF_ORDER}"
    if [[ "${PF_MODE}" == "eof" ]]; then
        milk-fps-set -q \
            "${PF_MK_UNIT}.blocksize=${PF_BLOCKSIZE}" \
            "${PF_MK_UNIT}.diagorder=${PF_DIAGORDER}" \
            "${PF_MK_UNIT}.minsamples=${PF_MINSAMPLES}" \
            "${PF_MK_UNIT}.diagminsamples=${PF_DIAGMINSAMPLES}" \
            "${PF_MK_UNIT}.updateperiod=${PF_UPDATEPERIOD}" \
            "${PF_APP_UNIT}.blocksize=${PF_BLOCKSIZE}" \
            "${PF_APP_UNIT}.diagorder=${PF_DIAGORDER}" \
            "${PF_APP_UNIT}.nthreads=${PF_NTHREADS}"
    fi
    if [[ -n "${PF_MAXNORM2}" ]]; then
        milk-fps-set -q "${PF_MK_UNIT}.maxnorm2=${PF_MAXNORM2}"
    fi
    if [[ -n "${pflat}" ]]; then
        milk-fps-set -q "${PF_MK_UNIT}.PFlatency=${pflat}"
    fi
    if [[ "${PF_MODE}" == "eof" ]]; then
        OPENBLAS_NUM_THREADS="${PF_MKTHREADS}" OMP_NUM_THREADS="${PF_MKTHREADS}" \
            milk-fps-runstart -q "${PF_MK_UNIT}"
        milk-stream-wait -q -t 15 "${PFX}${PF_MAT_SFX}"
        OMP_NUM_THREADS="${PF_NTHREADS}" milk-fps-runstart -q "${PF_APP_UNIT}"
    else
        milk-fps-runstart -q "${PF_MK_UNIT}"
        milk-stream-wait -q -t 15 "${PFX}${PF_MAT_SFX}"
        milk-fps-runstart -q "${PF_APP_UNIT}"
    fi
    milk-stream-wait -q -t 15 "${PFX}modevalPF"
    @set "f.mfilt-${N}.PF.enable=ON"
}

cmd_pf_freeze() {
    milk-fps-runstop -q "${PF_MK_UNIT}" >/dev/null 2>&1 || true
}

cmd_pf_off() {
    @set "f.mfilt-${N}.PF.enable=OFF"
    milk-fps-runstop -q "${PF_MK_UNIT}" "${PF_APP_UNIT}" >/dev/null 2>&1 || true
}

cmd_testol() {
    local tmode="${1:-2}" tampl="${2:-0.015}" tnbspl="${3:-200}" tgain="${4:-1.0}"
    milk-fps-set -q \
        "mfilt-${N}.comp.OLmodes=ON" \
        "mfilt-${N}.testOL.mode=${tmode}" \
        "mfilt-${N}.testOL.ampl=${tampl}" \
        "mfilt-${N}.testOL.nbsample=${tnbspl}" \
        "mfilt-${N}.testOL.updategain=${tgain}" \
        "mfilt-${N}.testOL.enable=ON"
    milk-stream-wait -q -t 60 "${PFX}modevalOL+$(( tnbspl + 10 ))"
    local hlat=0.0 slat=0.0 pflat=0.0
    @get hlat="f.mfilt-${N}.comp.latencyhardwfr" slat="f.mfilt-${N}.comp.latencysoftwfr"
    pflat="$(awk -v h="${hlat}" -v s="${slat}" 'BEGIN { printf "%.3f", h + s }')"
    milk-fps-set -q "${PF_MK_UNIT}.PFlatency=${pflat}"
}

cmd_open() {
    @set "f.mfilt-${N}.PF.enable=OFF" "f.mfilt-${N}.loopON=OFF"
    milk-fps-runstop -q "${PF_MK_UNIT}" "${PF_APP_UNIT}" "mctrlstats-${N}" >/dev/null 2>&1 || true
}

cmd_zero() {
    @set "f.mfilt-${N}.PF.enable=OFF" "f.mfilt-${N}.loopON=OFF" "f.mfilt-${N}.loopZERO=ON"
    milk-fps-runstop -q "${PF_MK_UNIT}" "${PF_APP_UNIT}" "mctrlstats-${N}" >/dev/null 2>&1 || true
    if @exists "s.${PFX}dmC"; then
        @calc "s.${PFX}dmC = s.${PFX}dmC * 0.0"
    fi
    if @exists "s.${PFX}dmRM"; then
        @calc "s.${PFX}dmRM = s.${PFX}dmRM * 0.0"
    fi
}

cmd_status() {
    FPSPIPE_UNITS=("${ALL_UNITS[@]}")
    fpspipe.status
    if @exists "f.mfilt-${N}"; then
        local lon lg lm cnt=0
        @get lon="f.mfilt-${N}.loopON" lg="f.mfilt-${N}.loopgain" lm="f.mfilt-${N}.loopmult"
        if @exists "s.${PFX}imWFS2"; then
            @get cnt="s.${PFX}imWFS2.cnt0"
        fi
        printf '\nLoop %s (aol%s): loopON=%s gain=%s mult=%s imWFS2.cnt0=%s\n' \
            "${LOOPNAME}" "${N}" "${lon}" "${lg}" "${lm}" "${cnt}"
    fi
}

cmd_teardown() {
    local purge_dm=0
    while (( $# > 0 )); do
        case "$1" in
            --purge-dm) purge_dm=1 ;;
            *) echo "${SCRIPT_NAME}: unknown teardown option '$1'" >&2; return 2 ;;
        esac
        shift
    done

    FPSPIPE_NAME="${LOOPNAME}"
    FPSPIPE_ROOTDIR="${ROOTDIR}"
    FPSPIPE_RUNDIR="${ROOTDIR}/${LOOPNAME}-rundir"
    CACAO_LOOPNUMBER="${N}"
    FPSPIPE_UNITS=("${ALL_UNITS[@]}")
    if (( ! OWNS_DM )); then
        if @exists "s.${PFX}dmC"; then
            @calc "s.${PFX}dmC = s.${PFX}dmC * 0.0" || true
        fi
        if @exists "s.${PFX}dmRM"; then
            @calc "s.${PFX}dmRM = s.${PFX}dmRM * 0.0" || true
        fi
        cacaoloop.teardown
    elif (( purge_dm )); then
        cacaoloop.teardown .purge_dm="${DM}"
        milk-stream-rm -q --ignore-missing "dm${DM}trig" || true
    else
        cacaoloop.teardown
        milk-stream-rm -r -f -q --ignore-missing "^dm${DM}(disp[0-9]|trig$)" || true
    fi
}

subcmd="${1:-}"
shift || true
case "${subcmd}" in
    deploy)    cmd_deploy "$@" ;;
    calibrate) cmd_calibrate "$@" ;;
    save-rm)   cmd_save_rm "$@" ;;
    load-rm)   cmd_load_rm "$@" ;;
    takeref)   cmd_takeref "$@" ;;
    mlat)      cmd_mlat "$@" ;;
    selfrm)    cmd_selfrm "$@" ;;
    setmgains) cmd_setmgains "$@" ;;
    close)     cmd_close "$@" ;;
    pf-on)     cmd_pf_on "$@" ;;
    pf-freeze) cmd_pf_freeze "$@" ;;
    pf-off)    cmd_pf_off "$@" ;;
    testol)    cmd_testol "$@" ;;
    open)      cmd_open "$@" ;;
    zero)      cmd_zero "$@" ;;
    status)    cmd_status "$@" ;;
    teardown)  cmd_teardown "$@" ;;
    *) echo "${SCRIPT_NAME}: unknown subcommand '${subcmd}'" >&2; usage >&2; exit 2 ;;
esac
