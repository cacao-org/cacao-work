#!/usr/bin/env -S milk-script -q
# SPDX-FileCopyrightText: 2026 Olivier Guyon et al
# SPDX-License-Identifier: LGPL-3.0-or-later
#
# Native milk-script orchestrator for Subaru 7.95m AO3k + SCExAO + Lyot Coro + LLOWFS simulation:
#   - Stage 1 (AO3k)  : 64x64 DM (D=60 act) + 160x160 J-band (1.22 um) PyWFS @ 1.0 kHz
#   - Stage 2 (SCExAO): 50x50 DM (D=46 act) + 120x120 Vis I-band (0.75 um) PyWFS @ 2.0 kHz + ZPO
#   - Stage 3 (LLOWFS): 50x50 DM ZPO + H-band 3.0 l/D Lyot Coro + 64x64 Lyot-Refl LLOWFS @ 0.5 kHz
#   - Produces BOTH optical REPORT.md (cacaosim-ao-report) and COMPUTE_REPORT.md (milk-perf-report)

set -euo pipefail

SEEING="0.8"
STAR_MAG=""
PHYS_TIME="10.0"
WALL_RATE=""
USER_WALL_RATE_SET="0"
CALIB_RATE=""
FAST_CALIB="1"
BENCH_MODE="fused"
OVERSAMPLE="0"
CLOCK_SKEW_US=""
WFS1_MOD_RAD=""
WFS2_MOD_RAD=""
WFS1_RATE="1000"
MR_DM1="0"
MR_SUBSTEPS=""
MR_VEL_GAIN="1.0"
MR_VEL_REG_MULT="3.5"
ENABLE_STAGE2="1"
WFS_DARK_ADU=""
WFSTAT_VALIDATE="0"
GAIN1="0.35"
GAIN2="0.35"
GAIN3="0.20"
MULT1="0.98"
MULT2="0.98"
MULT3="0.99"
MULT_TT=""
MMULT_FLOOR=""
MMULT_ALPHA="1.0"
DMMASK_RMAX=""
DMMASK_RMIN=""
DMMASK_COBS_SLAVE="1"
WFSMASK_DILATE="2"
WFSMASK_DILATE2="2"
MGAIN_ALPHA="0.8"
MGAIN_FLOOR="0.10"
MGAIN_TT="1.0"
SVDLIM1="0.004"
SVDLIM2="0.004"
SVDLIM3="0.02"
ENABLE_LOWFS="1"
PSOL_OG1=""
ZPO_OG=""
PREDICTIVE="0"
PF_MODE="ar"
PF_BLOCKSIZE="128"
PF_MIX="0.90"
PF_MIX2="0.90"
PF_MIX_TT=""
PF_LO_NMODE="2"
PF_ORDER="8"
PF_REG="0.005"
PF_REG2=""
PF_MAXNORM2=""
PF_DIFF_NMODE="0"
PF_DIFF_ORDER="0"
PF_DIFF_REG="0.05"
PF_DIFF_MAXNORM2="4.0"
PF_DIFF_MAXDCGAIN="0.9995"
PF_NBTRAIN1=""
PF_NBTRAIN2=""
PF_MINSAMPLES1=""
PF_MINSAMPLES2=""
PF_WARMUP_SEC="0"
PF_MGAIN_EXP="0.50"
PF_MGAIN_EXP2=""
NBLOOP="1"
RUN_SELFRM="1"
SELFRM_MODES="256"
SELFRM_ONSKY_ITER="1"
OUT_DIR="${CACAO_WORK_ROOT:-.}/_work/ao3k_scexao"
SAVE_RM_DIR="${CACAO_WORK_ROOT:-.}/_work/ao3k_scexao_rm"
LOAD_RM_DIR=""
SAVE_TELEMETRY="none"
TELEM_DIR=""
KEEP_TELEMETRY="0"
PSF_NAVG=""
RUN_TLM_ANALYSIS="1"
CALIB_2WFS1DM="0"
SYSID_MODES="40"
SYSID_WHITEN_ORDER="4"
SKIP_MICROBENCH="0"
COMPARE_JSON=""
DM1_PRESHAPER=""
DYNPSOL1=""
DYNPSOL2=""
ONLINE_OG1="0"
OG1_AMPL="0.008"
OG1_NBMODE="128"
OG1_STRIDE="4"
OG1_HOLD="3"
OG1_APPLY="1"
LIVE_2WFS1DM_SEC="0"
WINDLAYERS1="0"
PF_ZOH_RIDGE=""
PF_ZOH_RIDGE2=""
PF_GRAM_HALFLIFE="0"
PF_REGIME_KMAX="0"
PF_FX1=""
PF_FX2=""
PF_DMMODES1=""
PF_N_PRIOR="1024"
PF_WL_SWITCH_DECAY="0.20"
WIND_SWITCH_SEC="0"
WIND_SWITCH_DEG="60.0"
WIND_VAR="1"
WIND_VAR_SCALE="1.0"
WIND_BURST="1"
WIND_BURST_SCALE="1.0"
VIB_ENABLE="1"
VIB_RMS_NM="45.0"
PETAL_ENABLE="1"
PETAL_RMS_NM="1000.0"
PETAL_TAU_S="3.0"
RUN_MODALWHITE="0"
SELFLEARN="0"
SELFLEARN_MODES="128"
SELFLEARN_KMAX="16"
PYRWFS_TLM="1"
PYRWFS_STRIDE=""
PETAL_CTRL="0"
PETAL_USE_SIGN="auto"
PETAL_ALPHA="0.0018"
PETAL_WARMUP="900"
PETAL_TH_EVEN="0.62"
PETAL_TH_SIGN="0.65"
PETAL_FAST_ALPHA="0.0"
PETAL_FAST_WARMUP="250"
PETAL_FAST_TH_EVEN="0.85"
PETAL_FAST_TH_SIGN="0.75"
PETAL_FAST_TH_CON="1.15"
PETAL_FAST_DWELL="20"
PETAL_ABORT_WIN="250"
PETAL_VERIFY_WIN="500"
PETAL_ENABLE_AT="warmup"
PETAL_TEST_INJECT=""
ZENITH_DEG="30.0"
DISP_PA_DEG="0.0"
IMR_MODE="pupil_track"
PARALLACTIC_RATE_DPS="0.0"
ADC_MODE="lut"
ADC_PRESET="ao188"
ADC_OPT_BAND="whole"
ADC_ANGLES=""
ADC_LUT_ERR=""
ADC_MECH="ideal"
CHROM_TURB="1"
CHROM_LAMBDAS="0.75,1.22,1.65"
ATMTURB_FRESNEL="0"
VIS_TTM_MODE="closed"
VIS_TTM_GAIN="0.03"

usage() {
    cat <<EOF
Usage: $(basename "$0") [options]

Options:
  --seeing <arcsec>   Seeing FWHM at 0.50 um (default: ${SEEING})
  --star-mag <mag>    Override guide/science star Vega mag mV=mH (default: bench = 6.0)
  --phys-time <sec>   Physical closed-loop integration time [s] (default: ${PHYS_TIME})
  --wall-rate <hz>    Optional wall-clock rate cap [Hz] (def: lockstep fused, 160 modular)
  --calib-rate <hz>   Override wall-clock rate for mlat/takeref (default: matches --wall-rate)
  --no-fast-calib     Disable fused lockstep step-and-shoot RM; use real-time paced RM
  --bench-mode <mode> cacaosim optical bench mode: fused or modular (default: ${BENCH_MODE})
  --oversample <int>  Temporal oversampling factor K (default: bench config = 4)
  --clock-skew-us <f> Stage-2 WFS clock trigger offset [us] relative to Stage 1
  --wfs1-mod-rad <f>  Override Stage-1 NIR PyWFS modulation radius [l/D] (0=unmodulated)
  --wfs2-mod-rad <f>  Override Stage-2 Vis PyWFS modulation radius [l/D] (0=unmodulated)
  --wfs1-rate <hz>    Stage-1 NIR PyWFS frame rate [Hz], integer divisor of 2000 (def: ${WFS1_RATE})
  --mr-dm1            Enable Stage-1 multi-rate 1 kHz DM command pacing (mvalpacer-1)
  --mr-substeps <k>   Override Stage-1 DM sub-steps K_sub per WFS1 frame (def: 1000/wfs1-rate)
  --mr-vel-gain <f>   Stage-1 multi-rate velocity ramp gain multiplier (def: ${MR_VEL_GAIN})
  --mr-vel-reg-mult <f> Stage-1 multi-rate velocity ridge multiplier (def: ${MR_VEL_REG_MULT})
  --no-stage2         Keep Stage-2 SCExAO loop open (isolate Stage-1 AO3k on final/coro cams)
  --wfs-dark-adu <f>  Override WFS camera dark/bias pedestal [ADU] subtracted in acquWFS
  --wfstat-validate   Fused mode: also export beams and run CPU csim_wfstat into
                      <outdir>/wfstat_cpu to cross-check the in-DAG GPU statistics
  --gain1 <float>     Stage-1 AO3k integrator gain (default: ${GAIN1})
  --gain2 <float>     Stage-2 SCExAO integrator gain (default: ${GAIN2})
  --gain3 <float>     Stage-3 LLOWFS integrator gain (default: ${GAIN3})
  --mult1 <float>     Stage-1 leak multiplier (default: ${MULT1})
  --mult2 <float>     Stage-2 leak multiplier (default: ${MULT2})
  --mult3 <float>     Stage-3 LLOWFS leak multiplier (default: ${MULT3})
  --mgain-alpha <f>   Modal gain power-law rolloff exponent (default: ${MGAIN_ALPHA})
  --mgain-floor <f>   Modal gain floor factor for highest mode (default: ${MGAIN_FLOOR})
  --mgain-tt <f>      Modal gain factor for Tip/Tilt modes 0,1 (default: ${MGAIN_TT})
  --svdlim1 <float>   Stage-1 SVD truncation threshold (default: ${SVDLIM1})
  --svdlim2 <float>   Stage-2 SVD truncation threshold (default: ${SVDLIM2})
  --svdlim3 <float>   Stage-3 LLOWFS SVD truncation threshold (default: ${SVDLIM3})
  --no-lowfs          Keep Stage-3 LLOWFS loop open during science integration
  --psol-og1 <float>  Stage-1 on-sky optical-gain scale for PSOL WFSfact (def: testOL)
  --zpo-og <float>    Stage-2 optical-gain scale for ZPO & PSOL (default: unset = 1.0)
  --predictive        Enable PSOL predictive control on Stage 1 (AO3k) & Stage 2 (SCExAO)
  --pf-mode <ar|eof>  Predictive filter type: ar (diag) or eof (block cross-mode, def: ${PF_MODE})
  --pf-blocksize <n>  Cross-mode EOF coupled block size B (default: ${PF_BLOCKSIZE})
  --pf-mix <float>    Predictive control mixing coefficient (default: ${PF_MIX})
  --pf-mix1 <float>   Stage-1 AO3k predictive mixing coefficient (default: --pf-mix)
  --pf-mix2 <float>   Stage-2 SCExAO predictive mixing coefficient (default: --pf-mix)
  --pf-order <int>    Predictive filter lookback tap order (default: ${PF_ORDER})
  --pf-reg <float>    Stage-1/default Tikhonov regularization lambda (default: ${PF_REG})
  --pf-reg2 <float>   Optional Stage-2 Tikhonov regularization lambda (default: --pf-reg)
  --pf-maxnorm2 <f>   Optional row ||F_m||_2^2 noise-gain cap override
  --pf-nbtrain1 <n>   Optional Stage-1 training window [frames]
  --pf-nbtrain2 <n>   Optional Stage-2 training window [frames]
  --pf-minsamples1 <n> Optional Stage-1 min samples before EOF/AR activates
  --pf-minsamples2 <n> Optional Stage-2 min samples before EOF/AR activates
  --pf-warmup-sec <s> Extra closed-loop warmup [s] before science integration (def: ${PF_WARMUP_SEC})
  --pf-mgain-exp <f>  Stage-1/default modal PF mix rolloff exponent on mgainfact (def: ${PF_MGAIN_EXP})
  --pf-mgain-exp2 <f> Optional Stage-2 modal PF mix rolloff exponent (default: --pf-mgain-exp)
  --nbloop <int>      Hadamard RM averaging cycles per stage (default: ${NBLOOP})
  --selfrm-modes <n>  Max modes probed in selfRM (default: ${SELFRM_MODES})
  --selfrm-iter <n>   On-sky selfRM averaging iterations (default: ${SELFRM_ONSKY_ITER})
  --no-selfrm         Skip calibration and on-sky selfRM acquisition
  --save-rm <dir>     Directory to save Stage-1 & Stage-2 RMs (default: ${SAVE_RM_DIR})
  --load-rm <dir>     Load pre-saved RMs from <dir>/stage1 and <dir>/stage2
  --outdir <dir>      Output directory (default: ${OUT_DIR})
  --save-telemetry [m] Save 10s WFS, PSF, DM, & modal cubes (none|standard|speckle|truth)
  --telemetry-dir <d> Telemetry directory (default: <outdir>/telemetry; overwritten on rerun)
  --keep-telemetry    Preserve previous telemetry dir (<dir>_<UTC>) instead of erasing it
  --psf-navg <int>    Science PSF subframe integration count (default: 20=100Hz; 1=2kHz)
  --no-tlm-analysis   Skip post-run milk-mlt-aotlm PSFR & AO optimization report
  --calib-2wfs1dm     Run post-loop 2-WFS + 1-DM telemetry calibration (Mab, Mdb, Mda_virt)
  --sysid-modes <n>   Leading Stage-2 modes for --calib-2wfs1dm (default: ${SYSID_MODES})
  --sysid-whiten-order <p> Causal AR(p) whitening order W(z) (default: ${SYSID_WHITEN_ORDER})
  --skip-microbench   Skip cacaosim-benchmark run when generating COMPUTE_REPORT.md
  --compare-modes <f> Optional modular-vs-fused comparison JSON for compute report
  --dm1-preshaper <f> Stage-1 4 kHz DM pre-shaper MIMO FIR kernel FITS
  --dynpsol1 <fits>   Stage-1 Dynamic PSOL kernel FITS (H_mimo / H_diag)
  --dynpsol2 <fits>   Stage-2 Dynamic PSOL kernel FITS (H_diag / H_mimo)
  --online-og1        Enable Stage-1 closed-loop DM-poke online OG (modalog)
  --og1-ampl <float>  Stage-1 online-OG probe RMS amplitude [um] (default: ${OG1_AMPL})
  --og1-nbmode <int>  Stage-1 online-OG maximum probed mode count (default: ${OG1_NBMODE})
  --og1-stride <int>  Stage-1 online-OG modal probe stride (default: ${OG1_STRIDE})
  --og1-hold <int>    Stage-1 online-OG probe sample-and-hold frames (default: ${OG1_HOLD})
  --og1-no-apply      Run Stage-1 modalog in shadow mode without updating mWFSfact
  --live-2wfs1dm-sec <s> Run live Stage-2 2WFS1DM calibration burst [s] before science
  --windlayers1       Enable live Stage-1 mlt-windlayers profiler & EOF physics prior
  --atmturb-fresnel <m> Atmospheric Fresnel scintillation: 0=geom, 1=split-step, 2=Rytov (def: ${ATMTURB_FRESNEL})
  --pf-zoh-ridge <v>  Stage-1 mkEOFPF ZOH-centered ridge regularization (ON|OFF)
  --pf-zoh-ridge2 <v> Stage-2 mkEOFPF ZOH-centered ridge regularization (ON|OFF)
  --mult-tt <float>   Stage-1 low-order (0..lo-1) leak multiplier override (def: --mult1)
  --mmult-floor <f>   Stage-1 highest-mode leak multiplier floor (unset = flat --mult1)
  --mmult-alpha <f>   Stage-1 per-mode leak rolloff exponent (def: ${MMULT_ALPHA})
  --dmmask-rmax <f>   Stage-1 active DM mask outer radius [act] for rim slaving (unset = auto)
  --dmmask-rmin <f>   Stage-1 active DM mask inner CO radius [act] for CO rim slaving (unset = auto)
  --no-dmmask-cobs-slave Disable harmonic central-obstruction & rim DM actuator slaving (default: ON)
  --wfsmask-dilate <r> Stage-1 PyWFS mask dilation radius [pix] (default: ${WFSMASK_DILATE}, 0 = off)
  --wfsmask-dilate2 <r> Stage-2 PyWFS mask dilation radius [pix] (default: ${WFSMASK_DILATE2}, 0 = off)
  --pf-mix-tt <float> Stage-1 low-order (0..lo-1) predictive mix override [0..1]
  --pf-lo-nmode <n>   Leading Stage-1 modes receiving --pf-mix-tt / --mult-tt (def: ${PF_LO_NMODE})
  --pf-diff-nmode <n> Stage-1 leading modes solved in difference-space EOF (0=off)
  --pf-diff-order <n> Difference-space EOF lookback order (0=diagorder, 2..64)
  --pf-diff-reg <f>   Difference-space EOF relative Tikhonov lambda (def: ${PF_DIFF_REG})
  --pf-diff-maxnorm2 <f> Difference-space ||W_m||_2^2 cap (def: ${PF_DIFF_MAXNORM2})
  --pf-diff-maxdcgain <f> Difference-space exact self-DC gain (def: ${PF_DIFF_MAXDCGAIN})
  --pf-gram-halflife <n> Extended-memory chunk-Gram exponential half-life [frames]
  --pf-regime-kmax <n> Regime-weighted Gram library max anchor count K (0=off)
  --pf-fx1 <fits>     Stage-1 Pass-2 Filtered-X EOF DM kernel FITS
  --pf-fx2 <fits>     Stage-2 Pass-2 Filtered-X EOF DM kernel FITS
  --pf-dmmodes1 <f>   Stage-1 DM modal basis cube FITS for windlayers physics Gram
  --pf-n-prior <f>    Stage-1 windlayers physics-Gram prior sample weight N_prior
  --pf-wl-switch-decay <f> Empirical Gram decay factor on wind-switch trigger
  --wind-switch-sec <s> Physical time [s] to apply live phase-continuous wind rotation
  --wind-switch-deg <d> Wind velocity rotation angle [deg] at --wind-switch-sec
  --no-wind-var       Disable smooth wind speed & direction meandering (default: ON)
  --wind-var-scale <f> Wind meandering amplitude multiplier (default: ${WIND_VAR_SCALE})
  --no-wind-burst     Disable non-stationary atmospheric wind bursts & Cn2 surges (default: ON)
  --wind-burst-scale <f> Wind burst strength multiplier (default: ${WIND_BURST_SCALE})
  --no-vib            Disable stochastic telescope & bench vibrations (default: ON)
  --vib-rms-nm <f>    Total telescope & bench vibration OPD RMS [nm] (default: ${VIB_RMS_NM})
  --no-petal          Disable thermally induced slow-varying petaling / LWE (default: ON)
  --petal-rms-nm <f>  Total thermal petaling (LWE) OPD RMS [nm] (default: ${PETAL_RMS_NM})
  --petal-tau-s <f>   Thermal petaling correlation timescale [s] (default: ${PETAL_TAU_S})
  --no-perturb        Disable all realistic perturbations (stationary pure frozen-flow)
  --modalwhite        Run closed-loop whiteness monitor (modalwhite) on Stages 1 & 2
  --selflearn         Cascade online Global + Clustered (libgric) self-learning on Block-EOF
  --selflearn-modes <n> Max controlled modes tweaked by selflearn (default: ${SELFLEARN_MODES})
  --selflearn-kmax <n>  Max libgric cluster anchors for selflearn (default: ${SELFLEARN_KMAX})
  --no-pyrwfs-tlm     Disable live Pyramid WFS telemetry monitoring (default: ON)
  --pyrwfs-stride <n> Override Stage-1 PyWFS telemetry frame decimation stride (default: auto ~200 Hz)
  --petal-ctrl        Enable Stage-1 passive petal-unwrap JIT controller (petal-1 -> dm01disp06)
  --petal-use-sign <m> Petal sign mode: auto (from chrom_sep), 1 (fused-silica), 0 (achrom trial)
  --petal-alpha <f>   Petal EMA smoothing factor per WFS1 frame (default: ${PETAL_ALPHA})
  --petal-warmup <n>  Petal averaging warmup frames before jump trigger (default: ${PETAL_WARMUP})
  --petal-th-even <f> Petal Even detection threshold in waves (default: ${PETAL_TH_EVEN})
  --petal-th-sign <f> Petal Odd chromatic sign confirmation threshold (default: ${PETAL_TH_SIGN})
  --petal-fast-alpha <f> Optional dual-timescale fast-branch EMA alpha (default: ${PETAL_FAST_ALPHA}, 0 = off)
  --petal-fast-warmup <n> Fast-branch warmup frames before jump trigger (default: ${PETAL_FAST_WARMUP})
  --petal-fast-th-even <f> Fast-branch Even detection threshold in waves (default: ${PETAL_FAST_TH_EVEN})
  --petal-fast-th-sign <f> Fast-branch Odd chromatic sign threshold (default: ${PETAL_FAST_TH_SIGN})
  --petal-fast-th-con <f> Fast-branch 3-other-petal sign contrast threshold (default: ${PETAL_FAST_TH_CON})
  --petal-fast-dwell <n> Fast-branch consecutive confirmation frames before jump (default: ${PETAL_FAST_DWELL})
  --petal-abort-win <n> Post-jump early-confirm / wrong-way abort window [frames] (default: ${PETAL_ABORT_WIN})
  --petal-verify-win <n> Post-jump rollback verification window [frames] (default: ${PETAL_VERIFY_WIN})
  --petal-enable-at <p> When to enable petal jumps: warmup (default) or science (t_phys=0)
  --petal-test-inject <s> Optional test petal step (petal:waves@t_sec) injected into LWE entrance-pupil input
  --zenith-deg <f>    Target zenith distance [deg] for atmospheric dispersion (default: ${ZENITH_DEG})
  --disp-pa-deg <f>   Parallactic / zenith dispersion PA on pupil [deg] (default: ${DISP_PA_DEG})
  --imr-mode <m>      Image rotator mode: pupil_track (default) or field_track
  --parallactic-rate-dps <f> Parallactic angle drift rate [deg/s] (default: ${PARALLACTIC_RATE_DPS})
  --adc-mode <m>      AO188 ADC mode: lut (default), retracted, manual, shm, lut_plus_shm
  --adc-preset <p>    AO188 ADC optical model: ao188 (default), ao188_nominal, snell_doublet
  --adc-opt-band <b>  AO188 ADC LUT optimization band: whole (default), H, J, z, K', K, vis
  --adc-angles <a,b>  Manual prism angles theta1,theta2 [deg] (use with --adc-mode manual)
  --adc-lut-err <s,p> LUT calibration error: scale_err,pa_err_deg (e.g. 0.15,5.0)
  --adc-mech <m>      ADC stage mechanics: ideal (default) or realistic (Egner Table 29)
  --chrom-turb        Enable 3-wl chromatic atmospheric turbulence shear (default: ON)
  --no-chrom-turb     Disable chromatic atmospheric turbulence shear (achromatic screen)
  --vis-ttm-mode <m>  SCExAO Vis PyWFS TTM mode: closed (default), ff+closed, feedforward, off
  --no-vis-ttm        Disable SCExAO Vis PyWFS differential TT mount (same as --vis-ttm-mode off)
  --vis-ttm-gain <f>  Vis PyWFS TTM closed-loop LLOWFS offload gain (default: ${VIS_TTM_GAIN})
  -h, --help          Show this help message
EOF
}

while (( $# > 0 )); do
    case "$1" in
        --seeing)          SEEING="$2"; shift 2 ;;
        --star-mag)        STAR_MAG="$2"; shift 2 ;;
        --phys-time)       PHYS_TIME="$2"; shift 2 ;;
        --wall-rate)       WALL_RATE="$2"; USER_WALL_RATE_SET="1"; shift 2 ;;
        --calib-rate)      CALIB_RATE="$2"; shift 2 ;;
        --no-fast-calib)   FAST_CALIB="0"; shift ;;
        --bench-mode)      BENCH_MODE="$2"; shift 2 ;;
        --oversample)      OVERSAMPLE="$2"; shift 2 ;;
        --clock-skew-us)   CLOCK_SKEW_US="$2"; shift 2 ;;
        --wfs1-mod-rad)    WFS1_MOD_RAD="$2"; shift 2 ;;
        --wfs2-mod-rad)    WFS2_MOD_RAD="$2"; shift 2 ;;
        --wfs1-rate)       WFS1_RATE="$2"; shift 2 ;;
        --mr-dm1)          MR_DM1="1"; shift ;;
        --mr-substeps)     MR_SUBSTEPS="$2"; shift 2 ;;
        --mr-vel-gain)     MR_VEL_GAIN="$2"; shift 2 ;;
        --mr-vel-reg-mult) MR_VEL_REG_MULT="$2"; shift 2 ;;
        --no-stage2)       ENABLE_STAGE2="0"; shift ;;
        --wfs-dark-adu)    WFS_DARK_ADU="$2"; shift 2 ;;
        --wfstat-validate) WFSTAT_VALIDATE="1"; shift ;;
        --gain1)           GAIN1="$2"; shift 2 ;;
        --gain2)           GAIN2="$2"; shift 2 ;;
        --gain3)           GAIN3="$2"; shift 2 ;;
        --mult1)           MULT1="$2"; shift 2 ;;
        --mult2)           MULT2="$2"; shift 2 ;;
        --mult3)           MULT3="$2"; shift 2 ;;
        --mgain-alpha)     MGAIN_ALPHA="$2"; shift 2 ;;
        --mgain-floor)     MGAIN_FLOOR="$2"; shift 2 ;;
        --mgain-tt)        MGAIN_TT="$2"; shift 2 ;;
        --svdlim1)         SVDLIM1="$2"; shift 2 ;;
        --svdlim2)         SVDLIM2="$2"; shift 2 ;;
        --svdlim3)         SVDLIM3="$2"; shift 2 ;;
        --no-lowfs)        ENABLE_LOWFS="0"; shift ;;
        --psol-og1)        PSOL_OG1="$2"; shift 2 ;;
        --zpo-og)          ZPO_OG="$2"; shift 2 ;;
        --predictive)      PREDICTIVE="1"; shift ;;
        --pf-mode)         PF_MODE="$2"; shift 2 ;;
        --pf-blocksize)    PF_BLOCKSIZE="$2"; shift 2 ;;
        --pf-mix)          PF_MIX="$2"; PF_MIX2="$2"; shift 2 ;;
        --pf-mix1)         PF_MIX="$2"; shift 2 ;;
        --pf-mix2)         PF_MIX2="$2"; shift 2 ;;
        --pf-order)        PF_ORDER="$2"; shift 2 ;;
        --pf-reg)          PF_REG="$2"; shift 2 ;;
        --pf-reg2)         PF_REG2="$2"; shift 2 ;;
        --pf-maxnorm2)     PF_MAXNORM2="$2"; shift 2 ;;
        --pf-nbtrain1)     PF_NBTRAIN1="$2"; shift 2 ;;
        --pf-nbtrain2)     PF_NBTRAIN2="$2"; shift 2 ;;
        --pf-minsamples1)  PF_MINSAMPLES1="$2"; shift 2 ;;
        --pf-minsamples2)  PF_MINSAMPLES2="$2"; shift 2 ;;
        --pf-warmup-sec)   PF_WARMUP_SEC="$2"; shift 2 ;;
        --pf-mgain-exp)    PF_MGAIN_EXP="$2"; shift 2 ;;
        --pf-mgain-exp2)   PF_MGAIN_EXP2="$2"; shift 2 ;;
        --nbloop)          NBLOOP="$2"; shift 2 ;;
        --selfrm-modes)    SELFRM_MODES="$2"; shift 2 ;;
        --selfrm-iter)     SELFRM_ONSKY_ITER="$2"; shift 2 ;;
        --no-selfrm)       RUN_SELFRM="0"; shift ;;
        --save-rm)         SAVE_RM_DIR="$2"; shift 2 ;;
        --load-rm)         LOAD_RM_DIR="$2"; shift 2 ;;
        --outdir)          OUT_DIR="$2"; shift 2 ;;
        --save-telemetry)
            if (( $# >= 2 )) && [[ "$2" != -* ]]; then
                SAVE_TELEMETRY="$2"; shift 2
            else
                SAVE_TELEMETRY="standard"; shift
            fi
            ;;
        --telemetry-dir)   TELEM_DIR="$2"; shift 2 ;;
        --keep-telemetry)  KEEP_TELEMETRY="1"; shift ;;
        --psf-navg)           PSF_NAVG="$2"; shift 2 ;;
        --no-tlm-analysis)    RUN_TLM_ANALYSIS="0"; shift ;;
        --calib-2wfs1dm)      CALIB_2WFS1DM="1"; shift ;;
        --sysid-modes)        SYSID_MODES="$2"; shift 2 ;;
        --sysid-whiten-order) SYSID_WHITEN_ORDER="$2"; shift 2 ;;
        --skip-microbench)    SKIP_MICROBENCH="1"; shift ;;
        --compare-modes)      COMPARE_JSON="$2"; shift 2 ;;
        --dm1-preshaper)      DM1_PRESHAPER="$2"; shift 2 ;;
        --dynpsol1)           DYNPSOL1="$2"; shift 2 ;;
        --dynpsol2)           DYNPSOL2="$2"; shift 2 ;;
        --online-og1)         ONLINE_OG1="1"; shift ;;
        --og1-ampl)           OG1_AMPL="$2"; shift 2 ;;
        --og1-nbmode)         OG1_NBMODE="$2"; shift 2 ;;
        --og1-stride)         OG1_STRIDE="$2"; shift 2 ;;
        --og1-hold)           OG1_HOLD="$2"; shift 2 ;;
        --og1-no-apply)       OG1_APPLY="0"; shift ;;
        --live-2wfs1dm-sec)   LIVE_2WFS1DM_SEC="$2"; shift 2 ;;
        --windlayers1)        WINDLAYERS1="1"; shift ;;
        --pf-zoh-ridge)       PF_ZOH_RIDGE="$2"; shift 2 ;;
        --pf-zoh-ridge2)      PF_ZOH_RIDGE2="$2"; shift 2 ;;
        --mult-tt)            MULT_TT="$2"; shift 2 ;;
        --mmult-floor)        MMULT_FLOOR="$2"; shift 2 ;;
        --mmult-alpha)        MMULT_ALPHA="$2"; shift 2 ;;
        --dmmask-rmax)        DMMASK_RMAX="$2"; shift 2 ;;
        --dmmask-rmin)        DMMASK_RMIN="$2"; shift 2 ;;
        --no-dmmask-cobs-slave) DMMASK_COBS_SLAVE="0"; shift ;;
        --wfsmask-dilate)     WFSMASK_DILATE="$2"; shift 2 ;;
        --wfsmask-dilate2)    WFSMASK_DILATE2="$2"; shift 2 ;;
        --pf-mix-tt)          PF_MIX_TT="$2"; shift 2 ;;
        --pf-lo-nmode)        PF_LO_NMODE="$2"; shift 2 ;;
        --pf-diff-nmode)      PF_DIFF_NMODE="$2"; shift 2 ;;
        --pf-diff-order)      PF_DIFF_ORDER="$2"; shift 2 ;;
        --pf-diff-reg)        PF_DIFF_REG="$2"; shift 2 ;;
        --pf-diff-maxnorm2)   PF_DIFF_MAXNORM2="$2"; shift 2 ;;
        --pf-diff-maxdcgain)  PF_DIFF_MAXDCGAIN="$2"; shift 2 ;;
        --pf-gram-halflife)   PF_GRAM_HALFLIFE="$2"; shift 2 ;;
        --pf-regime-kmax)     PF_REGIME_KMAX="$2"; shift 2 ;;
        --pf-fx1)             PF_FX1="$2"; shift 2 ;;
        --pf-fx2)             PF_FX2="$2"; shift 2 ;;
        --pf-dmmodes1)        PF_DMMODES1="$2"; shift 2 ;;
        --pf-n-prior)         PF_N_PRIOR="$2"; shift 2 ;;
        --pf-wl-switch-decay) PF_WL_SWITCH_DECAY="$2"; shift 2 ;;
        --wind-switch-sec)    WIND_SWITCH_SEC="$2"; shift 2 ;;
        --wind-switch-deg)    WIND_SWITCH_DEG="$2"; shift 2 ;;
        --no-wind-var)        WIND_VAR="0"; shift ;;
        --wind-var-scale)     WIND_VAR_SCALE="$2"; shift 2 ;;
        --no-wind-burst)      WIND_BURST="0"; shift ;;
        --wind-burst-scale)   WIND_BURST_SCALE="$2"; shift 2 ;;
        --no-vib)             VIB_ENABLE="0"; shift ;;
        --vib-rms-nm)         VIB_RMS_NM="$2"; shift 2 ;;
        --no-petal)           PETAL_ENABLE="0"; shift ;;
        --petal-rms-nm)       PETAL_RMS_NM="$2"; shift 2 ;;
        --petal-tau-s)        PETAL_TAU_S="$2"; shift 2 ;;
        --no-perturb)
            WIND_VAR="0"; WIND_BURST="0"; VIB_ENABLE="0"; PETAL_ENABLE="0"; shift ;;
        --modalwhite)         RUN_MODALWHITE="1"; shift ;;
        --selflearn)          SELFLEARN="1"; shift ;;
        --selflearn-modes)    SELFLEARN_MODES="$2"; shift 2 ;;
        --selflearn-kmax)     SELFLEARN_KMAX="$2"; shift 2 ;;
        --no-pyrwfs-tlm)      PYRWFS_TLM="0"; shift ;;
        --pyrwfs-stride)      PYRWFS_STRIDE="$2"; shift 2 ;;
        --petal-ctrl)         PETAL_CTRL="1"; shift ;;
        --petal-use-sign)     PETAL_USE_SIGN="$2"; shift 2 ;;
        --petal-alpha)        PETAL_ALPHA="$2"; shift 2 ;;
        --petal-warmup)       PETAL_WARMUP="$2"; shift 2 ;;
        --petal-th-even)      PETAL_TH_EVEN="$2"; shift 2 ;;
        --petal-th-sign)      PETAL_TH_SIGN="$2"; shift 2 ;;
        --petal-fast-alpha)   PETAL_FAST_ALPHA="$2"; shift 2 ;;
        --petal-fast-warmup)  PETAL_FAST_WARMUP="$2"; shift 2 ;;
        --petal-fast-th-even) PETAL_FAST_TH_EVEN="$2"; shift 2 ;;
        --petal-fast-th-sign) PETAL_FAST_TH_SIGN="$2"; shift 2 ;;
        --petal-fast-th-con)  PETAL_FAST_TH_CON="$2"; shift 2 ;;
        --petal-fast-dwell)   PETAL_FAST_DWELL="$2"; shift 2 ;;
        --petal-abort-win)    PETAL_ABORT_WIN="$2"; shift 2 ;;
        --petal-verify-win)   PETAL_VERIFY_WIN="$2"; shift 2 ;;
        --petal-enable-at)    PETAL_ENABLE_AT="$2"; shift 2 ;;
        --petal-test-inject)  PETAL_TEST_INJECT="$2"; shift 2 ;;
        --zenith-deg)         ZENITH_DEG="$2"; shift 2 ;;
        --disp-pa-deg)        DISP_PA_DEG="$2"; shift 2 ;;
        --imr-mode)           IMR_MODE="$2"; shift 2 ;;
        --parallactic-rate-dps) PARALLACTIC_RATE_DPS="$2"; shift 2 ;;
        --adc-mode)           ADC_MODE="$2"; shift 2 ;;
        --adc-preset)         ADC_PRESET="$2"; shift 2 ;;
        --adc-opt-band)       ADC_OPT_BAND="$2"; shift 2 ;;
        --adc-angles)         ADC_ANGLES="$2"; shift 2 ;;
        --adc-lut-err)        ADC_LUT_ERR="$2"; shift 2 ;;
        --adc-mech)           ADC_MECH="$2"; shift 2 ;;
        --chrom-turb)         CHROM_TURB="$2"; shift 2 ;;
        --no-chrom-turb)      CHROM_TURB="0"; shift ;;
        --atmturb-fresnel)    ATMTURB_FRESNEL="$2"; shift 2 ;;
        --vis-ttm-mode)       VIS_TTM_MODE="$2"; shift 2 ;;
        --no-vis-ttm)         VIS_TTM_MODE="off"; shift ;;
        --vis-ttm-gain)       VIS_TTM_GAIN="$2"; shift 2 ;;
        -h|--help)            usage; exit 0 ;;
        *) echo "[ao3k-scexao] Unknown option: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ "${BENCH_MODE}" != "fused" && "${BENCH_MODE}" != "modular" ]]; then
    echo "[ao3k-scexao] Invalid --bench-mode '${BENCH_MODE}' (expected fused or modular)" >&2
    exit 2
fi
MASTER_UNIT="csim_mkbeam"
[[ "${BENCH_MODE}" == "fused" ]] && MASTER_UNIT="csim_htsim"

case "${SAVE_TELEMETRY}" in
    none|standard|speckle|truth) ;;
    1|on|all) SAVE_TELEMETRY="standard" ;;
    0|off)    SAVE_TELEMETRY="none" ;;
    *)
        echo "[ao3k-scexao] Invalid --save-telemetry '${SAVE_TELEMETRY}'" >&2
        echo "              Expected: none, standard, speckle, or truth" >&2
        exit 2
        ;;
esac

if (( CALIB_2WFS1DM )) && [[ "${SAVE_TELEMETRY}" == "none" ]]; then
    SAVE_TELEMETRY="standard"
    echo "[ao3k-scexao] --calib-2wfs1dm enabled: promoting --save-telemetry none -> standard"
fi

# In fused mode, csim_atmturb runs in 1:1 semaphore lockstep with csim_wfs_vis (triggermode=3),
# advancing at the maximum sustainable GPU/AO rate with zero dropped turbulence frames (or capped
# at --wall-rate when explicitly specified). WALL_RATE sets calibration/testOL pacing in fused mode
# (default 1000 Hz under CUDA MPS + CUDA Graph MVM) and modular 14-daemon pacing (default 160 Hz).
if [[ -z "${WALL_RATE}" ]]; then
    WALL_RATE="160"
    if [[ "${BENCH_MODE}" == "fused" ]]; then
        WALL_RATE="1000"
    fi
fi

EFF_PSF_NAVG=20
if [[ "${SAVE_TELEMETRY}" == "speckle" || "${SAVE_TELEMETRY}" == "truth" ]]; then
    EFF_PSF_NAVG=1
fi
[[ -n "${PSF_NAVG}" ]] && EFF_PSF_NAVG="${PSF_NAVG}"
if (( EFF_PSF_NAVG < 1 )); then
    EFF_PSF_NAVG=1
fi

EXPORT_BEAMS_NEEDED=0
if [[ "${BENCH_MODE}" == "modular" ]] || (( WFSTAT_VALIDATE )) || \
   [[ "${SAVE_TELEMETRY}" == "truth" ]]; then
    EXPORT_BEAMS_NEEDED=1
fi

# CPU csim_wfstat runs in modular mode, or alongside the GPU path when validating fused mode
CPU_WFSTAT=0
if [[ "${BENCH_MODE}" == "modular" ]] || (( WFSTAT_VALIDATE )); then
    CPU_WFSTAT=1
fi

OUT_DIR="$(realpath -m "${OUT_DIR}")"
[[ -z "${TELEM_DIR}" ]]    && TELEM_DIR="${OUT_DIR}/telemetry"
TELEM_DIR="$(realpath -m "${TELEM_DIR}")"
[[ -n "${SAVE_RM_DIR}" ]]  && SAVE_RM_DIR="$(realpath -m "${SAVE_RM_DIR}")"
[[ -n "${LOAD_RM_DIR}" ]]  && LOAD_RM_DIR="$(realpath -m "${LOAD_RM_DIR}")"
[[ -n "${COMPARE_JSON}" ]] && COMPARE_JSON="$(realpath -m "${COMPARE_JSON}")"
mkdir -p "${OUT_DIR}"

if [[ "${SAVE_TELEMETRY}" != "none" ]]; then
    if [[ -d "${TELEM_DIR}" ]] && compgen -G "${TELEM_DIR}/*" >/dev/null; then
        if (( KEEP_TELEMETRY )); then
            PREV_TLM="${TELEM_DIR}_$(date -u +%Y%m%dT%H%M%SZ)"
            mv "${TELEM_DIR}" "${PREV_TLM}"
            echo "[ao3k-scexao] Preserved existing telemetry -> ${PREV_TLM}"
        else
            rm -rf "${TELEM_DIR}"
        fi
    fi
    mkdir -p "${TELEM_DIR}"
fi

if (( WFS1_RATE <= 0 || 2000 % WFS1_RATE != 0 )); then
    echo "[ao3k-scexao] Invalid --wfs1-rate '${WFS1_RATE}' (must divide 2000 Hz, e.g. 1000,500,400,250,200,125,100)" >&2
    exit 2
fi
WFS1_DECIM=$(( 2000 / WFS1_RATE ))
if [[ -z "${MR_SUBSTEPS}" ]]; then
    if (( MR_DM1 )); then
        MR_SUBSTEPS=$(( 1000 / WFS1_RATE ))
        (( MR_SUBSTEPS < 1 )) && MR_SUBSTEPS=1
    else
        MR_SUBSTEPS=1
    fi
fi
MR_TRIG_DECIM=2
if (( MR_DM1 )) && (( MR_SUBSTEPS * 2 > WFS1_DECIM )); then
    MR_TRIG_DECIM=$(( WFS1_DECIM / MR_SUBSTEPS ))
    (( MR_TRIG_DECIM < 1 )) && MR_TRIG_DECIM=1
fi
MR_DM1_HZ=$(( 2000 / MR_TRIG_DECIM ))

MASTER_TICKS="$(awk -v t="${PHYS_TIME}" 'BEGIN { printf "%d", int(t * 2000.0 + 0.5) }')"
LONG_READOUTS=$(( MASTER_TICKS / EFF_PSF_NAVG ))
(( LONG_READOUTS < 1 )) && LONG_READOUTS=1
WALL_DT="$(awk -v r="${WALL_RATE}" 'BEGIN { printf "%.7f", 1.0 / r }')"
WFS1_WALL_RATE="$(awk -v r="${WALL_RATE}" -v d="${WFS1_DECIM}" 'BEGIN { printf "%.2f", r / d }')"
WFS3_WALL_RATE="$(awk -v r="${WALL_RATE}" 'BEGIN { printf "%.2f", 0.25 * r }')"

# Calibration runs at WALL_RATE by default (lockstep .calib_fast RM in fused mode)
CAL_RATE="${WALL_RATE}"
[[ -z "${LOAD_RM_DIR}" ]] && [[ -n "${CALIB_RATE}" ]] && CAL_RATE="${CALIB_RATE}"
CAL_WFS1_RATE="$(awk -v r="${CAL_RATE}" -v d="${WFS1_DECIM}" 'BEGIN { printf "%.2f", r / d }')"
CAL_WFS3_RATE="$(awk -v r="${CAL_RATE}" 'BEGIN { printf "%.2f", 0.25 * r }')"
USE_FAST_CALIB=0
if [[ "${BENCH_MODE}" == "fused" ]] && (( FAST_CALIB )) && [[ -z "${LOAD_RM_DIR}" ]]; then
    USE_FAST_CALIB=1
fi

WORK_ROOT="${SANDBOX_WORK_DIR:-/tmp/ao3k_milk_$$}"
CSIM_DIR="${CACAOSIM_WORKDIR:-${WORK_ROOT}/csim}"
STG1_ROOT="${WORK_ROOT}/ao3k"
STG2_ROOT="${WORK_ROOT}/scexao"
STG3_ROOT="${WORK_ROOT}/llowfs"
mkdir -p "${WORK_ROOT}" "${CSIM_DIR}"

BENCH_CFG_SRC="${CACAO_WORK_ROOT}/benches/ao3k_scexao/ao3k_scexao.bench"
BENCH_CFG="${WORK_ROOT}/ao3k_scexao_run.bench"
ADC_IDEAL_MECH="1"
[[ "${ADC_MECH}" == "real" || "${ADC_MECH}" == "0" ]] && ADC_IDEAL_MECH="0"
ADC_ANG1=""
ADC_ANG2=""
if [[ -n "${ADC_ANGLES}" ]]; then
    IFS=',' read -r ADC_ANG1 ADC_ANG2 <<< "${ADC_ANGLES}"
fi
ADC_LUT_SC_ERR=""
ADC_LUT_PA_ERR=""
if [[ -n "${ADC_LUT_ERR}" ]]; then
    IFS=',' read -r ADC_LUT_SC_ERR ADC_LUT_PA_ERR <<< "${ADC_LUT_ERR}"
fi
if [[ "${ATMTURB_FRESNEL}" != "0" && "${ATMTURB_FRESNEL}" != "1" && "${ATMTURB_FRESNEL}" != "2" ]]; then
    echo "[ao3k-scexao] Invalid --atmturb-fresnel '${ATMTURB_FRESNEL}' (expected 0, 1, or 2)" >&2
    exit 2
fi
if (( ATMTURB_FRESNEL > 0 )); then
    # Multi-wavelength chrom_lambdas forces geometric extrusion in milkatmturb;
    # disable chrom_turb so CUDA/CPU Fresnel/Rytov generates physical outarrayamp scintillation.
    CHROM_TURB="0"
fi
awk -v nv="${EFF_PSF_NAVG}" -v skew="${CLOCK_SKEW_US}" \
    -v m1="${WFS1_MOD_RAD}" -v m2="${WFS2_MOD_RAD}" -v smag="${STAR_MAG}" \
    -v dm1ps="${DM1_PRESHAPER}" -v r1="${WFS1_RATE}" \
    -v zdeg="${ZENITH_DEG}" -v dpa="${DISP_PA_DEG}" \
    -v imr="${IMR_MODE}" -v prate="${PARALLACTIC_RATE_DPS}" \
    -v cturb="${CHROM_TURB}" -v clams="${CHROM_LAMBDAS}" -v afres="${ATMTURB_FRESNEL}" \
    -v amode="${ADC_MODE}" -v apreset="${ADC_PRESET}" -v aband="${ADC_OPT_BAND}" \
    -v amech="${ADC_IDEAL_MECH}" -v ang1="${ADC_ANG1}" -v ang2="${ADC_ANG2}" \
    -v lsc="${ADC_LUT_SC_ERR}" -v lpa="${ADC_LUT_PA_ERR}" '
    /^\[/ { sec = $0 }
    sec == "[bench]" && afres + 0 > 0 && /^in_wf[ \t]*=/ {
        print; print "in_amp               = \"outarrayamp\""; next
    }
    sec == "[bench]" && smag != "" && /^star_mag[ \t]*=/ {
        printf "star_mag             = %s\n", smag; next
    }
    sec == "[bench]" && /^zenith_deg[ \t]*=/ {
        printf "zenith_deg           = %s\n", zdeg; next
    }
    sec == "[bench]" && /^disp_pa_deg[ \t]*=/ {
        printf "disp_pa_deg          = %s\n", dpa; next
    }
    sec == "[bench]" && /^imr_mode[ \t]*=/ {
        printf "imr_mode             = \"%s\"\n", imr; next
    }
    sec == "[bench]" && /^parallactic_rate_dps[ \t]*=/ {
        printf "parallactic_rate_dps = %s\n", prate; next
    }
    sec == "[bench]" && /^chrom_turb[ \t]*=/ {
        printf "chrom_turb           = %s\n", cturb; next
    }
    sec == "[bench]" && /^chrom_lambdas[ \t]*=/ {
        printf "chrom_lambdas        = \"%s\"\n", clams; next
    }
    sec == "[adc.ao188]" && /^preset[ \t]*=/ {
        printf "preset        = \"%s\"\n", apreset; next
    }
    sec == "[adc.ao188]" && /^mode[ \t]*=/ {
        printf "mode          = \"%s\"\n", amode; next
    }
    sec == "[adc.ao188]" && /^opt_band[ \t]*=/ {
        printf "opt_band      = \"%s\"\n", aband; next
    }
    sec == "[adc.ao188]" && /^ideal_mech[ \t]*=/ {
        printf "ideal_mech    = %s\n", amech
        if (ang1 != "") printf "angle1_deg    = %s\n", ang1
        if (ang2 != "") printf "angle2_deg    = %s\n", ang2
        if (lsc != "")  printf "lut_scale_err = %s\n", lsc
        if (lpa != "")  printf "lut_pa_err_deg = %s\n", lpa
        next
    }
    sec == "[dm.ao3k]" && dm1ps != "" && /^in_cmd[ \t]*=/ {
        print "in_cmd       = \"dm01shaped\""; next
    }
    sec == "[pyrwfs.wfs_vis]" && /^\[pyrwfs\.wfs_vis\]/ && skew != "" {
        print; printf "clock_offset_us = %s\n", skew; next
    }
    sec == "[pyrwfs.wfs_nir]" && (r1 + 0) != 1000 && /^rate_hz[ \t]*=/ {
        printf "rate_hz       = %s.0\n", r1; next
    }
    sec == "[pyrwfs.wfs_nir]" && m1 != "" && /^mod_rad[ \t]*=/ {
        printf "mod_rad       = %s\n", m1; next
    }
    sec == "[pyrwfs.wfs_nir]" && m1 != "" && (m1 + 0) <= 0 && /^mod_npts[ \t]*=/ {
        print "mod_npts      = 1"; next
    }
    sec == "[pyrwfs.wfs_vis]" && m2 != "" && /^mod_rad[ \t]*=/ {
        printf "mod_rad       = %s\n", m2; next
    }
    sec == "[pyrwfs.wfs_vis]" && m2 != "" && (m2 + 0) <= 0 && /^mod_npts[ \t]*=/ {
        print "mod_npts      = 1"; next
    }
    (sec == "[fpcam.vis_stg1]" || sec == "[fpcam.nir_stg1]" ||
     sec == "[fpcam.vis_final]" || sec == "[fpcam.nir_final]" ||
     sec == "[fpcam.nir_coro]") &&
    nv != 20 && /^(navg|rate_hz)[ \t]*=/ {
        printf "rate_hz       = %.4f\n", 2000.0 / nv; next
    }
    { print }
' "${BENCH_CFG_SRC}" > "${BENCH_CFG}"
ACTIVE_BENCH="${BENCH_CFG}"
LOOP_CTRL="${CACAO_WORK_ROOT}/benches/ao3k_scexao/cacaoloop-ao3k-scexao.milk"
WFSTAT_LINK="/tmp/.wfstat_$$"
WFSTAT_CPU_LINK="/tmp/.wfstat_cpu_$$"
TLM_LINK="/tmp/.tlm_$$"
PYRTLM_LINK="/tmp/.pyrtlm_$$"
WL1_LINK="/tmp/.wl1_$$"
PYRWFS_TLM_ACTIVE="0"
PETAL_CALC_LINK="/tmp/.petal_$$.calc"
PETAL_CTRL_ACTIVE="0"
PETAL_USE_SIGN_EFF="1"
VISTT_CALC_LINK="/tmp/.vistt_$$.calc"
VIS_TTM_ACTIVE="0"
declare -a TLM_UNITS=()
declare -a TLM_SAVED_STREAMS=()

cleanup_tlm_loggers() {
    if (( ${#TLM_UNITS[@]} > 0 )); then
        local u
        local -a off_args=()
        for u in "${TLM_UNITS[@]}"; do
            off_args+=("${u}.saveON=OFF")
        done
        milk-fps-set -q "${off_args[@]}" >/dev/null 2>&1 || true
        sleep 1.2
        milk-fps-runstop -q "${TLM_UNITS[@]}" >/dev/null 2>&1 || true
        milk-fps-wait -q -t 120 "${TLM_UNITS[@]}" >/dev/null 2>&1 || true
        milk-fps-rm -f -q --ignore-missing "${TLM_UNITS[@]}" >/dev/null 2>&1 || true
        TLM_UNITS=()
    fi
    if [[ -n "${MILK_SHM_DIR:-}" && -d "${MILK_SHM_DIR}" ]]; then
        rm -f "${MILK_SHM_DIR}"/*_logbuff0.im.shm "${MILK_SHM_DIR}"/*_logbuff1.im.shm \
            >/dev/null 2>&1 || true
    fi
    rm -f "${TLM_LINK}" >/dev/null 2>&1 || true
}

start_tlm_loggers() {
    [[ "${SAVE_TELEMETRY}" == "none" ]] && return 0
    ln -sfn "${TELEM_DIR}" "${TLM_LINK}"
    local n_s2="${MASTER_TICKS}"
    local n_s1=$(( MASTER_TICKS / WFS1_DECIM ))
    local n_dm1="${n_s1}"
    if (( MR_DM1 )); then
        n_dm1=$(( MASTER_TICKS / MR_TRIG_DECIM ))
    fi
    local n_s3=$(( MASTER_TICKS / 4 ))
    local n_pd=$(( MASTER_TICKS / 20 ))
    local n_ps=$(( MASTER_TICKS / EFF_PSF_NAVG ))
    (( n_s1 < 1 )) && n_s1=1
    (( n_dm1 < 1 )) && n_dm1=1
    (( n_s3 < 1 )) && n_s3=1
    (( n_pd < 1 )) && n_pd=1
    (( n_ps < 1 )) && n_ps=1

    local -a specs=(
        "csim_wfs_nir:${n_s1}:-1"
        "csim_wfs_vis:${n_s2}:-1"
        "csim_wfs_lowfs:${n_s3}:-1"
        "psf_vis_raw:${n_pd}:-1"
        "psf_nir_raw:${n_pd}:-1"
        "psf_vis_stg1:${n_ps}:-1"
        "psf_nir_stg1:${n_ps}:-1"
        "psf_vis_final:${n_ps}:-1"
        "psf_nir_final:${n_ps}:-1"
        "psf_nir_coro:${n_ps}:-1"
        "coro_pre_lyot:${n_s3}:-1"
        "aol1_dmC:${n_dm1}:-1"
        "dm01disp:${n_dm1}:-1"
        "aol2_dmC:${n_s2}:-1"
        "aol3_dmC:${n_s3}:-1"
        "dm02disp:${n_s2}:-1"
        "aol1_modevalWFS:${n_s1}:-1"
        "aol1_modevalDM:${n_dm1}:-1"
        "aol1_modevalOL:${n_s1}:-1"
        "aol2_modevalWFS:${n_s2}:-1"
        "aol2_modevalDM:${n_s2}:-1"
        "aol2_modevalOL:${n_s2}:-1"
        "aol3_modevalWFS:${n_s3}:-1"
        "aol3_modevalDM:${n_s3}:-1"
        "aol3_modevalOL:${n_s3}:-1"
    )
    if [[ -n "${DM1_PRESHAPER}" ]]; then
        specs+=("dm01shaped:${n_s2}:-1")
    fi
    if (( PREDICTIVE )); then
        specs+=(
            "aol1_modevalPF:${n_s1}:-1"
            "aol2_modevalPF:${n_s2}:-1"
        )
        if (( MR_DM1 )); then
            specs+=(
                "aol1_modevalPF_vel:${n_s1}:-1"
                "aol1_modevalDM_traj:${n_s1}:-1"
            )
        fi
    fi
    if (( PETAL_CTRL_ACTIVE )); then
        specs+=(
            "aol1_petal_raw:${n_s1}:-1"
            "aol1_petal_ema:${n_s1}:-1"
            "aol1_petal_cmd:${n_s1}:-1"
        )
    fi
    if [[ "${SAVE_TELEMETRY}" == "truth" ]]; then
        specs+=(
            "b_pup:${n_s2}:0"
            "b_post_stg1:${n_s2}:0"
            "b_post_stg2:${n_s2}:0"
        )
    fi

    TLM_UNITS=()
    TLM_SAVED_STREAMS=()
    local idx=0 entry sname exp_n zsl u csz mfc
    for entry in "${specs[@]}"; do
        IFS=':' read -r sname exp_n zsl <<< "${entry}"
        if ! @exists "s.${sname}"; then
            continue
        fi
        printf -v u "tlog_%02d" "${idx}"
        idx=$(( idx + 1 ))
        csz=$(( exp_n + 64 ))
        (( csz > 2500 )) && csz=2500
        (( csz < 32 )) && csz=32
        mfc=$(( (exp_n + csz - 1) / csz + 8 ))
        milk-fps-rm -f -q --ignore-missing "${u}" >/dev/null 2>&1 || true
        milk-fps-init -q "${u}" milk-fpsexec-mem-streamFITSlog >/dev/null
        milk-fps-set -q \
            "${u}.sname=${sname}" \
            "${u}.dirname=${TLM_LINK}" \
            "${u}.cubesize=${csz}" \
            "${u}.maxframecnt=${exp_n}" \
            "${u}.maxfilecnt=${mfc}" \
            "${u}.zslice=${zsl}" \
            "${u}.saveON=ON" \
            "${u}.procinfo.loopcntMax=-1" \
            "${u}.procinfo.triggermode=3" \
            "${u}.procinfo.triggersname=${sname}" \
            "${u}.procinfo.triggertimeout=0.5"
        TLM_UNITS+=("${u}")
        TLM_SAVED_STREAMS+=("${sname}")
    done
    if (( ${#TLM_UNITS[@]} > 0 )); then
        milk-fps-runstart -q "${TLM_UNITS[@]}"
        sleep 0.15
        echo "[ao3k-scexao]      Armed ${#TLM_UNITS[@]} SHM stream loggers -> ${TELEM_DIR}"
    fi
}

cleanup_sim() {
    sysmon.stop >/dev/null 2>&1 || true
    cleanup_tlm_loggers
    milk-fps-runstop -q petal-1 vis_tt-2 mvalpacer-1 dmpreshaper-01 modalog-1 wl-1 csim_wfstat \
        pyrwfstlm-1 pyrwfstlm-2 >/dev/null 2>&1 || true
    milk-fps-rm -f -q --ignore-missing petal-1 vis_tt-2 mvalpacer-1 dmpreshaper-01 modalog-1 wl-1 csim_wfstat \
        pyrwfstlm-1 pyrwfstlm-2 >/dev/null 2>&1 || true
    CACAO_LOOPROOTDIR="${STG3_ROOT}" "${LOOP_CTRL}" --stage 3 teardown \
        >/dev/null 2>&1 || true
    CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 teardown --purge-dm \
        >/dev/null 2>&1 || true
    CACAO_LOOPROOTDIR="${STG1_ROOT}" "${LOOP_CTRL}" --stage 1 teardown --purge-dm \
        >/dev/null 2>&1 || true
    cacaosim.teardown "${CSIM_DIR}" >/dev/null 2>&1 || true
    milk-stream-rm -q --ignore-missing b_pup b_adc b_post_stg1 b_post_stg2 dm01shaped \
        ao188_adc_cmd ao188_adc_state dm_vis_pyrwfs_tt \
        aol2_visttM aol2_vistt_bx aol2_vistt_by aol2_vistt_err \
        aol1_petalM aol1_petalDM aol1_petal_raw aol1_petal_ema aol1_petal_cmd aol1_petal_eye \
        aol1_modevalPF_eof aol1_outPFstat_eof aol1_selflearn_tweak \
        aol2_modevalPF_eof aol2_outPFstat_eof aol2_selflearn_tweak \
        wl1_layers wl1_vmapk wl1_vmapi wl1_vmapx wl1_pupgeom outarrayamp \
        aol1_pyr_ref aol1_pyr_tlm aol1_pyr_pupgeom aol1_pyr_pupdof \
        aol1_pyr_isum aol1_pyr_isum_avg aol1_pyr_sx aol1_pyr_sy \
        aol1_pyr_scint aol1_pyr_scint_debias aol1_pyr_lvar aol1_pyr_zones \
        aol2_pyr_ref aol2_pyr_tlm aol2_pyr_pupgeom aol2_pyr_pupdof \
        aol2_pyr_isum aol2_pyr_isum_avg aol2_pyr_sx aol2_pyr_sy \
        aol2_pyr_scint aol2_pyr_scint_debias aol2_pyr_lvar aol2_pyr_zones >/dev/null 2>&1 || true
    rm -rf "${WFSTAT_LINK}" "${WFSTAT_CPU_LINK}" "${TLM_LINK}" "${PYRTLM_LINK}" "${WL1_LINK}" \
        "${PETAL_CALC_LINK}" "${VISTT_CALC_LINK}" "/tmp/.p15_ps_${$}.fits" "/tmp/.p15_ogk_${$}.fits" >/dev/null 2>&1 || true
}
@defer --exit cleanup_sim

echo "================================================================================"
echo " Subaru 7.95m AO3k + SCExAO + Lyot Coronagraph + LLOWFS Simulation (milk-script)"
echo "   Sandbox SHM : ${MILK_SHM_DIR:-/milk/shm}"
echo "   Bench Mode  : ${BENCH_MODE} (${MASTER_UNIT}) | Pupil: Subaru Nasmyth-IR | Tput: 20%"
STAR_MAG_EFF="${STAR_MAG:-6.0}"
echo "   Seeing      : ${SEEING}\" @ 0.50 um | Star: mV = ${STAR_MAG_EFF}," \
     "mH = ${STAR_MAG_EFF} (Teff = 9600 K)"
echo "   Loop Speeds : Stg1 (AO3k) = ${WFS1_RATE} Hz (DM1=${MR_DM1:+${MR_DM1_HZ}Hz K=${MR_SUBSTEPS}, }${DM1_PRESHAPER:+2kHz preshaper}) | Stg2 (SCExAO) = 2.0 kHz (${ENABLE_STAGE2}) | Stg3 (LLOWFS) = 0.5 kHz"
if [[ -n "${WFS1_MOD_RAD}" || -n "${WFS2_MOD_RAD}" ]]; then
    echo "   PyWFS Mod.  : Stg1 = ${WFS1_MOD_RAD:-3.0} l/D | Stg2 = ${WFS2_MOD_RAD:-3.0} l/D"
fi
echo "   Integration : ${PHYS_TIME} s physical (${MASTER_TICKS} ticks, ${LONG_READOUTS} exposures)"
if [[ "${BENCH_MODE}" == "fused" ]] && (( ! USER_WALL_RATE_SET )); then
    echo "   Wall Pacing : 1:1 lockstep (unthrottled; calib/testOL @ ${CAL_RATE} Hz)"
else
    echo "   Wall Pacing : 1:1 lockstep <= ${WALL_RATE} Hz (${WFS1_WALL_RATE} Stg1," \
         "${WALL_RATE} Stg2, ${WFS3_WALL_RATE} Stg3)"
fi
if (( USE_FAST_CALIB )); then
    echo "   Calib Pacing: ${CAL_RATE} Hz mlat/ref + unthrottled lockstep .calib_fast RM"
else
    echo "   Calib Pacing: ${CAL_RATE} Hz master (RM acquisition / load)"
fi
PF_REG2="${PF_REG2:-${PF_REG}}"
PF_MGAIN_EXP2="${PF_MGAIN_EXP2:-${PF_MGAIN_EXP}}"
export CACAO_PF_MODE="${PF_MODE}"
STG1_TBUFF_SIZE=256
STG1_PF_UPD=4
STG1_PF_DIAGMIN=256
if (( WFS1_RATE <= 250 )); then
    STG1_TBUFF_SIZE=64
    STG1_PF_UPD=2
    STG1_PF_DIAGMIN=128
elif (( WFS1_RATE <= 500 )); then
    STG1_TBUFF_SIZE=128
    STG1_PF_UPD=4
    STG1_PF_DIAGMIN=192
fi
if [[ "${PF_MODE}" == "eof" ]]; then
    PF_MK_PFX="mkEOFPF"
    PF_APP_PFX="applyEOFPF"
    PF_MAT_SFX="eofPFmat"
    DEF_NBT1=$(( 16384 * WFS1_RATE / 1000 ))
    DEF_MIN1=$(( 12000 * WFS1_RATE / 1000 ))
    (( DEF_NBT1 < 1024 )) && DEF_NBT1=1024
    (( DEF_MIN1 < 512 )) && DEF_MIN1=512
    PF_NBTRAIN1="${PF_NBTRAIN1:-${CACAO_PF_NBTRAIN:-${DEF_NBT1}}}"
    PF_NBTRAIN2="${PF_NBTRAIN2:-${CACAO_PF_NBTRAIN:-32768}}"
    PF_MINSAMPLES1="${PF_MINSAMPLES1:-${CACAO_PF_MINSAMPLES:-${DEF_MIN1}}}"
    PF_MINSAMPLES2="${PF_MINSAMPLES2:-${CACAO_PF_MINSAMPLES:-24000}}"
else
    PF_MK_PFX="mkARPF"
    PF_APP_PFX="applyARPF"
    PF_MAT_SFX="arPFmat"
    PF_NBTRAIN1="${PF_NBTRAIN1:-${CACAO_PF_NBTRAIN:-2048}}"
    PF_NBTRAIN2="${PF_NBTRAIN2:-${CACAO_PF_NBTRAIN:-2048}}"
    PF_MINSAMPLES1="${PF_MINSAMPLES1:-${CACAO_PF_MINSAMPLES:-256}}"
    PF_MINSAMPLES2="${PF_MINSAMPLES2:-${CACAO_PF_MINSAMPLES:-256}}"
fi

if (( PREDICTIVE )); then
    if [[ "${PF_MODE}" == "eof" ]]; then
        echo "   Control Law : PSOL Cross-Mode Block-EOF(B=${PF_BLOCKSIZE}, P=${PF_ORDER})" \
             "(mix=${PF_MIX}, reg1=${PF_REG}, reg2=${PF_REG2}, warmup=${PF_WARMUP_SEC}s)"
    else
        echo "   Control Law : PSOL AR(${PF_ORDER}) Predictive Control" \
             "(mix=${PF_MIX}, reg=${PF_REG}, mgain_exp=${PF_MGAIN_EXP}, warmup=${PF_WARMUP_SEC}s)"
    fi
fi
if (( CALIB_2WFS1DM )); then
    echo "   2-WFS/1-DM  : Enabled (milk-mlt-calib2wfs1dm, modes=${SYSID_MODES}," \
         "W(z)=AR(${SYSID_WHITEN_ORDER}))"
fi
echo "   Perturb.    : wind_var=${WIND_VAR}(x${WIND_VAR_SCALE}) |" \
     "wind_burst=${WIND_BURST}(x${WIND_BURST_SCALE}) |" \
     "vib=${VIB_ENABLE}(${VIB_RMS_NM}nm) |" \
     "petal=${PETAL_ENABLE}(${PETAL_RMS_NM}nm,tau=${PETAL_TAU_S}s)"
echo "   Atm & ADC   : zenith=${ZENITH_DEG} deg, PA=${DISP_PA_DEG} deg (IMR=${IMR_MODE})," \
     "chrom_turb=${CHROM_TURB} | AO188 ADC=${ADC_PRESET}/${ADC_MODE}(band=${ADC_OPT_BAND}," \
     "mech=${ADC_MECH}${ADC_LUT_ERR:+, lut_err=${ADC_LUT_ERR}}) | Vis-TTM=${VIS_TTM_MODE}(g=${VIS_TTM_GAIN})"
if (( PETAL_CTRL )); then
    echo "   Petal Ctrl  : Stage-1 passive JIT (petal-1 -> dm01disp06, sign=${PETAL_USE_SIGN}," \
         "alpha=${PETAL_ALPHA}, warmup=${PETAL_WARMUP}fr, th=${PETAL_TH_EVEN}/${PETAL_TH_SIGN}, at=${PETAL_ENABLE_AT})"
fi
echo "================================================================================"

sysmon.start "${OUT_DIR}" .rate=5.0

sysmon.mark "deploy_bench" "Deploy ${BENCH_MODE} optical bench (turb_gain=0.0)"
echo "[ao3k-scexao] Step 1/7: Deploying ${BENCH_MODE} optical bench (turb_gain = 0.0)..."
cacaosim.deploy "${ACTIVE_BENCH}" \
    .mode="${BENCH_MODE}" \
    .oversample="${OVERSAMPLE}" \
    .atmturb=1 \
    .seeing="${SEEING}" \
    .workdir="${CSIM_DIR}" >/dev/null

EFF_OV="$(awk -F'\t' '$1=="OVERSAMPLE"{print $2; exit}' \
    "${CSIM_DIR}/cacaosim.meta" "${CSIM_DIR}/run/cacaosim.meta" 2>/dev/null || true)"
if [[ -z "${EFF_OV}" && -f "${MILK_SHM_DIR:-/milk/shm}/csim_active.bench" ]]; then
    EFF_OV="$(awk -F'=' '/^[ \t]*oversample[ \t]*=/{gsub(/[ \t]/,"",$2); print int($2); exit}' \
        "${MILK_SHM_DIR:-/milk/shm}/csim_active.bench" 2>/dev/null || true)"
fi
[[ -z "${EFF_OV}" || "${EFF_OV}" -lt 1 ]] && EFF_OV=1
CAL_MASTER_RATE="$(awk -v r="${CAL_RATE}" -v k="${EFF_OV}" 'BEGIN { printf "%.2f", r * k }')"
WALL_MASTER_RATE="$(awk -v r="${WALL_RATE}" -v k="${EFF_OV}" 'BEGIN { printf "%.2f", r * k }')"
SIM_MASTER_HZ=$(( 2000 * EFF_OV ))
echo "[ao3k-scexao]   Active oversampling: ${EFF_OV}x (sim master = ${SIM_MASTER_HZ} Hz)"

milk-fps-runstop -q "${MASTER_UNIT}" csim_atmturb
milk-fps-wait -q -t 10 "${MASTER_UNIT}" >/dev/null 2>&1 || true
milk-fps-set -q \
    "${MASTER_UNIT}.turb_gain=0.0" \
    "${MASTER_UNIT}.vib_enable=OFF" \
    "${MASTER_UNIT}.petal_enable=OFF" \
    "${MASTER_UNIT}.petal_off0_nm=0.0" \
    "${MASTER_UNIT}.petal_off1_nm=0.0" \
    "${MASTER_UNIT}.petal_off2_nm=0.0" \
    "${MASTER_UNIT}.petal_off3_nm=0.0" \
    "${MASTER_UNIT}.atm_disp_enable=OFF" \
    "${MASTER_UNIT}.frame_rate=${CAL_MASTER_RATE}" \
    "${MASTER_UNIT}.procinfo.triggermode=0"
if [[ "${BENCH_MODE}" == "fused" ]]; then
    # Beams are exported to SHM for CPU cross-check (--wfstat-validate) or truth telemetry
    if (( EXPORT_BEAMS_NEEDED )); then
        milk-fps-set -q "csim_htsim.export_beams=b_pup,b_post_stg1,b_post_stg2"
    fi
    milk-fps-set -q \
        "csim_htsim.adc_mode=0" \
        "csim_htsim.export_enable=OFF" \
        "csim_htsim.wfstat_enable=OFF"
elif @exists "f.csim_ao188"; then
    milk-fps-set -q "csim_ao188.mode=retracted"
fi
milk-fps-runstart -q "${MASTER_UNIT}"
milk-stream-wait -q -t 20 \
    csim_wfs_nir csim_wfs_vis csim_wfs_lowfs \
    psf_vis_final_long psf_nir_final_long psf_nir_coro_long
if @exists "s.dm_vis_pyrwfs_tt"; then
    @calc "s.dm_vis_pyrwfs_tt = s.dm_vis_pyrwfs_tt * 0.0"
fi

sysmon.mark "dl_reference" "Acquire diffraction-limited reference PSFs & coronagraph dark hole"
echo "[ao3k-scexao] Step 2/7: Acquiring diffraction-limited & coronagraph reference PSFs..."
milk-stream-wait -q -t 20 "csim_wfs_vis+40"
cacaosim.reset_long
milk-stream-wait -q -t 30 "psf_vis_final_long+15" "psf_nir_coro_long+15"
if @exists "s.csim_pup"; then
    fpspipe.savefits "csim_pup" "${OUT_DIR}/csim_pup.fits"
fi
fpspipe.savefits "psf_vis_final_long" "${OUT_DIR}/psf_vis_dl.fits"
fpspipe.savefits "psf_nir_final_long" "${OUT_DIR}/psf_nir_dl.fits"
fpspipe.savefits "psf_nir_coro_long" "${OUT_DIR}/psf_nir_coro_dl.fits"
if @exists "s.coro_pre_lyot_long"; then
    fpspipe.savefits "coro_pre_lyot_long" "${OUT_DIR}/coro_pre_lyot_dl.fits"
fi
fpspipe.savefits "csim_wfs_lowfs" "${OUT_DIR}/det_wfs_lowfs_dl.fits"
for cam in vis_raw nir_raw vis_stg1 nir_stg1 vis_final nir_final nir_coro; do
    fpspipe.savefits "psf_${cam}" "${OUT_DIR}/det_${cam}_dl.fits"
done
if (( PYRWFS_TLM )) && command -v cacao-fpsexec-pyrwfstlm >/dev/null 2>&1; then
    @calc "@S:aol1_pyr_ref = s.csim_wfs_nir"
    @calc "@S:aol2_pyr_ref = s.csim_wfs_vis"
    for _pi in $(seq 2 16); do
        milk-stream-wait -q -t 10 "csim_wfs_vis+2"
        @calc "s.aol1_pyr_ref = s.aol1_pyr_ref + s.csim_wfs_nir"
        @calc "s.aol2_pyr_ref = s.aol2_pyr_ref + s.csim_wfs_vis"
    done
    @calc "s.aol1_pyr_ref = s.aol1_pyr_ref / 16.0"
    @calc "s.aol2_pyr_ref = s.aol2_pyr_ref / 16.0"
    fpspipe.savefits "aol1_pyr_ref" "${OUT_DIR}/pyrwfs_ref_stg1.fits"
    fpspipe.savefits "aol2_pyr_ref" "${OUT_DIR}/pyrwfs_ref_stg2.fits"
fi
if [[ "${BENCH_MODE}" == "fused" ]]; then
    @set "f.csim_htsim.enable_fpcam=OFF"
fi

sysmon.mark "deploy_loops" "Deploy Stage-1 (64x64), Stage-2 (50x50+ZPO) & Stage-3 (LLOWFS) loops"
echo "[ao3k-scexao] Step 3/7: Deploying Stage-1 (AO3k), Stage-2 (SCExAO+ZPO) & Stage-3 (LLOWFS)..."
WFS_DARKSUB_EFF="OFF"
WFS_DARK_ADU_EFF="0.0"
WFS_NORMFLOOR_EFF="1.0"
if [[ -n "${WFS_DARK_ADU}" ]]; then
    WFS_DARKSUB_EFF="ON"
    WFS_DARK_ADU_EFF="${WFS_DARK_ADU}"
    WFS_NORMFLOOR_EFF="0.001"
fi
export CACAO_WFS_DARKSUB="${WFS_DARKSUB_EFF}"
export CACAO_WFS_DARK_ADU="${WFS_DARK_ADU_EFF}"
export CACAO_WFS_NORMFLOOR="${WFS_NORMFLOOR_EFF}"
export CACAO_SELFLEARN_ENABLE="${SELFLEARN}"
export CACAO_SELFLEARN_MODES="${SELFLEARN_MODES}"
export CACAO_SELFLEARN_KMAX="${SELFLEARN_KMAX}"

CACAO_LOOPROOTDIR="${STG1_ROOT}" \
CACAO_WFSFRATE="${CAL_WFS1_RATE}" \
CACAO_TBUFF_SIZE="${STG1_TBUFF_SIZE}" \
CACAO_LOOPGAIN="${GAIN1}" \
CACAO_LOOPMULT="${MULT1}" \
CACAO_LOOPMULT_TT="${MULT_TT}" \
CACAO_MMULT_FLOOR="${MMULT_FLOOR}" \
CACAO_MMULT_ALPHA="${MMULT_ALPHA}" \
CACAO_DMMASK_RMAX="${DMMASK_RMAX}" \
CACAO_DMMASK_RMIN="${DMMASK_RMIN}" \
CACAO_DMMASK_COBS_SLAVE="${DMMASK_COBS_SLAVE}" \
CACAO_WFSMASK_DILATE="${WFSMASK_DILATE}" \
CACAO_PF_LO_NMODE="${PF_LO_NMODE}" \
CACAO_PF_MODE="${PF_MODE}" \
CACAO_PF_BLOCKSIZE="${PF_BLOCKSIZE}" \
CACAO_PF_ORDER="${PF_ORDER}" \
CACAO_PF_REG="${PF_REG}" \
CACAO_PF_MAXNORM2="${PF_MAXNORM2}" \
CACAO_PF_DIFF_NMODE="${PF_DIFF_NMODE}" \
CACAO_PF_DIFF_ORDER="${PF_DIFF_ORDER}" \
CACAO_PF_DIFF_REG="${PF_DIFF_REG}" \
CACAO_PF_DIFF_MAXNORM2="${PF_DIFF_MAXNORM2}" \
CACAO_PF_DIFF_MAXDCGAIN="${PF_DIFF_MAXDCGAIN}" \
CACAO_PF_NBTRAIN="${PF_NBTRAIN1}" \
CACAO_PF_MINSAMPLES="${PF_MINSAMPLES1}" \
CACAO_PF_DIAGMINSAMPLES="${STG1_PF_DIAGMIN}" \
CACAO_PF_UPDATEPERIOD="${STG1_PF_UPD}" \
CACAO_PF_MGAIN_EXP="${PF_MGAIN_EXP}" \
    "${LOOP_CTRL}" --stage 1 deploy

if [[ -n "${DM1_PRESHAPER}" && -f "${DM1_PRESHAPER}" ]]; then
    ln -sfn "$(realpath "${DM1_PRESHAPER}")" "/tmp/.p15_ps_${$}.fits"
    milk-fps-rm -f -q --ignore-missing dmpreshaper-01 >/dev/null 2>&1 || true
    milk-fps-init -q dmpreshaper-01 cacao-fpsexec-dmpreshaper >/dev/null
    milk-fps-set -q \
        "dmpreshaper-01.streamin=dm01disp" \
        "dmpreshaper-01.streamout=dm01shaped" \
        "dmpreshaper-01.kernelfile=/tmp/.p15_ps_${$}.fits" \
        "dmpreshaper-01.trigstream=csim_wfs_vis" \
        "dmpreshaper-01.rate_hz=2000.0" \
        "dmpreshaper-01.enable=ON" \
        "dmpreshaper-01.gain=1.0" \
        "dmpreshaper-01.procinfo.loopcntMax=-1"
    milk-fps-runstart -q dmpreshaper-01
    sleep 0.15
    echo "[ao3k-scexao]   -> Stage-1 DM Pre-Shaper ON (2 kHz lockstep: dm01disp -> dm01shaped)"
fi

CACAO_LOOPROOTDIR="${STG2_ROOT}" \
CACAO_WFSFRATE="${CAL_RATE}" \
CACAO_LOOPGAIN="${GAIN2}" \
CACAO_LOOPMULT="${MULT2}" \
CACAO_PF_MODE="${PF_MODE}" \
CACAO_PF_BLOCKSIZE="${PF_BLOCKSIZE}" \
CACAO_PF_ORDER="${PF_ORDER}" \
CACAO_PF_REG="${PF_REG2}" \
CACAO_PF_MAXNORM2="${PF_MAXNORM2}" \
CACAO_PF_NBTRAIN="${PF_NBTRAIN2}" \
CACAO_PF_MINSAMPLES="${PF_MINSAMPLES2}" \
CACAO_PF_MGAIN_EXP="${PF_MGAIN_EXP2}" \
    "${LOOP_CTRL}" --stage 2 deploy

CACAO_LOOPROOTDIR="${STG3_ROOT}" \
CACAO_WFSFRATE="${CAL_WFS3_RATE}" \
CACAO_LOOPGAIN="${GAIN3}" \
CACAO_LOOPMULT="${MULT3}" \
    "${LOOP_CTRL}" --stage 3 deploy

CACAO_LOOPROOTDIR="${STG1_ROOT}" "${LOOP_CTRL}" --stage 1 zero
CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 zero
CACAO_LOOPROOTDIR="${STG3_ROOT}" "${LOOP_CTRL}" --stage 3 zero
milk-stream-wait -q -t 20 "csim_wfs_vis+20"

TURB_CAL=""
@get TURB_CAL="f.${MASTER_UNIT}.turb_gain"
echo "[ao3k-scexao] Step 4/7: Calibrating RMs with NO turbulence (turb_gain = ${TURB_CAL})..."

declare -a CAL1_ARGS=(--nframes 60 --nbloop "${NBLOOP}" --svdlim "${SVDLIM1}")
declare -a CAL2_ARGS=(--nframes 60 --nbloop "${NBLOOP}" --svdlim "${SVDLIM2}")
declare -a CAL3_ARGS=(--nframes 40 --nbloop "${NBLOOP}" --svdlim "${SVDLIM3}")
if [[ -n "${LOAD_RM_DIR}" ]]; then
    CAL1_ARGS+=(--load-rm "${LOAD_RM_DIR}/stage1")
    CAL2_ARGS+=(--load-rm "${LOAD_RM_DIR}/stage2")
    if [[ -d "${LOAD_RM_DIR}/stage3" ]]; then
        CAL3_ARGS+=(--load-rm "${LOAD_RM_DIR}/stage3")
    fi
fi
if [[ -n "${SAVE_RM_DIR}" ]]; then
    CAL1_ARGS+=(--save-rm "${SAVE_RM_DIR}/stage1")
    CAL2_ARGS+=(--save-rm "${SAVE_RM_DIR}/stage2")
    CAL3_ARGS+=(--save-rm "${SAVE_RM_DIR}/stage3")
fi

sysmon.mark "calib_stage1" "Stage-1 (64x64) RM/CM calibration or load"
t_cal1_0="$(date +%s)"
echo "[ao3k-scexao]   -> Stage 1 (AO3k, 64x64 DM D=60, 160x160 J-band PyWFS)..."
WFS_DARKSUB_EFF="OFF"
WFS_DARK_ADU_EFF="0.0"
WFS_NORMFLOOR_EFF="1.0"
if [[ -n "${WFS_DARK_ADU}" ]]; then
    WFS_DARKSUB_EFF="ON"
    WFS_DARK_ADU_EFF="${WFS_DARK_ADU}"
    WFS_NORMFLOOR_EFF="0.001"
fi
export CACAO_WFS_DARKSUB="${WFS_DARKSUB_EFF}"
export CACAO_WFS_DARK_ADU="${WFS_DARK_ADU_EFF}"
export CACAO_WFS_NORMFLOOR="${WFS_NORMFLOOR_EFF}"
export CACAO_SELFLEARN_ENABLE="${SELFLEARN}"
export CACAO_SELFLEARN_MODES="${SELFLEARN_MODES}"
export CACAO_SELFLEARN_KMAX="${SELFLEARN_KMAX}"

USE_FAST_CALIB1="${USE_FAST_CALIB}"
CALIB_TRIG1="dm01disp"
if [[ -n "${DM1_PRESHAPER}" ]] && @exists "f.dmpreshaper-01"; then
    CALIB_TRIG1="dm01shaped"
    if (( USE_FAST_CALIB1 )); then
        # Temporarily put dmpreshaper-01 into zero-latency streamin-triggered passthrough
        # so lockstep .calib_fast RM calibration pokes dm01disp -> dm01shaped -> csim_htsim
        # with exact 1:1 frame lock (unity DC gain, zero wall-clock drift or plate ringing).
        milk-fps-runstop -q dmpreshaper-01
        milk-fps-wait -q -t 10 dmpreshaper-01 >/dev/null 2>&1 || true
        milk-fps-set -q \
            "dmpreshaper-01.trigstream=none" \
            "dmpreshaper-01.enable=OFF"
        milk-fps-runstart -q dmpreshaper-01
        sleep 0.08
    fi
fi

CACAO_LOOPROOTDIR="${STG1_ROOT}" \
CACAO_WFSFRATE="${CAL_WFS1_RATE}" \
CACAO_FAST_CALIB="${USE_FAST_CALIB1}" \
CACAO_CALIB_TRIG="${CALIB_TRIG1}" \
CACAO_LOOPMULT="${MULT1}" \
CACAO_LOOPMULT_TT="${MULT_TT}" \
CACAO_MMULT_FLOOR="${MMULT_FLOOR}" \
CACAO_MMULT_ALPHA="${MMULT_ALPHA}" \
CACAO_DMMASK_RMAX="${DMMASK_RMAX}" \
CACAO_DMMASK_RMIN="${DMMASK_RMIN}" \
CACAO_DMMASK_COBS_SLAVE="${DMMASK_COBS_SLAVE}" \
CACAO_WFSMASK_DILATE="${WFSMASK_DILATE}" \
CACAO_PF_LO_NMODE="${PF_LO_NMODE}" \
CACAO_MGAIN_ALPHA="${MGAIN_ALPHA}" \
CACAO_MGAIN_FLOOR="${MGAIN_FLOOR}" \
CACAO_MGAIN_TT="${MGAIN_TT}" \
    "${LOOP_CTRL}" --stage 1 calibrate "${CAL1_ARGS[@]}"
CACAO_LOOPROOTDIR="${STG1_ROOT}" "${LOOP_CTRL}" --stage 1 zero
if [[ -n "${DM1_PRESHAPER}" ]] && (( USE_FAST_CALIB1 )) && @exists "f.dmpreshaper-01"; then
    milk-fps-runstop -q dmpreshaper-01
    milk-fps-wait -q -t 10 dmpreshaper-01 >/dev/null 2>&1 || true
    milk-fps-set -q \
        "dmpreshaper-01.trigstream=csim_wfs_vis" \
        "dmpreshaper-01.enable=ON"
    milk-fps-runstart -q dmpreshaper-01
    sleep 0.12
fi
milk-stream-wait -q -t 20 "csim_wfs_vis+20"
t_cal1_1="$(date +%s)"
echo "[ao3k-scexao]      Stage-1 calibration done in $(( t_cal1_1 - t_cal1_0 )) s."

if (( PETAL_CTRL )); then
    PETAL_CAL_DIR="${OUT_DIR}/petal_ctrl"
    mkdir -p "${PETAL_CAL_DIR}"
    echo "[ao3k-scexao]   -> Calibrating Stage-1 passive petal-unwrap filter (calib_petal_ctrl.py)..."
    PETAL_CM_ARG=()
    if [[ -f "${STG1_ROOT}/conf/CMmodesWFS.fits" ]]; then
        PETAL_CM_ARG+=(--cm-wfs "${STG1_ROOT}/conf/CMmodesWFS.fits")
    fi
    if [[ -f "${STG1_ROOT}/conf/CMmodesDM.fits" ]]; then
        PETAL_CM_ARG+=(--cm-dm "${STG1_ROOT}/conf/CMmodesDM.fits")
    fi
    PETAL_GOPT_EFF="${PSOL_OG1:-1.0}"
    "${PYTHON_BIN:-python3}" "${CACAO_WORK_ROOT}/benches/ao3k_scexao/calib_petal_ctrl.py" \
        --bench "${ACTIVE_BENCH}" \
        --pup "${OUT_DIR}/csim_pup.fits" \
        --wfsref "${STG1_ROOT}/conf/wfsref.fits" \
        --wfsmask "${STG1_ROOT}/conf/wfsmask.fits" \
        "${PETAL_CM_ARG[@]}" \
        --gopt "${PETAL_GOPT_EFF}" \
        --outdir "${PETAL_CAL_DIR}"
    if [[ "${PETAL_USE_SIGN}" == "auto" ]]; then
        PETAL_USE_SIGN_EFF="$("${PYTHON_BIN:-python3}" -c \
            "import json; print(json.load(open('${PETAL_CAL_DIR}/petal_ctrl_meta.json'))['use_sign_recommended'])")"
    else
        PETAL_USE_SIGN_EFF="${PETAL_USE_SIGN}"
    fi
    fpspipe.loadfits aol1_petalM "${PETAL_CAL_DIR}/petal_wfs_M.fits"
    fpspipe.loadfits aol1_petalDM "${PETAL_CAL_DIR}/petal_dm_modes.fits"
    "${PYTHON_BIN:-python3}" -c "import numpy as np; from astropy.io import fits; fits.writeto('${PETAL_CAL_DIR}/petal_eye8.fits', np.eye(8, dtype=np.float32), overwrite=True)"
    fpspipe.loadfits aol1_petal_eye "${PETAL_CAL_DIR}/petal_eye8.fits"
    @calc "@S:aol1_petal_raw = zeros(7); @S:aol1_petal_ema = zeros(7); @S:aol1_petal_cmd = zeros(8)"
    if @exists "s.dm01disp06"; then
        @calc "s.dm01disp06 = s.dm01disp06 * 0.0"
    fi
    echo "[ao3k-scexao]      Petal filter loaded to SHM (aol1_petalM, aol1_petalDM; use_sign=${PETAL_USE_SIGN_EFF})"
fi

sysmon.mark "calib_stage2" "Stage-2 (50x50) RM/CM calibration or load + ZPO MVM arm"
t_cal2_0="$(date +%s)"
echo "[ao3k-scexao]   -> Stage 2 (SCExAO, 50x50 DM D=46, 120x120 Vis PyWFS + ZPO)..."
CACAO_LOOPROOTDIR="${STG2_ROOT}" \
CACAO_WFSFRATE="${CAL_RATE}" \
CACAO_FAST_CALIB="${USE_FAST_CALIB}" \
CACAO_DMMASK_COBS_SLAVE="${DMMASK_COBS_SLAVE}" \
CACAO_WFSMASK_DILATE="${WFSMASK_DILATE2}" \
CACAO_MGAIN_ALPHA="${MGAIN_ALPHA}" \
CACAO_MGAIN_FLOOR="${MGAIN_FLOOR}" \
CACAO_MGAIN_TT="${MGAIN_TT}" \
    "${LOOP_CTRL}" --stage 2 calibrate "${CAL2_ARGS[@]}"
CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 zero
milk-stream-wait -q -t 20 "csim_wfs_vis+20"
t_cal2_1="$(date +%s)"
echo "[ao3k-scexao]      Stage-2 calibration done in $(( t_cal2_1 - t_cal2_0 )) s."

sysmon.mark "calib_stage3" "Stage-3 (LLOWFS) 14-mode Zernike RM/CM calibration or load"
t_cal3_0="$(date +%s)"
USE_FAST_CALIB3=0
if [[ "${BENCH_MODE}" == "fused" ]] && (( FAST_CALIB )) && \
   { [[ -z "${LOAD_RM_DIR}" ]] || [[ ! -d "${LOAD_RM_DIR}/stage3" ]]; }; then
    USE_FAST_CALIB3=1
fi
echo "[ao3k-scexao]   -> Stage 3 (LLOWFS, 50x50 DM ZPO, 64x64 Lyot-Refl defocused fpcam)..."
CACAO_LOOPROOTDIR="${STG3_ROOT}" \
CACAO_WFSFRATE="${CAL_WFS3_RATE}" \
CACAO_FAST_CALIB="${USE_FAST_CALIB3}" \
    "${LOOP_CTRL}" --stage 3 calibrate "${CAL3_ARGS[@]}"
CACAO_LOOPROOTDIR="${STG3_ROOT}" "${LOOP_CTRL}" --stage 3 zero
milk-stream-wait -q -t 20 "csim_wfs_lowfs+8"
t_cal3_1="$(date +%s)"
echo "[ao3k-scexao]      Stage-3 calibration done in $(( t_cal3_1 - t_cal3_0 )) s."

if [[ "${CAL_RATE}" != "${WALL_RATE}" ]]; then
    @set "f.${MASTER_UNIT}.frame_rate=${WALL_MASTER_RATE}"
fi

if (( RUN_SELFRM )); then
    sysmon.mark "selfrm_calib" "Open-loop calibration selfRM (Stage 1, 2 & 3)"
    echo "[ao3k-scexao] Step 4b/7: Acquiring calibration selfRM (no turbulence, open-loop)..."
    t_srmc_0="$(date +%s)"
    declare -a SRMC_FAST_ARG=()
    if [[ "${BENCH_MODE}" == "fused" ]] && (( FAST_CALIB )); then
        SRMC_FAST_ARG=(--fast)
    fi
    declare -a SRMC1_FAST_ARG=("${SRMC_FAST_ARG[@]}")
    if [[ -n "${DM1_PRESHAPER}" ]]; then
        SRMC1_FAST_ARG=()
    fi
    CACAO_LOOPROOTDIR="${STG1_ROOT}" "${LOOP_CTRL}" --stage 1 selfrm \
        "${OUT_DIR}/selfRM_calib_stg1.fits" \
        --nbmode "${SELFRM_MODES}" --ampl 0.015 --nbiter 1 --nbsettle 2 "${SRMC1_FAST_ARG[@]}"
    cp -f "${OUT_DIR}/selfRM_calib_stg1.fits" "${STG1_ROOT}/conf/selfRM_calib.fits"
    CACAO_LOOPROOTDIR="${STG1_ROOT}" "${LOOP_CTRL}" --stage 1 zero
    milk-stream-wait -q -t 20 "csim_wfs_vis+15"

    CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 selfrm \
        "${OUT_DIR}/selfRM_calib_stg2.fits" \
        --nbmode "${SELFRM_MODES}" --ampl 0.010 --nbiter 1 --nbsettle 2 "${SRMC_FAST_ARG[@]}"
    cp -f "${OUT_DIR}/selfRM_calib_stg2.fits" "${STG2_ROOT}/conf/selfRM_calib.fits"
    CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 zero
    milk-stream-wait -q -t 20 "csim_wfs_vis+15"

    CACAO_LOOPROOTDIR="${STG3_ROOT}" "${LOOP_CTRL}" --stage 3 selfrm \
        "${OUT_DIR}/selfRM_calib_stg3.fits" \
        --nbmode 14 --ampl 0.015 --nbiter 1 --nbsettle 2 "${SRMC_FAST_ARG[@]}"
    cp -f "${OUT_DIR}/selfRM_calib_stg3.fits" "${STG3_ROOT}/conf/selfRM_calib.fits"
    CACAO_LOOPROOTDIR="${STG3_ROOT}" "${LOOP_CTRL}" --stage 3 zero
    milk-stream-wait -q -t 20 "csim_wfs_lowfs+8"

    if [[ -n "${SAVE_RM_DIR}" ]]; then
        mkdir -p "${SAVE_RM_DIR}/stage1" "${SAVE_RM_DIR}/stage2" "${SAVE_RM_DIR}/stage3"
        cp -f "${OUT_DIR}/selfRM_calib_stg1.fits" "${SAVE_RM_DIR}/stage1/selfRM_calib.fits"
        cp -f "${OUT_DIR}/selfRM_calib_stg2.fits" "${SAVE_RM_DIR}/stage2/selfRM_calib.fits"
        cp -f "${OUT_DIR}/selfRM_calib_stg3.fits" "${SAVE_RM_DIR}/stage3/selfRM_calib.fits"
    fi
    t_srmc_1="$(date +%s)"
    echo "[ao3k-scexao]      Calibration selfRM done in $(( t_srmc_1 - t_srmc_0 )) s."
fi

if (( MR_DM1 )); then
    milk-stream-wait -q -t 15 aol1_modevalDM_traj aol1_modevalDM
    milk-fps-set -q \
        "mfilt-1.PF.mr_substeps=${MR_SUBSTEPS}" \
        "mfilt-1.PF.mr_velgain=${MR_VEL_GAIN}" \
        "mfilt-1.PF.mr_pacer_out=ON" \
        "mfilt-1.PF.mr_enable=ON"
    milk-fps-rm -f -q --ignore-missing mvalpacer-1 >/dev/null 2>&1 || true
    milk-fps-init -q mvalpacer-1 cacao-fpsexec-mvalpacer >/dev/null
    milk-fps-set -q \
        "mvalpacer-1.streamin=aol1_modevalDM_traj" \
        "mvalpacer-1.streamout=aol1_modevalDM" \
        "mvalpacer-1.trigstream=csim_wfs_vis" \
        "mvalpacer-1.trig_decim=${MR_TRIG_DECIM}" \
        "mvalpacer-1.k_sub=${MR_SUBSTEPS}" \
        "mvalpacer-1.vel_gain=${MR_VEL_GAIN}" \
        "mvalpacer-1.enable=ON" \
        "mvalpacer-1.procinfo.loopcntMax=-1"
    milk-fps-runstart -q mvalpacer-1
    sleep 0.12
    echo "[ao3k-scexao]   -> Stage-1 Multi-Rate Modal Pacer ON" \
         "(WFS1=${WFS1_RATE} Hz -> DM1=${MR_DM1_HZ} Hz, K_sub=${MR_SUBSTEPS}, vel_gain=${MR_VEL_GAIN})"
fi

if (( PREDICTIVE )); then
    sysmon.mark "testol_calib" "Closed-loop PSOL latency & optical gain calibration (testOL)"
    echo "[ao3k-scexao] Step 4c/7: Calibrating closed-loop PSOL latency & gain (testOL)..."
    if [[ "${BENCH_MODE}" == "fused" ]]; then
        # Pace testOL at ~300 Hz WFS2 wall-clock (matching closed-loop science lockstep rate)
        # so measured IPC/pipeline latency matches science telemetry to <0.05 fr.
        TOL_MASTER_RATE="$(awk -v k="${EFF_OV}" 'BEGIN { printf "%.2f", 300.0 * k }')"
        milk-fps-set -q \
            "csim_htsim.enable_fpcam=ON" \
            "csim_htsim.frame_rate=${TOL_MASTER_RATE}"
    fi
    if (( WFS1_RATE < 1000 )); then
        milk-fps-set -q \
            "mfilt-1.comp.latencyhardwfr=1.0" \
            "mfilt-1.comp.latencysoftwfr=1.0"
    fi
    milk-stream-wait -q -t 20 "csim_wfs_vis+20"
    CACAO_LOOPROOTDIR="${STG1_ROOT}" "${LOOP_CTRL}" --stage 1 close "${GAIN1}"
    milk-stream-wait -q -t 30 "csim_wfs_nir+15"
    TOL1_NSAMP=180
    (( WFS1_RATE <= 250 )) && TOL1_NSAMP=120
    CACAO_LOOPROOTDIR="${STG1_ROOT}" CACAO_PF_MODE="${PF_MODE}" \
        "${LOOP_CTRL}" --stage 1 testol 2 0.025 "${TOL1_NSAMP}" 1.0
    tol1_ps_lat=2.5
    @get tol1_ps_lat="f.${PF_MK_PFX}-1.PFlatency"
    if [[ -n "${DM1_PRESHAPER}" ]]; then
        # Also calibrate unshaped modes (m >= 32) so 2-tap fallback & modalog match m >= 32 exactly
        CACAO_LOOPROOTDIR="${STG1_ROOT}" CACAO_PF_MODE="${PF_MODE}" \
            "${LOOP_CTRL}" --stage 1 testol 40 0.025 "${TOL1_NSAMP}" 1.0
    fi
    CACAO_LOOPROOTDIR="${STG1_ROOT}" CACAO_PF_MODE="${PF_MODE}" "${LOOP_CTRL}" --stage 1 zero
    milk-stream-wait -q -t 30 "csim_wfs_vis+15"

    if (( ENABLE_STAGE2 )); then
        CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 close "${GAIN2}"
        milk-stream-wait -q -t 30 "csim_wfs_vis+20"
        CACAO_LOOPROOTDIR="${STG2_ROOT}" CACAO_PF_MODE="${PF_MODE}" \
            "${LOOP_CTRL}" --stage 2 testol 2 0.020 220 1.0
        CACAO_LOOPROOTDIR="${STG2_ROOT}" CACAO_PF_MODE="${PF_MODE}" "${LOOP_CTRL}" --stage 2 zero
        milk-stream-wait -q -t 30 "csim_wfs_vis+15"
    fi
    if [[ "${BENCH_MODE}" == "fused" ]]; then
        @set "f.csim_htsim.frame_rate=${WALL_MASTER_RATE}"
    fi

    tol1_lat=2.5 tol1_wf=1.0 tol2_lat=2.8 tol2_wf=1.0
    @get tol1_lat="f.${PF_MK_PFX}-1.PFlatency" tol1_wf="f.mfilt-1.comp.WFSfact" \
         tol2_lat="f.${PF_MK_PFX}-2.PFlatency" tol2_wf="f.mfilt-2.comp.WFSfact"
    echo "[ao3k-scexao]      testOL Stage 1: lag=${tol1_lat} fr (preshaped=${tol1_ps_lat} fr)," \
         "WFSfact=${tol1_wf} | Stage 2: lag=${tol2_lat} fr, WFSfact=${tol2_wf}"
fi

# Align open-loop 3D RM kernels (dmDisp -> modevalWFS) to exact closed-loop testOL lag
# (modevalDM -> modevalWFS) so dynpsol, modalog, 2WFS1DM, and Filtered-X EOF stay phase-matched.
DYNPSOL1_EFF="${DYNPSOL1}"
DYNPSOL2_EFF="${DYNPSOL2}"
PF_FX1_EFF="${PF_FX1}"
PF_FX2_EFF="${PF_FX2}"
align_dm_kernel() {
    local src="$1" target_lat="$2" dst="$3" label="$4"
    "${PYTHON_BIN:-python3}" - "${src}" "${target_lat}" "${dst}" "${label}" <<'PY'
import sys
import numpy as np
from astropy.io import fits

src, target_s, dst, label = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
target = float(target_s)
H = fits.getdata(src).astype(np.float64)
taps = np.arange(H.shape[0], dtype=np.float64)
if H.ndim == 3:
    hm = np.array([np.mean(np.diag(H[l])) for l in range(H.shape[0])])
elif H.ndim == 2:
    hm = np.mean(H, axis=1)
else:
    hm = H.copy()
c0 = float(np.sum(taps * hm) / np.sum(hm)) if abs(np.sum(hm)) > 1e-9 else target
shift = target - c0
if shift > 1e-4:
    k0 = int(np.floor(shift))
    alpha = shift - k0
    max_l = min(24, H.shape[0] + k0 + 2)
    out = np.zeros((max_l,) + H.shape[1:], dtype=np.float64)
    for l in range(H.shape[0]):
        i0 = min(l + k0, max_l - 1)
        i1 = min(l + k0 + 1, max_l - 1)
        out[i0] += (1.0 - alpha) * H[l]
        out[i1] += alpha * H[l]
else:
    out = H.copy()
out[0] = 0.0
# Preserve exact unity DC gain (sum_l H[l] = I)
dc = np.sum(out, axis=0)
if out.ndim == 3:
    c_new = np.sum(np.arange(out.shape[0]) * np.array([np.mean(np.diag(out[l])) for l in range(out.shape[0])])) / np.mean(np.diag(dc))
else:
    c_new = np.sum(np.arange(out.shape[0]) * np.mean(out, axis=1)) / np.mean(dc)
fits.writeto(dst, out.astype(np.float32), overwrite=True)
print(f"[ao3k-scexao]      Aligned {label}: centroid {c0:.3f} -> {c_new:.3f} fr (shift {shift:+.3f} fr, L={out.shape[0]})")
PY
}

if [[ -n "${DYNPSOL1}" && -f "${DYNPSOL1}" ]]; then
    DYNPSOL1_EFF="${WORK_ROOT}/H1_aligned.fits"
    align_dm_kernel "${DYNPSOL1}" "${tol1_ps_lat:-${tol1_lat:-2.5}}" "${DYNPSOL1_EFF}" "Stage-1 dynpsol"
    cp -f "${DYNPSOL1_EFF}" "${STG1_ROOT}/conf/dynpsol_kern.fits"
    milk-fps-set -q \
        "mfilt-1.comp.dynpsol.kernel=../conf/dynpsol_kern.fits" \
        "mfilt-1.comp.dynpsol.enable=ON" \
        "mfilt-1.comp.dynpsol.reload=ON"
fi
if [[ -n "${DYNPSOL2}" && -f "${DYNPSOL2}" ]]; then
    DYNPSOL2_EFF="${WORK_ROOT}/H2_aligned.fits"
    align_dm_kernel "${DYNPSOL2}" "${tol2_lat:-2.8}" "${DYNPSOL2_EFF}" "Stage-2 dynpsol"
    cp -f "${DYNPSOL2_EFF}" "${STG2_ROOT}/conf/dynpsol_kern.fits"
    milk-fps-set -q \
        "mfilt-2.comp.dynpsol.kernel=../conf/dynpsol_kern.fits" \
        "mfilt-2.comp.dynpsol.enable=ON" \
        "mfilt-2.comp.dynpsol.reload=ON"
fi
if [[ -n "${PF_FX1}" && -f "${PF_FX1}" ]]; then
    if [[ "${PF_FX1}" == "${DYNPSOL1}" && -f "${DYNPSOL1_EFF}" ]]; then
        PF_FX1_EFF="${DYNPSOL1_EFF}"
    else
        PF_FX1_EFF="${WORK_ROOT}/H1_fx_aligned.fits"
        align_dm_kernel "${PF_FX1}" "${tol1_lat:-2.5}" "${PF_FX1_EFF}" "Stage-1 PF_FX"
    fi
fi
if [[ -n "${PF_FX2}" && -f "${PF_FX2}" ]]; then
    if [[ "${PF_FX2}" == "${DYNPSOL2}" && -f "${DYNPSOL2_EFF}" ]]; then
        PF_FX2_EFF="${DYNPSOL2_EFF}"
    else
        PF_FX2_EFF="${WORK_ROOT}/H2_fx_aligned.fits"
        align_dm_kernel "${PF_FX2}" "${tol2_lat:-2.8}" "${PF_FX2_EFF}" "Stage-2 PF_FX"
    fi
fi

sysmon.mark "closed_loop_warmup" "Enable turbulence & lock Stage 1 + Stage 2 closed loops"
echo "[ao3k-scexao] Step 5/7: Enabling 1:${EFF_OV} lockstep turbulence (${SEEING}\", dt=0.5 ms)..."
milk-fps-runstop -q "${MASTER_UNIT}" csim_atmturb
milk-fps-wait -q -t 10 "${MASTER_UNIT}" csim_atmturb >/dev/null 2>&1 || true
ATM_STEP_S="0.0005"
ATM_LOCK_STREAM="csim_wfs_vis"
if [[ "${BENCH_MODE}" == "fused" ]] && (( ! USER_WALL_RATE_SET )); then
    ATM_TRIG_DT="0.0"
else
    ATM_TRIG_DT="${WALL_DT}"
fi
if [[ "${BENCH_MODE}" == "modular" ]] && (( EFF_OV > 1 )); then
    ATM_STEP_S="$(awk -v k="${EFF_OV}" 'BEGIN { printf "%.8f", 0.0005 / k }')"
    ATM_TRIG_DT="$(awk -v d="${WALL_DT}" -v k="${EFF_OV}" 'BEGIN { printf "%.7f", d / k }')"
    ATM_LOCK_STREAM="b_pup"
fi
if [[ "${BENCH_MODE}" == "fused" ]]; then
    milk-fps-set -q \
        "csim_htsim.enable_fpcam=ON" \
        "csim_htsim.atm_disp_enable=ON" \
        "csim_htsim.zenith_deg=${ZENITH_DEG}" \
        "csim_htsim.disp_pa_deg=${DISP_PA_DEG}" \
        "csim_htsim.adc_mode=-1"
elif @exists "f.csim_ao188"; then
    milk-fps-set -q \
        "csim_mkbeam.atm_disp_enable=ON" \
        "csim_mkbeam.zenith_deg=${ZENITH_DEG}" \
        "csim_mkbeam.disp_pa_deg=${DISP_PA_DEG}" \
        "csim_ao188.mode=${ADC_MODE}" \
        "csim_ao188.zenith_deg=${ZENITH_DEG}" \
        "csim_ao188.disp_pa_deg=${DISP_PA_DEG}"
fi
ZENITH_RAD="$(awk -v z="${ZENITH_DEG}" 'BEGIN { printf "%.7f", z * 3.14159265358979323846 / 180.0 }')"
DISP_PA_RAD="$(awk -v p="${DISP_PA_DEG}" 'BEGIN { printf "%.7f", p * 3.14159265358979323846 / 180.0 }')"
CHROM_LAM_SET_ARGS=()
CHROM_OPD_ARG="0"
ATMTURB_AMP_ARG="0"
if (( ATMTURB_FRESNEL > 0 )); then
    ATMTURB_AMP_ARG="1"
    milk-stream-rm -q --ignore-missing outarrayamp >/dev/null 2>&1 || true
elif (( CHROM_TURB )); then
    CHROM_LAM_SET_ARGS=("csim_atmturb.chrom_lambdas=${CHROM_LAMBDAS}")
    CHROM_OPD_ARG="1"
fi
VIB_STR="OFF"; (( VIB_ENABLE )) && VIB_STR="ON"
PETAL_STR="OFF"; (( PETAL_ENABLE )) && PETAL_STR="ON"
milk-fps-set -q \
    "csim_atmturb.seeing=${SEEING}" \
    "csim_atmturb.zenith_angle=${ZENITH_RAD}" \
    "csim_atmturb.parallactic_angle=${DISP_PA_RAD}" \
    "csim_atmturb.site_alt=4205.0" \
    "csim_atmturb.amplitude=${ATMTURB_AMP_ARG}" \
    "csim_atmturb.fresnel=${ATMTURB_FRESNEL}" \
    "${CHROM_LAM_SET_ARGS[@]}" \
    "csim_atmturb.chrom_opd_um=${CHROM_OPD_ARG}" \
    "csim_atmturb.time_step=${ATM_STEP_S}" \
    "csim_atmturb.wind_var=${WIND_VAR}" \
    "csim_atmturb.wind_var_scale=${WIND_VAR_SCALE}" \
    "csim_atmturb.wind_burst=${WIND_BURST}" \
    "csim_atmturb.wind_burst_scale=${WIND_BURST_SCALE}" \
    "csim_atmturb.procinfo.triggermode=3" \
    "csim_atmturb.procinfo.triggersname=${ATM_LOCK_STREAM}" \
    "csim_atmturb.procinfo.triggerdelay=${ATM_TRIG_DT}" \
    "csim_atmturb.procinfo.triggertimeout=0.2" \
    "${MASTER_UNIT}.turb_gain=0.10" \
    "${MASTER_UNIT}.vib_enable=${VIB_STR}" \
    "${MASTER_UNIT}.vib_rms_nm=${VIB_RMS_NM}" \
    "${MASTER_UNIT}.petal_enable=${PETAL_STR}" \
    "${MASTER_UNIT}.petal_rms_nm=${PETAL_RMS_NM}" \
    "${MASTER_UNIT}.petal_tau_s=${PETAL_TAU_S}" \
    "${MASTER_UNIT}.petal_off0_nm=0.0" \
    "${MASTER_UNIT}.petal_off1_nm=0.0" \
    "${MASTER_UNIT}.petal_off2_nm=0.0" \
    "${MASTER_UNIT}.petal_off3_nm=0.0" \
    "${MASTER_UNIT}.frame_rate=0.0" \
    "${MASTER_UNIT}.procinfo.triggermode=3" \
    "${MASTER_UNIT}.procinfo.triggersname=outarraypha"
# Start consumer (MASTER_UNIT) first so its outarraypha semaphore is armed before
# csim_atmturb emits frame 0 and initiates 1:1 ping-pong lockstep on ATM_LOCK_STREAM.
milk-fps-runstart -q "${MASTER_UNIT}"
milk-fps-runstart -q csim_atmturb
milk-stream-wait -q -t 30 "outarraypha+5" "csim_wfs_vis+20"

echo "[ao3k-scexao] Step 6/7: Closing Stg1 (1kHz) -> Stg2 (2kHz) -> Stg3 LLOWFS (${PHYS_TIME} s)..."
CACAO_LOOPROOTDIR="${STG1_ROOT}" "${LOOP_CTRL}" --stage 1 close "${GAIN1}"
milk-stream-wait -q -t 30 "csim_wfs_vis+80"
for _tg in 0.25 0.40 0.55 0.70 0.85 1.0; do
    @set "f.${MASTER_UNIT}.turb_gain=${_tg}"
    milk-stream-wait -q -t 30 "csim_wfs_vis+120"
done
milk-stream-wait -q -t 30 "csim_wfs_vis+200"
if [[ -n "${PSOL_OG1}" ]]; then
    echo "[ao3k-scexao]   -> Scaling Stage-1 PSOL WFSfact for on-sky optical gain g_opt=${PSOL_OG1}"
    CACAO_LOOPROOTDIR="${STG1_ROOT}" "${LOOP_CTRL}" --stage 1 setog "${PSOL_OG1}"
fi
# Precompute SCExAO Visible Pyramid WFS Tip-Tilt Mount projector & optional feedforward
VIS_TTM_FF_X="0.0"
VIS_TTM_FF_Y="0.0"
if [[ "${VIS_TTM_MODE}" != "off" ]] && @exists "s.dm_vis_pyrwfs_tt"; then
    VISTT_DIR="${WORK_ROOT}/vis_ttm"
    mkdir -p "${VISTT_DIR}"
    VISTT_FF_OUT="$("${PYTHON_BIN:-python3}" - "${VISTT_DIR}" "${VIS_TTM_MODE}" \
        "${ZENITH_DEG}" "${DISP_PA_DEG}" "${ADC_PRESET}" "${ADC_MODE}" "${ADC_OPT_BAND}" \
        "${STG3_ROOT}/conf/CMmodesDM.fits" "${STG3_ROOT}/conf/CMmodesWFS.fits" <<'PY'
import math, os, sys
import numpy as np
from astropy.io import fits

out_dir, mode = sys.argv[1], sys.argv[2].lower()
z_deg, pa_deg = float(sys.argv[3]), float(sys.argv[4])
preset, adc_mode, opt_band = sys.argv[5], sys.argv[6].lower(), sys.argv[7].lower()
cm3_dm_path, cm3_wfs_path = sys.argv[8], sys.argv[9]

# Build well-conditioned Stage-3 modal TT projector (2 x N_m) [um edge mechanical / mode]:
# Exclude ill-conditioned Lyot-stop (Tilt - Coma) near-null-space modes whose WFS-to-DM
# sensitivity sigma_k = ||CMmodesWFS[k]|| / ||CMmodesDM[k]|| drops below 65% of the peak TT
# mode sensitivity, preventing sign-reversing coma contamination in the TTM offload loop.
yy, xx = np.indices((50, 50), dtype=np.float64)
ux = (xx - 24.5) / 23.0
uy = (yy - 24.5) / 23.0
rr = np.hypot(ux, uy)
mask = (rr >= 0.307) & (rr <= 0.98)
Z = np.column_stack([
    np.ones(mask.sum()),
    ux[mask],
    uy[mask],
    (3.0 * rr[mask] ** 2 - 2.0) * ux[mask],
    (3.0 * rr[mask] ** 2 - 2.0) * uy[mask],
])
pinvZ = np.linalg.pinv(Z)

n_modes = 14
if os.path.isfile(cm3_dm_path):
    cm_dm = np.asarray(fits.getdata(cm3_dm_path), dtype=np.float64)
    if cm_dm.ndim == 3:
        n_modes = int(cm_dm.shape[0])
        tx_m = np.zeros(n_modes, dtype=np.float64)
        ty_m = np.zeros(n_modes, dtype=np.float64)
        dm_rms = np.zeros(n_modes, dtype=np.float64)
        for k in range(n_modes):
            c = pinvZ @ cm_dm[k][mask]
            tx_m[k] = c[1]
            ty_m[k] = c[2]
            dm_rms[k] = float(np.sqrt(np.mean(cm_dm[k][mask] ** 2))) + 1e-12
        keep = np.ones(n_modes, dtype=bool)
        if os.path.isfile(cm3_wfs_path):
            cm_wfs = np.asarray(fits.getdata(cm3_wfs_path), dtype=np.float64)
            if cm_wfs.ndim == 3 and cm_wfs.shape[0] == n_modes:
                w_norm = np.sqrt(np.sum(cm_wfs ** 2, axis=(1, 2)))
                sigma = w_norm / dm_rms
                tt_mag = np.hypot(tx_m, ty_m)
                tt_sel = tt_mag > 0.25 * float(np.max(tt_mag) + 1e-12)
                if np.any(tt_sel):
                    sig_ref = float(np.max(sigma[tt_sel]))
                    keep = sigma >= (0.65 * sig_ref)
                    if not np.any(keep & tt_sel):
                        keep = np.ones(n_modes, dtype=bool)
        w_mat = np.vstack([
            np.where(keep, tx_m, 0.0),
            np.where(keep, ty_m, 0.0),
        ]).astype(np.float32)  # (2, N_m)
    else:
        w_mat = np.zeros((2, n_modes), dtype=np.float32)
else:
    w_mat = np.zeros((2, n_modes), dtype=np.float32)

# MILK FITS convention: NumPy (N_m, 2) -> MILK (2, N_m), so M @ vec(aol3_modevalDM) = (2,)
fits.writeto(os.path.join(out_dir, "vistt_M.fits"), np.ascontiguousarray(w_mat.T), overwrite=True)
fits.writeto(os.path.join(out_dir, "vistt_bx.fits"), np.array([[1.0, 0.0]], dtype=np.float32), overwrite=True)
fits.writeto(os.path.join(out_dir, "vistt_by.fits"), np.array([[0.0, 1.0]], dtype=np.float32), overwrite=True)

ff_x, ff_y = 0.0, 0.0
if mode in ("feedforward", "ff+closed") and z_deg > 1e-6:
    rad2mas = 206264806.24709636
    def ciddor_nm1(lam):
        s2 = 1.0 / (lam * lam)
        tk, ppa, tc, rh = 275.15, 61500.0, 2.0, 20.0
        n_as = (5792105.0 / (238.0185 - s2) + 167917.0 / (57.362 - s2)) * 1e-8
        n_ax = n_as * (1.0 + 0.534e-6 * (415.0 - 450.0))
        n_ws = 1.022 * (295.235 + s2 * (2.6422 + s2 * (-0.03238 + s2 * 0.004028))) * 1e-8
        svp = math.exp(1.2378847e-5 * tk * tk - 1.9121316e-2 * tk + 33.93711047 - 6343.1645 / tk)
        pv = min(ppa, 0.01 * rh * (1.00062 + 3.14e-8 * ppa + 5.6e-7 * tc * tc) * svp)
        xw = pv / ppa
        pt = ppa / tk
        zc = 1.0 - pt * (1.58123e-6 - 2.9331e-8 * tc + 1.1043e-10 * tc * tc + (5.707e-6 - 2.051e-8 * tc) * xw + (1.9898e-4 - 2.376e-6 * tc) * xw * xw) + pt * pt * (1.83e-11 - 0.765e-8 * xw * xw)
        ma = 1e-3 * (28.9635 + 12.011e-6 * 15.0)
        mw = 0.018015
        rho_axs = (101325.0 * ma) / (0.9995922115 * 8.31451 * 288.15)
        rho_ws = (1333.0 * mw) / (0.999621 * 8.31451 * 293.15)
        return (((ppa * ma) / (zc * 8.31451 * tk)) * (1.0 - xw) / rho_axs) * n_ax + (((ppa * mw) / (zc * 8.31451 * tk)) * xw / rho_ws) * n_ws
    tz = math.tan(math.radians(min(80.0, z_deg)))
    fac = tz * (1.0 - 0.001254 * (1.0 + tz * tz))
    def atm_mas(lam):
        return (ciddor_nm1(lam) - ciddor_nm1(1.65)) * fac * rad2mas
    c_eg = (336.8307, 13.2420, 2.9890, -2.1854) if "nom" in preset else (317.5423, 15.9328, -2.6620, -1.8637)
    def dmax_mas(lam):
        l2, il2 = lam * lam, 1.0 / (lam * lam)
        return c_eg[0] * (il2 - 1.0 / 0.49) + c_eg[1] * (il2 * il2 - 1.0 / (0.49 * 0.49)) + c_eg[2] * (l2 - 0.49) + c_eg[3] * (l2 * l2 - 0.49 * 0.49)
    ax = atm_mas(0.75) * math.sin(math.radians(pa_deg))
    ay = atm_mas(0.75) * math.cos(math.radians(pa_deg))
    dx, dy = 0.0, 0.0
    if adc_mode not in ("retracted", "off", "bypass", "0"):
        w5 = (1.0 / 6.0, 1.0 / 6.0, 2.0 / 6.0, 1.0 / 6.0, 1.0 / 6.0)
        grids = [(0.997, 1.015, 1.033, 1.051, 1.070), (1.170, 1.210, 1.250, 1.290, 1.330), (1.480, 1.555, 1.630, 1.705, 1.780), (1.480, 1.685, 1.890, 2.095, 2.300), (1.945, 2.033, 2.120, 2.208, 2.295), (2.030, 2.115, 2.200, 2.285, 2.370), (0.450, 0.563, 0.700, 0.813, 0.900)] if opt_band == "whole" else [(1.500, 1.570, 1.640, 1.710, 1.780)]
        num, den = 0.0, 0.0
        for g in grids:
            av = [atm_mas(l) for l in g]
            dv = [dmax_mas(l) for l in g]
            ma = sum(w * a for w, a in zip(w5, av))
            md = sum(w * d for w, d in zip(w5, dv))
            for w, a, d in zip(w5, av, dv):
                num += w * (a - ma) * (d - md)
                den += w * (d - md) * (d - md)
        s_opt = max(-1.0, min(1.0, (num / den if den > 1e-30 else 0.0)))
        eff_pa = math.radians(pa_deg)
        drel = dmax_mas(0.75) - dmax_mas(1.65)
        dx = -drel * s_opt * math.sin(eff_pa)
        dy = -drel * s_opt * math.cos(eff_pa)
    mas_per_um = (4.0e-6 / 7.95) * rad2mas
    ff_x = max(-4.8, min(4.8, (ax + dx) / mas_per_um))
    ff_y = max(-4.8, min(4.8, (ay + dy) / mas_per_um))
print(f"{ff_x:.6f} {ff_y:.6f}")
PY
    )"
    read -r VIS_TTM_FF_X VIS_TTM_FF_Y <<< "${VISTT_FF_OUT}"
    fpspipe.loadfits aol2_visttM "${VISTT_DIR}/vistt_M.fits"
    fpspipe.loadfits aol2_vistt_bx "${VISTT_DIR}/vistt_bx.fits"
    fpspipe.loadfits aol2_vistt_by "${VISTT_DIR}/vistt_by.fits"
    @calc "@S:aol2_vistt_err = zeros(2)"
    if [[ "${VIS_TTM_MODE}" == "feedforward" || "${VIS_TTM_MODE}" == "ff+closed" ]]; then
        @calc "s.dm_vis_pyrwfs_tt = s.aol2_vistt_bx * ${VIS_TTM_FF_X} + s.aol2_vistt_by * ${VIS_TTM_FF_Y}"
        milk-stream-wait -q -t 20 "csim_wfs_vis+20"
    fi
fi
if (( ENABLE_STAGE2 )); then
    CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 close "${GAIN2}"
    milk-stream-wait -q -t 30 "csim_wfs_vis+200"
    if [[ -n "${ZPO_OG}" ]]; then
        echo "[ao3k-scexao]   -> Scaling Stage-2 ZPO & PSOL for optical gain g_opt=${ZPO_OG}"
        CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 setog "${ZPO_OG}"
    fi
fi
if (( ENABLE_LOWFS )) && (( ENABLE_STAGE2 )); then
    CACAO_LOOPROOTDIR="${STG3_ROOT}" "${LOOP_CTRL}" --stage 3 close "${GAIN3}"
fi
if [[ "${VIS_TTM_MODE}" != "off" ]] && @exists "s.dm_vis_pyrwfs_tt"; then
    if [[ "${VIS_TTM_MODE}" == "closed" || "${VIS_TTM_MODE}" == "ff+closed" ]] && \
       (( ENABLE_LOWFS )) && (( ENABLE_STAGE2 )) && @exists "s.aol3_modevalDM"; then
        ln -sfn "${CACAO_WORK_ROOT}/benches/ao3k_scexao/vis_pyrwfs_tt.calc" "${VISTT_CALC_LINK}"
        VISTT_PARAMS="enable:int=1 gain:float=${VIS_TTM_GAIN} slew_max:float=0.015 max_stroke:float=4.8 mas_per_um:float=103.7805 cmd_x:float=${VIS_TTM_FF_X} cmd_y:float=${VIS_TTM_FF_Y} err_x_mas:float=0 err_y_mas:float=0 cmd_x_mas:float=0 cmd_y_mas:float=0 n_steps:int=0"
        milk-fps-rm -f -q --ignore-missing vis_tt-2 >/dev/null 2>&1 || true
        milk-fpsexec-milk-calc -n vis_tt-2 -t aol3_modevalDM -p "${VISTT_PARAMS}" -f "${VISTT_CALC_LINK}" fpsinit >/dev/null
        milk-fpsexec-milk-calc -n vis_tt-2 runstart >/dev/null
        VIS_TTM_ACTIVE="1"
        echo "[ao3k-scexao]   -> SCExAO Vis PyWFS TTM offload ACTIVE (vis_tt-2: aol3_modevalDM -> dm_vis_pyrwfs_tt, mode=${VIS_TTM_MODE}, g=${VIS_TTM_GAIN})"
        # Allow differential TT offload (~0.25 s time constant) to converge before science integration
        milk-stream-wait -q -t 45 "csim_wfs_vis+1200"
    elif [[ "${VIS_TTM_MODE}" == "feedforward" ]]; then
        echo "[ao3k-scexao]   -> SCExAO Vis PyWFS TTM feedforward preset: cmd=(${VIS_TTM_FF_X}, ${VIS_TTM_FF_Y}) um"
        milk-stream-wait -q -t 30 "csim_wfs_vis+100"
    fi
fi

# Optional Stage-1 Passive Petal-Unwrap JIT Compute Unit (petal-1 -> dm01disp06)
PETAL_WAIT_EOF="0"
if (( PETAL_CTRL )) && @exists "s.aol1_petalM" && @exists "s.aol1_petalDM" && @exists "s.dm01disp06"; then
    @calc "s.dm01disp06 = s.dm01disp06 * 0.0; s.aol1_petal_ema = s.aol1_petal_ema * 0.0"
    ln -sfn "${CACAO_WORK_ROOT}/benches/ao3k_scexao/petal_unwrap.calc" "${PETAL_CALC_LINK}"
    PETAL_INIT_EN=1
    if [[ "${PETAL_ENABLE_AT}" == "science" ]]; then
        PETAL_INIT_EN=0
    elif (( PREDICTIVE )) && awk -v s="${PF_WARMUP_SEC:-0}" 'BEGIN { exit !(s > 0) }'; then
        # Defer arming during cold-start pure-integrator training until Stage-1 EOF engages (state=2)
        PETAL_INIT_EN=0
        PETAL_WAIT_EOF="1"
    fi
    PETAL_PARAMS="enable:int=${PETAL_INIT_EN} use_sign:int=${PETAL_USE_SIGN_EFF} alpha:float=${PETAL_ALPHA} min_warmup:int=${PETAL_WARMUP} settle_fr:int=20 th_even:float=${PETAL_TH_EVEN} th_adj:float=1.15 th_waf:float=1.45 th_sign:float=${PETAL_TH_SIGN} alpha_fast:float=${PETAL_FAST_ALPHA} fast_warmup:int=${PETAL_FAST_WARMUP} fast_th_even:float=${PETAL_FAST_TH_EVEN} fast_th_sign:float=${PETAL_FAST_TH_SIGN} fast_th_con:float=${PETAL_FAST_TH_CON} fast_dwell:int=${PETAL_FAST_DWELL} th_abort:float=2.90 abort_win:int=${PETAL_ABORT_WIN} verify_win:int=${PETAL_VERIFY_WIN} max_waves:int=4 step_scale:float=1.0 age_fr:int=0 n_jumps:int=0 n_aborts:int=0 n_rollbacks:int=0 last_petal:int=-1 last_dir:int=0 trial_p:int=-1 trial_dir:int=0 trial_ev0:float=0 fast_cand:int=-1 fast_streak:int=0 ev_sn:float=0 ev_ew:float=0 ev_adj:float=0 sg_e:float=0 sg_n:float=0 sg_w:float=0 sg_s:float=0 fev_sn:float=0 fev_ew:float=0 fsg_e:float=0 fsg_n:float=0 fsg_w:float=0 fsg_s:float=0 w_e:float=0 w_n:float=0 w_w:float=0 w_s:float=0"
    milk-fps-rm -f -q --ignore-missing petal-1 >/dev/null 2>&1 || true
    milk-fpsexec-milk-calc -n petal-1 -t aol1_imWFS2 -p "${PETAL_PARAMS}" -f "${PETAL_CALC_LINK}" fpsinit >/dev/null
    milk-fpsexec-milk-calc -n petal-1 runstart >/dev/null
    PETAL_CTRL_ACTIVE="1"
    echo "[ao3k-scexao]   -> Stage-1 Passive Petal Unwrapper ARMED (petal-1 -> dm01disp06," \
         "enable=${PETAL_INIT_EN}, wait_eof=${PETAL_WAIT_EOF}, use_sign=${PETAL_USE_SIGN_EFF}, warmup=${PETAL_WARMUP}fr, alpha=${PETAL_ALPHA})"
fi

# Optional Phase 3: Stage-1 live online optical gain via closed-loop DM pokes (modalog-1)
if (( ONLINE_OG1 )); then
    milk-fps-set -q \
        "mfilt-1.comp.ogprobe.ampl=${OG1_AMPL}" \
        "mfilt-1.comp.ogprobe.nbmode=${OG1_NBMODE}" \
        "mfilt-1.comp.ogprobe.stride=${OG1_STRIDE}" \
        "mfilt-1.comp.ogprobe.hold=${OG1_HOLD}" \
        "mfilt-1.comp.ogprobe.enable=ON"
    milk-fps-rm -f -q --ignore-missing modalog-1 >/dev/null 2>&1 || true
    milk-fps-init -q modalog-1 cacao-fpsexec-modalog >/dev/null
    OG1_KERN_ARG=""
    if [[ -n "${DYNPSOL1_EFF}" && -f "${DYNPSOL1_EFF}" ]]; then
        ln -sfn "$(realpath "${DYNPSOL1_EFF}")" "/tmp/.p15_ogk_${$}.fits"
        OG1_KERN_ARG="modalog-1.kernel=/tmp/.p15_ogk_${$}.fits"
    fi
    OG1_APP_STR="OFF"
    if (( OG1_APPLY )); then
        OG1_APP_STR="ON"
        # Reset scalar comp.WFSfact to 1.0 so testOL does not double-multiply modalog mWFSfact
        milk-fps-set -q "mfilt-1.comp.WFSfact=1.0" >/dev/null 2>&1 || true
    fi
    milk-fps-set -q \
        "modalog-1.AOloopindex=1" \
        "modalog-1.inwfs=aol1_modevalWFS_buff" \
        "modalog-1.indm=aol1_modevalDM_buff" \
        "modalog-1.inprobe=aol1_modevalprobe_buff" \
        "modalog-1.latency_fr=${tol1_lat:-2.5}" \
        "modalog-1.NBwin=1024" \
        "modalog-1.use_diff=ON" \
        "modalog-1.n_free=2" \
        "modalog-1.smooth_bw=2.0" \
        "modalog-1.snr_min=3.0" \
        "modalog-1.g_min=0.35" \
        "modalog-1.g_max=1.50" \
        "modalog-1.ema_alpha=0.35" \
        "modalog-1.apply=${OG1_APP_STR}" \
        "modalog-1.procinfo.triggermode=3" \
        "modalog-1.procinfo.triggersname=aol1_modevalWFS_buff" \
        "modalog-1.procinfo.loopcntMax=-1" \
        ${OG1_KERN_ARG}
    milk-fps-runstart -q modalog-1
    echo "[ao3k-scexao]   -> Phase 3 Stage-1 modalog ON (ampl=${OG1_AMPL}, M=${OG1_NBMODE}," \
         "stride=${OG1_STRIDE}, hold=${OG1_HOLD}, lat=${tol1_lat:-2.5}, apply=${OG1_APP_STR})"
fi

# Optional Phase 5a: Live mlt-windlayers on Stage-1 NIR PyWFS + DM1 OPD
WL1_STREAM=""
if (( WINDLAYERS1 )); then
    ln -sfn "${OUT_DIR}" "${WL1_LINK}"
    WL1_PUP_ARG=""
    if (( PYRWFS_TLM )); then
        WL1_PUP_ARG="wl-1.in_pupgeom=aol1_pyr_pupgeom"
    fi
    WL1_BG_ARG="${WFS_DARK_ADU:-100.0}"
    WL1_LAM="1.22"
    if (( ATMTURB_FRESNEL > 0 )); then
        # milkatmturb Rytov/Fresnel propagates outarrayamp at ref_lambda = 0.50 um
        WL1_LAM="0.50"
    fi
    # Extract Stage-1 force-driven plate DM stiffness (k2, k4) from active bench [dm.ao3k]
    read -r WL1_PLATE_K2 WL1_PLATE_K4 < <(awk '
        /^\[dm\.ao3k\]/ { in_dm=1; next }
        /^\[/ { in_dm=0 }
        in_dm {
            gsub(/[[:space:]"]/, "", $0)
            split($0, kv, "=")
            if (kv[1]=="dyn_mode") dyn=kv[2]
            else if (kv[1]=="plate_drive") drv=kv[2]
            else if (kv[1]=="f0_hz") f0=kv[2]+0
            else if (kv[1]=="act_pitch_mm") pitch_mm=kv[2]+0
            else if (kv[1]=="wave_c") wc=kv[2]+0
            else if (kv[1]=="bend_beta") bb=kv[2]+0
        }
        END {
            if ((dyn=="plate" || dyn=="3") && (drv=="force" || drv=="1")) {
                if (f0<=0) f0=1000.0
                if (pitch_mm<=0) pitch_mm=1.5
                p = pitch_mm * 1e-3
                w0 = 2.0 * 3.14159265358979323846 * f0
                k2 = (wc / (p * w0))^2
                k4 = (bb / (p * p * w0))^2
                printf "%.6f %.6f\n", k2, k4
            } else {
                printf "0.0 0.0\n"
            }
        }
    ' "${ACTIVE_BENCH}")
    milk-fps-rm -f -q --ignore-missing wl-1 >/dev/null 2>&1 || true
    milk-fps-init -q wl-1 milk-fpsexec-mlt-windlayers >/dev/null
    milk-fps-set -q \
        "wl-1.wfs=csim_wfs_nir" \
        "wl-1.pha=aol1_dmC" \
        ${WL1_PUP_ARG} \
        "wl-1.autocal_pup=ON" \
        "wl-1.bg=${WL1_BG_ARG}" \
        "wl-1.outname=wl1" \
        "wl-1.wfsmode=0" \
        "wl-1.frate=${WFS1_RATE}.0" \
        "wl-1.tbin=2" \
        "wl-1.diam=7.95" \
        "wl-1.diampix=0.0" \
        "wl-1.phapitch=0.1325" \
        "wl-1.twarm=0.4" \
        "wl-1.tmean=2.0" \
        "wl-1.lagmax=0.25" \
        "wl-1.vmax=50.0" \
        "wl-1.dv=0.75" \
        "wl-1.nsigma=6.0" \
        "wl-1.tupdate=0.75" \
        "wl-1.tavg=2.5" \
        "wl-1.modrad=${WFS1_MOD_RAD:-3.0}" \
        "wl-1.lambda=${WL1_LAM}" \
        "wl-1.phaunit=2e-6" \
        "wl-1.phaifc=0.08" \
        "wl-1.dm_plate_k2=${WL1_PLATE_K2}" \
        "wl-1.dm_plate_k4=${WL1_PLATE_K4}" \
        "wl-1.phasign=0" \
        "wl-1.report=${WL1_LINK}/wl1_report.txt" \
        "wl-1.nthread=4" \
        "wl-1.procinfo.loopcntMax=-1" \
        "wl-1.procinfo.triggermode=3" \
        "wl-1.procinfo.triggersname=csim_wfs_nir"
    milk-fps-runstart -q wl-1
    WL1_STREAM="wl1_layers"
    echo "[ao3k-scexao]   -> Phase 5a live mlt-windlayers ON (csim_wfs_nir + aol1_dmC -> wl1_layers, bg=${WL1_BG_ARG}, autocal=ON, in_pupgeom=${WL1_PUP_ARG#*=}, lam=${WL1_LAM}um, plate_k=${WL1_PLATE_K2}/${WL1_PLATE_K4})"
fi

if (( PREDICTIVE )); then
    sysmon.mark "pf_warmup" "Train & ramp PSOL predictive filters (${PF_MODE}, Stage 1 & Stage 2)"
    echo "[ao3k-scexao]   -> Enabling Stage-1 PSOL ${PF_MODE} predictive control" \
         "(order=${PF_ORDER}, B=${PF_BLOCKSIZE}, mix1=${PF_MIX})..."
    PF1_DMM="${PF_DMMODES1}"
    if [[ -z "${PF1_DMM}" && -n "${WL1_STREAM}" && -f "${STG1_ROOT}/conf/CMmodesDM.fits" ]]; then
        PF1_DMM="${STG1_ROOT}/conf/CMmodesDM.fits"
    fi
    PF1_MR_EN="OFF"
    PF1_MR_PO="OFF"
    if (( MR_DM1 )); then
        PF1_MR_EN="ON"
        PF1_MR_PO="ON"
    fi
    WFS_DARKSUB_EFF="OFF"
WFS_DARK_ADU_EFF="0.0"
WFS_NORMFLOOR_EFF="1.0"
if [[ -n "${WFS_DARK_ADU}" ]]; then
    WFS_DARKSUB_EFF="ON"
    WFS_DARK_ADU_EFF="${WFS_DARK_ADU}"
    WFS_NORMFLOOR_EFF="0.001"
fi
export CACAO_WFS_DARKSUB="${WFS_DARKSUB_EFF}"
export CACAO_WFS_DARK_ADU="${WFS_DARK_ADU_EFF}"
export CACAO_WFS_NORMFLOOR="${WFS_NORMFLOOR_EFF}"
export CACAO_SELFLEARN_ENABLE="${SELFLEARN}"
export CACAO_SELFLEARN_MODES="${SELFLEARN_MODES}"
export CACAO_SELFLEARN_KMAX="${SELFLEARN_KMAX}"

CACAO_LOOPROOTDIR="${STG1_ROOT}" \
    CACAO_LOOPMULT="${MULT1}" \
    CACAO_LOOPMULT_TT="${MULT_TT}" \
    CACAO_MMULT_FLOOR="${MMULT_FLOOR}" \
    CACAO_MMULT_ALPHA="${MMULT_ALPHA}" \
    CACAO_PF_MODE="${PF_MODE}" \
    CACAO_PF_BLOCKSIZE="${PF_BLOCKSIZE}" \
    CACAO_PF_ORDER="${PF_ORDER}" \
    CACAO_PF_REG="${PF_REG}" \
    CACAO_PF_MAXNORM2="${PF_MAXNORM2}" \
    CACAO_PF_MIX_TT="${PF_MIX_TT}" \
    CACAO_PF_LO_NMODE="${PF_LO_NMODE}" \
    CACAO_PF_DIFF_NMODE="${PF_DIFF_NMODE}" \
    CACAO_PF_DIFF_ORDER="${PF_DIFF_ORDER}" \
    CACAO_PF_DIFF_REG="${PF_DIFF_REG}" \
    CACAO_PF_DIFF_MAXNORM2="${PF_DIFF_MAXNORM2}" \
    CACAO_PF_DIFF_MAXDCGAIN="${PF_DIFF_MAXDCGAIN}" \
    CACAO_PF_NBTRAIN="${PF_NBTRAIN1}" \
    CACAO_PF_MINSAMPLES="${PF_MINSAMPLES1}" \
    CACAO_PF_DIAGMINSAMPLES="${STG1_PF_DIAGMIN}" \
    CACAO_PF_UPDATEPERIOD="${STG1_PF_UPD}" \
    CACAO_PF_MGAIN_EXP="${PF_MGAIN_EXP}" \
    CACAO_PF_ZOH_RIDGE="${PF_ZOH_RIDGE}" \
    CACAO_PF_GRAM_HALFLIFE="${PF_GRAM_HALFLIFE}" \
    CACAO_PF_REGIME_KMAX="${PF_REGIME_KMAX}" \
    CACAO_PF_DM_KERNEL="${PF_FX1_EFF}" \
    CACAO_PF_WL_LAYERS="${WL1_STREAM}" \
    CACAO_PF_DMMODES="${PF1_DMM}" \
    CACAO_PF_PUP_DIAM="7.95" \
    CACAO_PF_DM_DX="0.1325" \
    CACAO_PF_FRATE_HZ="${WFS1_RATE}.0" \
    CACAO_PF_N_PRIOR="${PF_N_PRIOR}" \
    CACAO_PF_WL_SWITCH_DECAY="${PF_WL_SWITCH_DECAY}" \
    CACAO_PF_MR_ENABLE="${PF1_MR_EN}" \
    CACAO_PF_MR_SUBSTEPS="${MR_SUBSTEPS}" \
    CACAO_PF_MR_VELGAIN="${MR_VEL_GAIN}" \
    CACAO_PF_MR_VEL_REG_MULT="${MR_VEL_REG_MULT}" \
    CACAO_PF_MR_PACER_OUT="${PF1_MR_PO}" \
        "${LOOP_CTRL}" --stage 1 pf-on "${PF_MIX}"
    milk-stream-wait -q -t 180 "aol1_${PF_MAT_SFX}+1"
fi

# Optional Phase 4: Live mid-run 2WFS1DM (ivdiff) -> live Stage-2 mWFSfact + WFSzpogain
# Runs while Stage-1 PF is already active (preventing Stage-1 spider petaling) and Stage-2
# is in integrator lock (maximizing usable DM2 signal for Stage-2 optical-gain calibration).
LIVE_2WFS_TICKS="$(awk -v s="${LIVE_2WFS1DM_SEC}" 'BEGIN { printf "%d", int(s * 2000.0 + 0.5) }')"
if (( LIVE_2WFS_TICKS > 0 )) && command -v milk-mlt-calib2wfs1dm >/dev/null 2>&1; then
    echo "[ao3k-scexao]   -> Phase 4 live 2WFS1DM burst (${LIVE_2WFS1DM_SEC} s)..."
    L2_DIR="${WORK_ROOT}/live2wfs_tlm"
    L2_OUT="${OUT_DIR}/live_2wfs1dm"
    mkdir -p "${L2_DIR}" "${L2_OUT}"
    ln -sfn "${L2_DIR}" "/tmp/.l2tlm_$$"
    l2_n1=$(( LIVE_2WFS_TICKS / WFS1_DECIM + 64 ))
    l2_n2=$(( LIVE_2WFS_TICKS + 128 ))
    for _pair in "l2_a:aol1_modevalWFS:${l2_n1}" "l2_b:aol2_modevalWFS:${l2_n2}" \
                 "l2_d:aol2_modevalDM:${l2_n2}"; do
        IFS=':' read -r _u _s _n <<< "${_pair}"
        milk-fps-rm -f -q --ignore-missing "${_u}" >/dev/null 2>&1 || true
        milk-fps-init -q "${_u}" milk-fpsexec-mem-streamFITSlog >/dev/null
        milk-fps-set -q "${_u}.sname=${_s}" "${_u}.dirname=/tmp/.l2tlm_$$" \
            "${_u}.cubesize=${_n}" "${_u}.maxframecnt=${_n}" "${_u}.maxfilecnt=4" \
            "${_u}.zslice=-1" "${_u}.saveON=ON" "${_u}.procinfo.loopcntMax=-1" \
            "${_u}.procinfo.triggermode=3" "${_u}.procinfo.triggersname=${_s}" \
            "${_u}.procinfo.triggertimeout=0.5"
    done
    milk-fps-runstart -q l2_a l2_b l2_d
    milk-stream-wait -q -t 90 "csim_wfs_vis+${LIVE_2WFS_TICKS}"
    milk-fps-set -q l2_a.saveON=OFF l2_b.saveON=OFF l2_d.saveON=OFF >/dev/null 2>&1 || true
    sleep 0.6
    milk-fps-runstop -q l2_a l2_b l2_d >/dev/null 2>&1 || true
    milk-fps-wait -q -t 30 l2_a l2_b l2_d >/dev/null 2>&1 || true
    milk-fps-rm -f -q --ignore-missing l2_a l2_b l2_d >/dev/null 2>&1 || true
    rm -f "/tmp/.l2tlm_$$"
    cat > "${L2_DIR}/telemetry_manifest.env" <<EOF
TLM_FS1="${WFS1_RATE}.0"
TLM_FS2="2000.0"
EOF
    L2_KARG=""
    [[ -n "${DYNPSOL2_EFF}" && -f "${DYNPSOL2_EFF}" ]] && L2_KARG=".dm_kernel=${DYNPSOL2_EFF}"
    L2_NA=$(( SYSID_MODES * 4 ))
    (( L2_NA < 160 )) && L2_NA=160
    OMP_NUM_THREADS=16 OPENBLAS_NUM_THREADS=1 \
        milk-mlt-calib2wfs1dm "${L2_DIR}" "${L2_OUT}" \
        aol1_modevalWFS aol2_modevalWFS aol2_modevalDM \
        "${L2_NA}" "${SYSID_MODES}" "${SYSID_MODES}" auto auto 4 0.02 0.70 "" "" \
        ".method=ivdiff" ".b_offset_us=${CLOCK_SKEW_US:-0.0}" ${L2_KARG} >/dev/null 2>&1 || true
    if [[ -f "${L2_OUT}/sysid_summary.txt" ]]; then
        l2_app_msg="$(milk-cli -q -e -o -c "mlt.apply2wfs1dm '${L2_OUT}' 2" 2>&1 || true)"
        l2_g="$(awk -F= '/^mdb_diag_med=/{print $2}' "${L2_OUT}/sysid_summary.txt" || echo "?")"
        l2_u="$(awk -F= '/^usable_med=/{print $2}' "${L2_OUT}/sysid_summary.txt" || echo "?")"
        l2_ok="$(awk -F= '/^usable_ok=/{print $2}' "${L2_OUT}/sysid_summary.txt" || echo "0")"
        echo "[ao3k-scexao]      Live 2WFS1DM: g2_med=${l2_g} usable=${l2_u} ok=${l2_ok}"
        [[ -n "${l2_app_msg}" ]] && echo "[ao3k-scexao]      ${l2_app_msg}"
    fi
    if (( ONLINE_OG1 )); then
        _ogm=1 _ognv=0 _ogsnr=0
        @get _ogm="f.modalog-1.out.og_med" _ognv="f.modalog-1.out.n_valid_modes" \
             _ogsnr="f.modalog-1.out.snr_med" 2>/dev/null || true
        echo "[ao3k-scexao]      Stage-1 modalog (pre-PF2): og_med=${_ogm} n_valid=${_ognv} snr=${_ogsnr}"
    fi
fi

if (( PREDICTIVE )); then
    if (( ENABLE_STAGE2 )); then
        echo "[ao3k-scexao]   -> Enabling Stage-2 PSOL ${PF_MODE} predictive control" \
             "(order=${PF_ORDER}, B=${PF_BLOCKSIZE}, mix2=${PF_MIX2})..."
        PF_ZOH_RIDGE2_EFF="${PF_ZOH_RIDGE2:-${PF_ZOH_RIDGE}}"
        CACAO_LOOPROOTDIR="${STG2_ROOT}" \
        CACAO_PF_MODE="${PF_MODE}" \
        CACAO_PF_BLOCKSIZE="${PF_BLOCKSIZE}" \
        CACAO_PF_ORDER="${PF_ORDER}" \
        CACAO_PF_REG="${PF_REG2}" \
        CACAO_PF_MAXNORM2="${PF_MAXNORM2}" \
        CACAO_PF_NBTRAIN="${PF_NBTRAIN2}" \
        CACAO_PF_MINSAMPLES="${PF_MINSAMPLES2}" \
        CACAO_PF_MGAIN_EXP="${PF_MGAIN_EXP2}" \
        CACAO_PF_ZOH_RIDGE="${PF_ZOH_RIDGE2_EFF}" \
        CACAO_PF_GRAM_HALFLIFE="${PF_GRAM_HALFLIFE}" \
        CACAO_PF_REGIME_KMAX="${PF_REGIME_KMAX}" \
        CACAO_PF_DM_KERNEL="${PF_FX2_EFF}" \
        CACAO_PF_FRATE_HZ="2000.0" \
        CACAO_PF_N_PRIOR="0.0" \
            "${LOOP_CTRL}" --stage 2 pf-on "${PF_MIX2}"
        milk-stream-wait -q -t 180 "aol2_${PF_MAT_SFX}+2"
    fi
    milk-stream-wait -q -t 30 "csim_wfs_vis+160"

    PF_WARMUP_TICKS="$(awk -v s="${PF_WARMUP_SEC}" 'BEGIN { printf "%d", int(s * 2000.0 + 0.5) }')"
    if (( PF_WARMUP_TICKS > 0 )); then
        echo "[ao3k-scexao]   -> Running ${PF_WARMUP_SEC} s (${PF_WARMUP_TICKS} ticks)" \
             "closed-loop PSOL training warmup..."
        w_rem="${PF_WARMUP_TICKS}"
        w_done=0
        while (( w_rem > 0 )); do
            w_step=$(( w_rem < 4000 ? w_rem : 4000 ))
            milk-stream-wait -q -t 180 "csim_wfs_vis+${w_step}"
            w_rem=$(( w_rem - w_step ))
            w_done=$(( w_done + w_step ))
            w_sec="$(awk -v d="${w_done}" 'BEGIN { printf "%.1f", d / 2000.0 }')"
            ns1=0 ns2=0 vr1=0 vr2=0 ea1=0 ea2=0
            @get ns1="f.${PF_MK_PFX}-1.out.n_samples" ns2="f.${PF_MK_PFX}-2.out.n_samples" \
                 vr1="f.${PF_MK_PFX}-1.out.var_red_pct" vr2="f.${PF_MK_PFX}-2.out.var_red_pct" \
                 2>/dev/null || true
            if [[ "${PF_MODE}" == "eof" ]]; then
                @get ea1="f.${PF_MK_PFX}-1.out.eof_active" \
                     ea2="f.${PF_MK_PFX}-2.out.eof_active" 2>/dev/null || true
                echo "[ao3k-scexao]      warmup t=${w_sec}/${PF_WARMUP_SEC}s |" \
                     "Stg1: N=${ns1} state=${ea1} dVar=${vr1}% |" \
                     "Stg2: N=${ns2} state=${ea2} dVar=${vr2}%"
            else
                echo "[ao3k-scexao]      warmup t=${w_sec}/${PF_WARMUP_SEC}s |" \
                     "Stg1: N=${ns1} dVar=${vr1}% | Stg2: N=${ns2} dVar=${vr2}%"
            fi
            if (( PETAL_CTRL_ACTIVE )) && (( PETAL_WAIT_EOF )); then
                _ns1_int="${ns1%.*}"
                if [[ "${PF_MODE}" != "eof" ]] || { [[ "${ea1}" == "2" ]] && (( ${_ns1_int:-0} >= 3000 )); }; then
                    @calc "s.aol1_petal_ema = s.aol1_petal_ema * 0.0"
                    milk-fps-set -q "petal-1.age_fr=0" "petal-1.enable=1"
                    PETAL_WAIT_EOF="0"
                    echo "[ao3k-scexao]      -> Stage-1 Passive Petal Unwrapper ENABLED (EOF converged N=${ns1}, warmup t=${w_sec}/${PF_WARMUP_SEC}s)"
                fi
            fi
        done
        if [[ "${PF_MODE}" == "eof" ]]; then
            for _wait_i in $(seq 1 30); do
                ea1=0 ea2=0
                @get ea1="f.${PF_MK_PFX}-1.out.eof_active" \
                     ea2="f.${PF_MK_PFX}-2.out.eof_active" 2>/dev/null || true
                if [[ "${ea1}" == "2" ]] && { (( ! ENABLE_STAGE2 )) || [[ "${ea2}" == "2" ]]; }; then
                    break
                fi
                milk-stream-wait -q -t 30 "csim_wfs_vis+256"
            done
        fi
        if (( PETAL_CTRL_ACTIVE )) && (( PETAL_WAIT_EOF )); then
            @calc "s.aol1_petal_ema = s.aol1_petal_ema * 0.0"
            milk-fps-set -q "petal-1.age_fr=0" "petal-1.enable=1"
            PETAL_WAIT_EOF="0"
            echo "[ao3k-scexao]      -> Stage-1 Passive Petal Unwrapper ENABLED (post-warmup)"
        fi
        milk-stream-wait -q -t 30 "csim_wfs_vis+160"
    fi
fi
if (( EXPORT_BEAMS_NEEDED )) && [[ "${BENCH_MODE}" == "fused" ]]; then
    @set "f.csim_htsim.export_enable=ON"
fi
milk-stream-wait -q -t 30 "csim_wfs_vis+100"

# Throttle master turbulence clock (without restarting csim_atmturb, preserving continuous
# frozen-flow phase screens and avoiding 2*pi spider-island petal jumps) while arming wfstat:
WFSTAT_CPU_DIR="${OUT_DIR}"
milk-fps-set -q "csim_atmturb.procinfo.triggerdelay=0.05"
sleep 0.08
rm -f "${OUT_DIR}/wf_stats.json"
WFSTAT_CLIP_START=0
WFSTAT_CLIP_LEN=0
WFSTAT_FULL_FPS="0"
if [[ "${SAVE_TELEMETRY}" != "none" ]]; then
    WFSTAT_CLIP_LEN=460
    WFSTAT_FULL_FPS="30"
    if (( MASTER_TICKS >= 10500 )); then
        WFSTAT_CLIP_START=9970
    elif (( MASTER_TICKS > WFSTAT_CLIP_LEN )); then
        WFSTAT_CLIP_START=$(( (MASTER_TICKS - WFSTAT_CLIP_LEN) / 2 + 1 ))
    else
        WFSTAT_CLIP_START=1
        WFSTAT_CLIP_LEN="${MASTER_TICKS}"
    fi
fi
if [[ "${BENCH_MODE}" == "fused" ]]; then
    ln -sfn "${OUT_DIR}" "${WFSTAT_LINK}"
    declare -a WFSTAT_CM_ARGS=("csim_htsim.wfstat_cm1=aol1_CMmodesDM")
    (( ENABLE_STAGE2 )) && WFSTAT_CM_ARGS+=("csim_htsim.wfstat_cm2=aol2_CMmodesDM")
    milk-fps-set -q \
        "csim_htsim.wfstat_outdir=${WFSTAT_LINK}" \
        "csim_htsim.wfstat_ticks=${MASTER_TICKS}" \
        "csim_htsim.wfstat_extra=ON" \
        "csim_htsim.wfstat_clip_start=${WFSTAT_CLIP_START}" \
        "csim_htsim.wfstat_clip_len=${WFSTAT_CLIP_LEN}" \
        "csim_htsim.wfstat_full_fps=${WFSTAT_FULL_FPS}" \
        "${WFSTAT_CM_ARGS[@]}"
    @set "f.csim_htsim.wfstat_enable=ON"
    (( CPU_WFSTAT )) && WFSTAT_CPU_DIR="${OUT_DIR}/wfstat_cpu"
fi
if (( CPU_WFSTAT )); then
    CPU_WF_TICKS="${MASTER_TICKS}"
    CPU_WF_DT="0.0005"
    CPU_CLIP_START="${WFSTAT_CLIP_START}"
    CPU_CLIP_LEN="${WFSTAT_CLIP_LEN}"
    CPU_FULL_FPS="${WFSTAT_FULL_FPS}"
    if [[ "${BENCH_MODE}" == "modular" ]] && (( EFF_OV > 1 )); then
        CPU_WF_TICKS=$(( MASTER_TICKS * EFF_OV ))
        CPU_WF_DT="$(awk -v k="${EFF_OV}" 'BEGIN { printf "%.8f", 0.0005 / k }')"
        CPU_CLIP_START=$(( WFSTAT_CLIP_START * EFF_OV ))
        CPU_CLIP_LEN=$(( WFSTAT_CLIP_LEN * EFF_OV ))
    fi
    if [[ "${BENCH_MODE}" == "fused" ]]; then
        CPU_CLIP_START=0
        CPU_CLIP_LEN=0
        CPU_FULL_FPS="0"
    fi
    mkdir -p "${WFSTAT_CPU_DIR}"
    rm -f "${WFSTAT_CPU_DIR}/wf_stats.json"
    ln -sfn "${WFSTAT_CPU_DIR}" "${WFSTAT_CPU_LINK}"
    milk-fps-rm -f -q --ignore-missing csim_wfstat >/dev/null 2>&1 || true
    milk-fps-init -q csim_wfstat milk-fpsexec-cacaosim-wfstat >/dev/null
    milk-fps-set -q \
        "csim_wfstat.trig_beam=b_post_stg2" \
        "csim_wfstat.beam_raw=b_pup" \
        "csim_wfstat.beam_stg1=b_post_stg1" \
        "csim_wfstat.beam_final=b_post_stg2" \
        "csim_wfstat.outdir=${WFSTAT_CPU_LINK}" \
        "csim_wfstat.target_ticks=${CPU_WF_TICKS}" \
        "csim_wfstat.dt_phys=${CPU_WF_DT}" \
        "csim_wfstat.snap_extra=ON" \
        "csim_wfstat.clip_start=${CPU_CLIP_START}" \
        "csim_wfstat.clip_len=${CPU_CLIP_LEN}" \
        "csim_wfstat.full_fps=${CPU_FULL_FPS}" \
        "csim_wfstat.procinfo.loopcntMax=${CPU_WF_TICKS}" \
        "csim_wfstat.procinfo.triggermode=3" \
        "csim_wfstat.procinfo.triggersname=b_post_stg2"
    milk-fps-runstart -q csim_wfstat
fi

start_tlm_loggers

if (( PYRWFS_TLM )) && command -v cacao-fpsexec-pyrwfstlm >/dev/null 2>&1 && \
   @exists "s.aol1_pyr_ref" && @exists "s.aol2_pyr_ref"; then
    ln -sfn "${OUT_DIR}" "${PYRTLM_LINK}"
    if [[ -n "${PYRWFS_STRIDE}" ]]; then
        PYR_STRIDE1="${PYRWFS_STRIDE}"
    else
        PYR_STRIDE1=$(( (WFS1_RATE + 100) / 200 ))
    fi
    (( PYR_STRIDE1 < 1 )) && PYR_STRIDE1=1
    PYR_STRIDE2=$(( PYR_STRIDE1 * 2000 / WFS1_RATE ))
    (( PYR_STRIDE2 < 1 )) && PYR_STRIDE2=1
    PYR_REG_STRIDE=20
    PYR_DT1="$(awk -v r="${WFS1_RATE}" 'BEGIN { printf "%.8f", 1.0 / r }')"
    PYR_DT2="0.0005"
    PYR_BIAS_ADU="${WFS_DARK_ADU:-100.0}"

    milk-fps-rm -f -q --ignore-missing pyrwfstlm-1 pyrwfstlm-2 >/dev/null 2>&1 || true
    milk-fps-init -q pyrwfstlm-1 cacao-fpsexec-pyrwfstlm >/dev/null
    milk-fps-set -q \
        "pyrwfstlm-1.AOloopindex=1" \
        "pyrwfstlm-1.inwfs=csim_wfs_nir" \
        "pyrwfstlm-1.inref=aol1_pyr_ref" \
        "pyrwfstlm-1.outprefix=aol1_pyr" \
        "pyrwfstlm-1.outcsv=${PYRTLM_LINK}/pyrwfs_tlm_stg1.csv" \
        "pyrwfstlm-1.dt_phys=${PYR_DT1}" \
        "pyrwfstlm-1.stride=${PYR_STRIDE1}" \
        "pyrwfstlm-1.reg_stride=${PYR_REG_STRIDE}" \
        "pyrwfstlm-1.sub_bg=OFF" \
        "pyrwfstlm-1.bg_const=${PYR_BIAS_ADU}" \
        "pyrwfstlm-1.a_reg=0.04" \
        "pyrwfstlm-1.pub_maps=ON" \
        "pyrwfstlm-1.sp_ang=51.75" \
        "pyrwfstlm-1.sp_hw=2.0" \
        "pyrwfstlm-1.procinfo.triggermode=3" \
        "pyrwfstlm-1.procinfo.triggersname=csim_wfs_nir" \
        "pyrwfstlm-1.procinfo.triggertimeout=0.5" \
        "pyrwfstlm-1.procinfo.loopcntMax=-1"

    milk-fps-init -q pyrwfstlm-2 cacao-fpsexec-pyrwfstlm >/dev/null
    milk-fps-set -q \
        "pyrwfstlm-2.AOloopindex=2" \
        "pyrwfstlm-2.inwfs=csim_wfs_vis" \
        "pyrwfstlm-2.inref=aol2_pyr_ref" \
        "pyrwfstlm-2.outprefix=aol2_pyr" \
        "pyrwfstlm-2.outcsv=${PYRTLM_LINK}/pyrwfs_tlm_stg2.csv" \
        "pyrwfstlm-2.dt_phys=${PYR_DT2}" \
        "pyrwfstlm-2.stride=${PYR_STRIDE2}" \
        "pyrwfstlm-2.reg_stride=${PYR_REG_STRIDE}" \
        "pyrwfstlm-2.sub_bg=OFF" \
        "pyrwfstlm-2.bg_const=${PYR_BIAS_ADU}" \
        "pyrwfstlm-2.a_reg=0.04" \
        "pyrwfstlm-2.pub_maps=ON" \
        "pyrwfstlm-2.sp_ang=51.75" \
        "pyrwfstlm-2.sp_hw=2.0" \
        "pyrwfstlm-2.procinfo.triggermode=3" \
        "pyrwfstlm-2.procinfo.triggersname=csim_wfs_vis" \
        "pyrwfstlm-2.procinfo.triggertimeout=0.5" \
        "pyrwfstlm-2.procinfo.loopcntMax=-1"

    milk-fps-runstart -q pyrwfstlm-1 pyrwfstlm-2
    milk-stream-wait -q -t 10 aol1_pyr_zones aol2_pyr_zones >/dev/null 2>&1 || true
    PYRWFS_TLM_ACTIVE="1"
    echo "[ao3k-scexao]      Armed live Pyramid WFS monitors (pyrwfstlm-1 stride=${PYR_STRIDE1}, pyrwfstlm-2 stride=${PYR_STRIDE2})"
fi

cnt_pha_0=0 cnt_wfs1_0=0 cnt_wfs2_0=0 cnt_wfs3_0=0 cnt_long_0=0
@get cnt_pha_0="s.outarraypha.cnt0" cnt_wfs1_0="s.csim_wfs_nir.cnt0" \
     cnt_wfs2_0="s.csim_wfs_vis.cnt0" cnt_wfs3_0="s.csim_wfs_lowfs.cnt0" \
     cnt_long_0="s.psf_vis_final_long.cnt0"

PETAL_INJ_DONE="0"
PETAL_INJ_P=""
PETAL_INJ_W=""
PETAL_INJ_NM="0.0"
PETAL_INJ_T="0.0"
if [[ -n "${PETAL_TEST_INJECT}" ]]; then
    _pinj_pw="${PETAL_TEST_INJECT%%@*}"
    if [[ "${PETAL_TEST_INJECT}" == *@* ]]; then
        PETAL_INJ_T="${PETAL_TEST_INJECT#*@}"
    fi
    PETAL_INJ_P="${_pinj_pw%%:*}"
    PETAL_INJ_W="${_pinj_pw#*:}"
    _peq_nm="1205.362"
    if [[ -n "${PETAL_CAL_DIR:-}" && -f "${PETAL_CAL_DIR}/petal_ctrl_meta.json" ]]; then
        _peq_nm="$("${PYTHON_BIN:-python3}" -c \
            "import json; print(f\"{float(json.load(open('${PETAL_CAL_DIR}/petal_ctrl_meta.json')).get('p_eq_um', 1.205362))*1000.0:.3f}\")" 2>/dev/null || echo "1205.362")"
    fi
    PETAL_INJ_NM="$(awk -v w="${PETAL_INJ_W}" -v peq="${_peq_nm}" 'BEGIN { printf "%.3f", w * peq }')"
fi
if [[ -n "${PETAL_INJ_P}" ]] && \
   awk -v t="${PETAL_INJ_T}" 'BEGIN { exit !(t <= 1e-6) }'; then
    # Inject +w * p_eq directly onto the entrance-pupil thermal LWE engine (csim_htsim/csim_mkbeam)
    @set "f.${MASTER_UNIT}.petal_off${PETAL_INJ_P}_nm=${PETAL_INJ_NM}"
    if (( PETAL_CTRL_ACTIVE )); then
        @calc "s.aol1_petal_ema = s.aol1_petal_ema * 0.0"
        milk-fps-set -q "petal-1.age_fr=0"
    fi
    PETAL_INJ_DONE="1"
    echo "[ao3k-scexao]      Injected deterministic ${PETAL_INJ_W} lambda_J (${PETAL_INJ_NM} nm) LWE petal step on petal ${PETAL_INJ_P} at t_phys = 0.00 s via ${MASTER_UNIT}.petal_off${PETAL_INJ_P}_nm"
fi
if (( PETAL_CTRL_ACTIVE )) && [[ "${PETAL_ENABLE_AT}" == "science" ]]; then
    @calc "s.aol1_petal_ema = s.aol1_petal_ema * 0.0"
    milk-fps-set -q "petal-1.age_fr=0" "petal-1.enable=1"
    echo "[ao3k-scexao]      Enabled petal-1 passive unwrapper at t_phys = 0.00 s"
fi

cacaosim.reset_long
sysmon.mark "closed_loop_10s" "10s closed-loop science + coro + wavefront telemetry (${BENCH_MODE})"
t_int_0="$(date +%s.%N)"
milk-fps-set -q "csim_atmturb.procinfo.triggerdelay=${ATM_TRIG_DT}"

rem="${LONG_READOUTS}"
done_rd=0
WIND_SWITCHED="0"
chunk=$(( (2000 + EFF_PSF_NAVG - 1) / EFF_PSF_NAVG ))
(( chunk < 1 )) && chunk=1
while (( rem > 0 )); do
    step=$(( rem < chunk ? rem : chunk ))
    milk-stream-wait -q -t 180 "psf_vis_final_long+${step}"
    rem=$(( rem - step ))
    done_rd=$(( done_rd + step ))
    phys_done="$(awk -v d="${done_rd}" -v nv="${EFF_PSF_NAVG}" \
        'BEGIN { printf "%.2f", d * nv * 0.0005 }')"
    if (( ! PETAL_INJ_DONE )) && [[ -n "${PETAL_INJ_P}" ]] && \
       awk -v p="${phys_done}" -v tinj="${PETAL_INJ_T}" 'BEGIN { exit !(tinj > 0 && p + 0.01 >= tinj) }'; then
        @set "f.${MASTER_UNIT}.petal_off${PETAL_INJ_P}_nm=${PETAL_INJ_NM}"
        PETAL_INJ_DONE="1"
        echo "[ao3k-scexao]   -> SUDDEN LWE PETAL STEP INJECTED: ${PETAL_INJ_W} lambda_J (${PETAL_INJ_NM} nm) on petal ${PETAL_INJ_P} at t_phys=${phys_done} s via ${MASTER_UNIT}.petal_off${PETAL_INJ_P}_nm"
    fi
    if (( ! WIND_SWITCHED )) && \
       awk -v p="${phys_done}" -v sw="${WIND_SWITCH_SEC}" 'BEGIN { exit !(sw > 0 && p + 0.01 >= sw) }'; then
        @set "f.csim_atmturb.wind_rot_deg=${WIND_SWITCH_DEG}"
        WIND_SWITCHED="1"
        echo "[ao3k-scexao]   -> LIVE PHASE-CONTINUOUS WIND SWITCH: +${WIND_SWITCH_DEG} deg at t_phys=${phys_done} s"
    fi
    s1="" s2="" sv="" sc="" fl=""
    if [[ "${BENCH_MODE}" == "modular" ]]; then
        @get s1="f.csim_nir_stg1.strehl_ave" s2="f.csim_nir_final.strehl_ave" \
             sv="f.csim_vis_final.strehl_ave" sc="f.csim_nir_coro.strehl_ave"
    else
        @get s1="s.psf_nir_stg1_long.kw.STREHL" s2="s.psf_nir_final_long.kw.STREHL" \
             sv="s.psf_vis_final_long.kw.STREHL" sc="s.psf_nir_coro_long.kw.STREHL" \
             fl="s.coro_pre_lyot_long.kw.F_LOWFS" 2>/dev/null || true
        [[ -z "${sv}" ]] && @get sv="f.csim_htsim.strehl_ave" 2>/dev/null || true
    fi
    fl_pct="$(awk -v x="${fl:-0}" 'BEGIN { printf "%.1f%%", x * 100.0 }')"
    sr_live="$(printf 'NIR=%.3f Vis=%.3f Coro=%.2e LOWFS_Light=%s' \
        "${s2:-0}" "${sv:-0}" "${sc:-0}" "${fl_pct}")"
    if (( PETAL_CTRL_ACTIVE )); then
        _pj=0 _pwe=0 _pwn=0 _pww=0 _pws=0 _pev=0 _psg=0
        @get _pj="f.petal-1.n_jumps" _pwe="f.petal-1.w_e" _pwn="f.petal-1.w_n" \
             _pww="f.petal-1.w_w" _pws="f.petal-1.w_s" _pev="f.petal-1.ev_sn" \
             _psg="f.petal-1.sg_s" 2>/dev/null || true
        sr_live="${sr_live} $(printf 'Petal[j=%d w=(%.0f,%.0f,%.0f,%.0f) evSN=%+.2f sgS=%+.2f]' \
            "${_pj:-0}" "${_pwe:-0}" "${_pwn:-0}" "${_pww:-0}" "${_pws:-0}" "${_pev:-0}" "${_psg:-0}")"
    fi
    echo "[ao3k-scexao]      t_phys = ${phys_done} / ${PHYS_TIME} s  (${sr_live})"
done

t_int_1="$(date +%s.%N)"
cnt_pha_1=0 cnt_wfs1_1=0 cnt_wfs2_1=0 cnt_wfs3_1=0 cnt_long_1=0
@get cnt_pha_1="s.outarraypha.cnt0" cnt_wfs1_1="s.csim_wfs_nir.cnt0" \
     cnt_wfs2_1="s.csim_wfs_vis.cnt0" cnt_wfs3_1="s.csim_wfs_lowfs.cnt0" \
     cnt_long_1="s.psf_vis_final_long.cnt0"

# In fused mode, csim_htsim auto-writes its in-DAG statistics after exactly MASTER_TICKS
# frames; keep the clock running until it reports completion (it only iterates on ticks).
if [[ "${BENCH_MODE}" == "fused" ]]; then
    wf_n=0
    for _ in $(seq 1 600); do
        @get wf_n="f.csim_htsim.wfstat_frames"
        (( wf_n >= MASTER_TICKS )) && [[ -s "${OUT_DIR}/wf_stats.json" ]] && break
        sleep 0.05
    done
fi

# Close closed_loop_10s phase BEFORE throttling csim_atmturb or flushing loggers so
# 50 ms throttle pauses and logger teardown do not pollute closed-loop jitter or duration.
sysmon.mark "flush_tlm" "Stop loggers & flush closed-loop telemetry"

# Throttle master turbulence clock (preserving continuous phase screen for selfRM) while saving
if (( RUN_SELFRM )); then
    milk-fps-set -q "csim_atmturb.procinfo.triggerdelay=0.05"
else
    milk-fps-runstop -q csim_atmturb
fi
sleep 0.15
if [[ "${BENCH_MODE}" == "fused" ]]; then
    @set "f.csim_htsim.wfstat_enable=OFF"
    (( EXPORT_BEAMS_NEEDED )) && @set "f.csim_htsim.export_enable=OFF"
fi
VTT_CMD_X_MAS="0.0"
VTT_CMD_Y_MAS="0.0"
VTT_ERR_X_MAS="0.0"
VTT_ERR_Y_MAS="0.0"
VTT_N_STEPS="0"
if (( VIS_TTM_ACTIVE )); then
    @set "f.vis_tt-2.enable=0" >/dev/null 2>&1 || true
    milk-fps-runstop -q vis_tt-2 >/dev/null 2>&1 || true
    milk-fps-wait -q -t 15 vis_tt-2 >/dev/null 2>&1 || true
    @get VTT_CMD_X_MAS="f.vis_tt-2.cmd_x_mas" VTT_CMD_Y_MAS="f.vis_tt-2.cmd_y_mas" \
         VTT_ERR_X_MAS="f.vis_tt-2.err_x_mas" VTT_ERR_Y_MAS="f.vis_tt-2.err_y_mas" \
         VTT_N_STEPS="f.vis_tt-2.n_steps" 2>/dev/null || true
fi
if @exists "s.dm_vis_pyrwfs_tt"; then
    fpspipe.savefits "dm_vis_pyrwfs_tt" "${OUT_DIR}/dm_vis_pyrwfs_tt.fits"
fi
if @exists "s.ao188_adc_state"; then
    fpspipe.savefits "ao188_adc_state" "${OUT_DIR}/ao188_adc_state.fits"
    "${PYTHON_BIN:-python3}" - "${OUT_DIR}/ao188_adc_state.fits" "${OUT_DIR}/adc_meta.json" \
        "${ZENITH_DEG}" "${DISP_PA_DEG}" "${IMR_MODE}" "${PARALLACTIC_RATE_DPS}" \
        "${ADC_PRESET}" "${ADC_MODE}" "${ADC_OPT_BAND}" "${ADC_MECH}" \
        "${ADC_LUT_SC_ERR:-0.0}" "${ADC_LUT_PA_ERR:-0.0}" \
        "${CHROM_TURB}" "${CHROM_LAMBDAS}" \
        "${OUT_DIR}/dm_vis_pyrwfs_tt.fits" "${VIS_TTM_MODE}" "${VIS_TTM_GAIN}" "${VIS_TTM_ACTIVE}" \
        "${VTT_ERR_X_MAS}" "${VTT_ERR_Y_MAS}" "${VTT_N_STEPS}" <<'PY'
import json, math, os, sys
import numpy as np
from astropy.io import fits

vec = np.asarray(fits.getdata(sys.argv[1]), dtype=np.float64).ravel().tolist()
while len(vec) < 10:
    vec.append(0.0)
ttm_um = [0.0, 0.0]
if os.path.isfile(sys.argv[15]):
    tv = np.asarray(fits.getdata(sys.argv[15]), dtype=np.float64).ravel().tolist()
    if len(tv) >= 2:
        ttm_um = [float(tv[0]), float(tv[1])]
mas_per_um = (4.0e-6 / 7.95) * 206264806.24709636
tx_mas = ttm_um[0] * mas_per_um
ty_mas = ttm_um[1] * mas_per_um
meta = {
    "schema_version": 1,
    "zenith_deg": float(sys.argv[3]),
    "disp_pa_deg": float(sys.argv[4]),
    "imr_mode": sys.argv[5],
    "parallactic_rate_dps": float(sys.argv[6]),
    "preset": sys.argv[7],
    "mode": sys.argv[8],
    "opt_band": sys.argv[9],
    "mech": sys.argv[10],
    "lut_scale_err": float(sys.argv[11]),
    "lut_pa_err_deg": float(sys.argv[12]),
    "chrom_turb": int(sys.argv[13]),
    "chrom_lambdas": sys.argv[14],
    "state": {
        "theta1_deg": vec[0],
        "theta2_deg": vec[1],
        "psi_deg": vec[2],
        "pa_deg": vec[3],
        "zenith_deg": vec[4],
        "deployed": int(round(vec[5])),
        "res_vis_mas": vec[6],
        "res_j_mas": vec[7],
        "res_h_mas": vec[8],
        "res_vis_h_mas": vec[9],
    },
    "vis_pyrwfs_ttm": {
        "mode": sys.argv[16],
        "gain": float(sys.argv[17]),
        "active": int(sys.argv[18]),
        "cmd_x_um": round(ttm_um[0], 6),
        "cmd_y_um": round(ttm_um[1], 6),
        "cmd_x_mas": round(tx_mas, 3),
        "cmd_y_mas": round(ty_mas, 3),
        "cmd_tot_mas": round(math.hypot(tx_mas, ty_mas), 3),
        "res_dm02_tt_x_mas": round(float(sys.argv[19]), 3),
        "res_dm02_tt_y_mas": round(float(sys.argv[20]), 3),
        "n_steps": int(float(sys.argv[21])),
    },
}
with open(sys.argv[2], "w", encoding="utf-8") as fh:
    json.dump(meta, fh, indent=2)
    fh.write("\n")
PY
fi
if (( CPU_WFSTAT )); then
    milk-fps-runstop -q csim_wfstat >/dev/null 2>&1 || true
    milk-fps-wait -q -t 30 csim_wfstat >/dev/null 2>&1 || true
fi
if (( PETAL_CTRL_ACTIVE )); then
    @set "f.petal-1.enable=0" >/dev/null 2>&1 || true
    milk-fps-runstop -q petal-1 >/dev/null 2>&1 || true
    milk-fps-wait -q -t 15 petal-1 >/dev/null 2>&1 || true
    p_nj=0 p_na=0 p_nr=0 p_lp=-1 p_ld=0 p_age=0 p_tp=-1 p_td=0
    p_evsn=0 p_evew=0 p_evad=0 p_sge=0 p_sgn=0 p_sgw=0 p_sgs=0
    p_we=0 p_wn=0 p_ww=0 p_ws=0 p_err=""
    @get p_nj="f.petal-1.n_jumps" p_na="f.petal-1.n_aborts" p_nr="f.petal-1.n_rollbacks" \
         p_lp="f.petal-1.last_petal" p_ld="f.petal-1.last_dir" \
         p_age="f.petal-1.age_fr" p_tp="f.petal-1.trial_p" p_td="f.petal-1.trial_dir" \
         p_evsn="f.petal-1.ev_sn" p_evew="f.petal-1.ev_ew" p_evad="f.petal-1.ev_adj" \
         p_sge="f.petal-1.sg_e" p_sgn="f.petal-1.sg_n" p_sgw="f.petal-1.sg_w" p_sgs="f.petal-1.sg_s" \
         p_we="f.petal-1.w_e" p_wn="f.petal-1.w_n" p_ww="f.petal-1.w_w" p_ws="f.petal-1.w_s" \
         p_err="f.petal-1.unit.error" 2>/dev/null || true
    if @exists "s.dm01disp06"; then
        fpspipe.savefits "dm01disp06" "${OUT_DIR}/dm01disp06.fits"
    fi
    if @exists "s.aol1_petal_ema"; then
        fpspipe.savefits "aol1_petal_ema" "${OUT_DIR}/aol1_petal_ema.fits"
    fi
    if @exists "s.aol1_petal_cmd"; then
        fpspipe.savefits "aol1_petal_cmd" "${OUT_DIR}/aol1_petal_cmd.fits"
    fi
    cat > "${OUT_DIR}/petal_stats.json" <<EOF
{
  "enabled": true,
  "use_sign": ${PETAL_USE_SIGN_EFF:-1},
  "alpha": ${PETAL_ALPHA},
  "min_warmup": ${PETAL_WARMUP},
  "th_even": ${PETAL_TH_EVEN},
  "th_sign": ${PETAL_TH_SIGN},
  "th_adj": 1.15,
  "g_opt_scale": ${PETAL_GOPT_EFF:-1.0},
  "enable_at": "${PETAL_ENABLE_AT}",
  "test_inject": "${PETAL_TEST_INJECT}",
  "n_jumps": ${p_nj:-0},
  "n_aborts": ${p_na:-0},
  "n_rollbacks": ${p_nr:-0},
  "last_petal": ${p_lp:--1},
  "last_dir": ${p_ld:-0},
  "age_fr": ${p_age:-0},
  "trial_p": ${p_tp:--1},
  "trial_dir": ${p_td:-0},
  "waves_enws": [${p_we:-0}, ${p_wn:-0}, ${p_ww:-0}, ${p_ws:-0}],
  "final_ema": {
    "ev_sn": ${p_evsn:-0},
    "ev_ew": ${p_evew:-0},
    "ev_adj": ${p_evad:-0},
    "sg_e": ${p_sge:-0},
    "sg_n": ${p_sgn:-0},
    "sg_w": ${p_sgw:-0},
    "sg_s": ${p_sgs:-0}
  },
  "unit_error": "${p_err}"
}
EOF
    echo "[ao3k-scexao]      Petal Ctrl final: n_jumps=${p_nj} (aborts=${p_na}, rollbacks=${p_nr}) waves(E,N,W,S)=(${p_we},${p_wn},${p_ww},${p_ws}) evSN=${p_evsn} sgS=${p_sgs} err='${p_err}'"
fi
if (( PYRWFS_TLM_ACTIVE )); then
    milk-fps-runstop -q pyrwfstlm-1 pyrwfstlm-2 >/dev/null 2>&1 || true
    milk-fps-wait -q -t 15 pyrwfstlm-1 pyrwfstlm-2 >/dev/null 2>&1 || true
    pyr1_fp0=0 pyr1_nf=0 pyr1_nt=0 pyr2_fp0=0 pyr2_nf=0 pyr2_nt=0
    @get pyr1_fp0="f.pyrwfstlm-1.flux.pup0" pyr1_nf="f.pyrwfstlm-1.health.nframes" \
         pyr1_nt="f.pyrwfstlm-1.health.ntorn" \
         pyr2_fp0="f.pyrwfstlm-2.flux.pup0" pyr2_nf="f.pyrwfstlm-2.health.nframes" \
         pyr2_nt="f.pyrwfstlm-2.health.ntorn" 2>/dev/null || true
    for _sn in 1 2; do
        for _mp in "isum_avg:isum" "scint:scint" "scint_debias:scint_debias" "lvar:lvar" "zones:zones" "pupgeom:pupgeom"; do
            _ss="${_mp%%:*}"
            _fo="${_mp#*:}"
            if @exists "s.aol${_sn}_pyr_${_ss}"; then
                fpspipe.savefits "aol${_sn}_pyr_${_ss}" "${OUT_DIR}/pyrwfs_${_fo}_stg${_sn}.fits"
            fi
        done
    done
    cat > "${OUT_DIR}/pyrwfs_tlm_meta.json" <<EOF
{
  "schema_version": 1,
  "spider_angle_deg": 51.75,
  "spider_halfwidth_pix": 2.0,
  "reg_stride": ${PYR_REG_STRIDE:-20},
  "bg_const_adu": ${PYR_BIAS_ADU:-100.0},
  "stage1": {
    "stream": "csim_wfs_nir",
    "loop_closed": true,
    "rate_hz": ${WFS1_RATE}.0,
    "stride": ${PYR_STRIDE1:-5},
    "dt_phys_s": ${PYR_DT1:-0.001},
    "mod_rad_override": "${WFS1_MOD_RAD}",
    "f_pup0": ${pyr1_fp0:-0},
    "nframes": ${pyr1_nf:-0},
    "ntorn": ${pyr1_nt:-0},
    "csv": "pyrwfs_tlm_stg1.csv"
  },
  "stage2": {
    "stream": "csim_wfs_vis",
    "loop_closed": $( (( ENABLE_STAGE2 )) && echo "true" || echo "false" ),
    "rate_hz": 2000.0,
    "stride": ${PYR_STRIDE2:-10},
    "dt_phys_s": ${PYR_DT2:-0.0005},
    "mod_rad_override": "${WFS2_MOD_RAD}",
    "f_pup0": ${pyr2_fp0:-0},
    "nframes": ${pyr2_nf:-0},
    "ntorn": ${pyr2_nt:-0},
    "csv": "pyrwfs_tlm_stg2.csv"
  }
}
EOF
    milk-fps-rm -f -q --ignore-missing pyrwfstlm-1 pyrwfstlm-2 >/dev/null 2>&1 || true
    rm -f "${PYRTLM_LINK}" >/dev/null 2>&1 || true
    echo "[ao3k-scexao]      Saved Pyramid WFS telemetry (Stg1 N=${pyr1_nf}, f_pup0=${pyr1_fp0}; Stg2 N=${pyr2_nf}, f_pup0=${pyr2_fp0})"
fi
if [[ "${SAVE_TELEMETRY}" != "none" ]]; then
    echo "[ao3k-scexao]      Flushing ${#TLM_UNITS[@]} telemetry cubes to ${TELEM_DIR}..."
    cleanup_tlm_loggers
    if @exists "s.csim_pup"; then
        fpspipe.savefits "csim_pup" "${TELEM_DIR}/csim_pup.fits"
    fi
    for stg_pair in "1:${STG1_ROOT}" "2:${STG2_ROOT}" "3:${STG3_ROOT}"; do
        sn="${stg_pair%%:*}"
        sroot="${stg_pair#*:}"
        mkdir -p "${TELEM_DIR}/calib_stg${sn}"
        for cf in CMmodesDM.fits CMmodesWFS.fits dmmask.fits wfsmask.fits wfsref.fits \
                  mgainfact.fits rm_meta.env; do
            if [[ -f "${sroot}/conf/${cf}" ]]; then
                cp -fL "${sroot}/conf/${cf}" "${TELEM_DIR}/calib_stg${sn}/${cf}"
            fi
        done
    done
    lat1_val="2.5" lat2_val="2.0" lat3_val="2.0"
    if [[ -f "${STG1_ROOT}/conf/rm_meta.env" ]]; then
        lat1_val="$(awk -F'"' '/^export RM_LATENCYHARDWFR=/{print $2}' \
            "${STG1_ROOT}/conf/rm_meta.env" || echo "2.5")"
    fi
    if [[ -f "${STG2_ROOT}/conf/rm_meta.env" ]]; then
        lat2_val="$(awk -F'"' '/^export RM_LATENCYHARDWFR=/{print $2}' \
            "${STG2_ROOT}/conf/rm_meta.env" || echo "2.0")"
    fi
    if [[ -f "${STG3_ROOT}/conf/rm_meta.env" ]]; then
        lat3_val="$(awk -F'"' '/^export RM_LATENCYHARDWFR=/{print $2}' \
            "${STG3_ROOT}/conf/rm_meta.env" || echo "2.0")"
    fi
    lat1_tot="$(awk -v h="${lat1_val:-1.5}" 'BEGIN { printf "%.3f", h + 1.0 }')"
    lat2_tot="$(awk -v h="${lat2_val:-1.0}" 'BEGIN { printf "%.3f", h + 1.0 }')"
    lat3_tot="$(awk -v h="${lat3_val:-1.5}" 'BEGIN { printf "%.3f", h + 1.0 }')"
    cat > "${TELEM_DIR}/telemetry_manifest.env" <<EOF
TLM_MODE="${SAVE_TELEMETRY}"
TLM_SEEING="${SEEING}"
TLM_PHYS_TIME="${PHYS_TIME}"
TLM_MASTER_TICKS="${MASTER_TICKS}"
TLM_PSF_NAVG="${EFF_PSF_NAVG}"
TLM_TEL_DIAM="7.95"
TLM_NWF="256"
TLM_PUP_DIAM="0.9375"
TLM_COBS="0.307"
TLM_FS1="${WFS1_RATE}.0"
TLM_FS2="2000.0"
TLM_FS3="500.0"
TLM_LAT1="${lat1_tot}"
TLM_LAT2="${lat2_tot}"
TLM_LAT3="${lat3_tot}"
TLM_GAIN1="${GAIN1}"
TLM_GAIN2="${GAIN2}"
TLM_GAIN3="${GAIN3}"
TLM_MULT1="${MULT1}"
TLM_MULT2="${MULT2}"
TLM_MULT3="${MULT3}"
TLM_DM2_DIAM="0.9986413"
TLM_DM2_COUPL="0.15"
TLM_STREAMS="${TLM_SAVED_STREAMS[*]}"
TLM_PUP_FITS="${TELEM_DIR}/csim_pup.fits"
TLM_STG1_CALIB="${TELEM_DIR}/calib_stg1"
TLM_STG2_CALIB="${TELEM_DIR}/calib_stg2"
TLM_STG3_CALIB="${TELEM_DIR}/calib_stg3"
TLM_PARENT_OUT="${OUT_DIR}"
EOF
    cat > "${TELEM_DIR}/telemetry_manifest.json" <<EOF
{
  "mode": "${SAVE_TELEMETRY}",
  "seeing_arcsec": ${SEEING},
  "phys_time_s": ${PHYS_TIME},
  "master_ticks": ${MASTER_TICKS},
  "psf_navg": ${EFF_PSF_NAVG},
  "tel_diam_m": 7.95,
  "fs_stg1_hz": ${WFS1_RATE}.0,
  "fs_stg2_hz": 2000.0,
  "fs_stg3_hz": 500.0,
  "latency_tot_stg1_fr": ${lat1_tot},
  "latency_tot_stg2_fr": ${lat2_tot},
  "latency_tot_stg3_fr": ${lat3_tot},
  "gain1": ${GAIN1},
  "gain2": ${GAIN2},
  "gain3": ${GAIN3},
  "mult1": ${MULT1},
  "mult2": ${MULT2},
  "mult3": ${MULT3},
  "n_streams": ${#TLM_SAVED_STREAMS[@]}
}
EOF
fi
for _ in $(seq 1 100); do
    [[ -s "${OUT_DIR}/wf_stats.json" && -s "${WFSTAT_CPU_DIR}/wf_stats.json" ]] && break
    sleep 0.1
done
if [[ "${SAVE_TELEMETRY}" != "none" ]]; then
    for _cf in wf_clip_raw.fits wf_clip_final.fits dm_clip_opd_stg1.fits \
               dm_clip_opd_stg2.fits wf_clip_meta.json \
               wf_full_raw.fits wf_full_final.fits dm_full_opd_stg1.fits \
               dm_full_opd_stg2.fits wf_full_meta.json; do
        if [[ -f "${OUT_DIR}/${_cf}" ]]; then
            mv -f "${OUT_DIR}/${_cf}" "${TELEM_DIR}/${_cf}"
        fi
    done
fi
if (( CPU_WFSTAT )); then
    milk-fps-rm -f -q --ignore-missing csim_wfstat >/dev/null 2>&1 || true
fi
rm -f "${WFSTAT_LINK}" "${WFSTAT_CPU_LINK}"

d_pha=$(( cnt_pha_1 - cnt_pha_0 ))
d_wfs1=$(( cnt_wfs1_1 - cnt_wfs1_0 ))
d_wfs2=$(( cnt_wfs2_1 - cnt_wfs2_0 ))
d_wfs3=$(( cnt_wfs3_1 - cnt_wfs3_0 ))
d_long=$(( cnt_long_1 - cnt_long_0 ))
WALL_ELAPSED="$(awk -v t0="${t_int_0}" -v t1="${t_int_1}" 'BEGIN { printf "%.2f", t1 - t0 }')"

echo "[ao3k-scexao]      Completed in ${WALL_ELAPSED} s wall-clock:"
echo "[ao3k-scexao]      d(pha)=${d_pha}, d(wfs1)=${d_wfs1}, d(wfs2)=${d_wfs2}," \
     "d(wfs3)=${d_wfs3}, d(long)=${d_long}"

sysmon.mark "save_psfs" "Save PSFs and closed-loop telemetry streams via fpspipe.savefits"
echo "[ao3k-scexao] Step 7/7: Saving integrated PSFs, loop telemetry, & generating reports..."
for cam in vis_raw nir_raw vis_stg1 nir_stg1 vis_final nir_final nir_coro; do
    fpspipe.savefits "psf_${cam}_long" "${OUT_DIR}/psf_${cam}.fits"
    fpspipe.savefits "psf_${cam}" "${OUT_DIR}/det_${cam}.fits"
done
if @exists "s.coro_pre_lyot_long"; then
    fpspipe.savefits "coro_pre_lyot_long" "${OUT_DIR}/coro_pre_lyot.fits"
fi
if @exists "s.coro_pre_lyot"; then
    fpspipe.savefits "coro_pre_lyot" "${OUT_DIR}/coro_pre_lyot_inst.fits"
fi
fpspipe.savefits "csim_wfs_lowfs" "${OUT_DIR}/det_wfs_lowfs.fits"

for n in 1 2 3; do
    for sfx in imWFS2 modevalWFS modevalDM modevalOL mgain mgainfact mmult dmC dmzpo wfszpo \
               mvalWFSrms mvalDMrms mvalOLrms; do
        if @exists "s.aol${n}_${sfx}"; then
            fpspipe.savefits "aol${n}_${sfx}" "${OUT_DIR}/aol${n}_${sfx}.fits"
        fi
    done
done

if (( PREDICTIVE )); then
    for n in 1 2; do
        for sfx in arPFmat eofPFmat modevalPF mPFmix mPFmixfact outPFstat mvalPFresrms; do
            if @exists "s.aol${n}_${sfx}"; then
                fpspipe.savefits "aol${n}_${sfx}" "${OUT_DIR}/aol${n}_${sfx}.fits"
            fi
        done
    done
    pf1_lat=0 pf1_wf=1 pf1_nu=0 pf1_ns=0 pf1_rol=0 pf1_rz=0 pf1_rp=0 pf1_vr=0 pf1_af=0 pf1_to=0
    pf2_lat=0 pf2_wf=1 pf2_nu=0 pf2_ns=0 pf2_rol=0 pf2_rz=0 pf2_rp=0 pf2_vr=0 pf2_af=0 pf2_to=0
    pf1_ea=0 pf1_neu=0 pf1_odf=0 pf1_lam=0 pf2_ea=0 pf2_neu=0 pf2_odf=0 pf2_lam=0
    @get pf1_lat="f.${PF_MK_PFX}-1.PFlatency" pf1_wf="f.mfilt-1.comp.WFSfact" \
         pf1_nu="f.${PF_MK_PFX}-1.out.n_updates" pf1_ns="f.${PF_MK_PFX}-1.out.n_samples" \
         pf1_rol="f.${PF_MK_PFX}-1.out.rms_ol" pf1_rz="f.${PF_MK_PFX}-1.out.rms_zoh" \
         pf1_rp="f.${PF_MK_PFX}-1.out.rms_pred" pf1_vr="f.${PF_MK_PFX}-1.out.var_red_pct" \
         pf1_af="f.${PF_APP_PFX}-1.out.active_frames" pf1_to="f.mfilt-1.PF.timeout_cnt" \
         pf2_lat="f.${PF_MK_PFX}-2.PFlatency" pf2_wf="f.mfilt-2.comp.WFSfact" \
         pf2_nu="f.${PF_MK_PFX}-2.out.n_updates" pf2_ns="f.${PF_MK_PFX}-2.out.n_samples" \
         pf2_rol="f.${PF_MK_PFX}-2.out.rms_ol" pf2_rz="f.${PF_MK_PFX}-2.out.rms_zoh" \
         pf2_rp="f.${PF_MK_PFX}-2.out.rms_pred" pf2_vr="f.${PF_MK_PFX}-2.out.var_red_pct" \
         pf2_af="f.${PF_APP_PFX}-2.out.active_frames" pf2_to="f.mfilt-2.PF.timeout_cnt"
    if [[ "${PF_MODE}" == "eof" ]]; then
        pf1_eff=0 pf1_phy=0 pf1_fx=0 pf1_rk=0 pf1_sw=0
        pf1_rzo=0 pf1_rpo=0 pf1_vro=0 pf1_ovr=0 pf1_rhod=0
        pf2_eff=0 pf2_phy=0 pf2_fx=0 pf2_rk=0 pf2_sw=0
        pf2_rzo=0 pf2_rpo=0 pf2_vro=0 pf2_ovr=0 pf2_rhod=0
        @get pf1_ea="f.${PF_MK_PFX}-1.out.eof_active" \
             pf1_neu="f.${PF_MK_PFX}-1.out.n_eof_updates" \
             pf1_odf="f.${PF_MK_PFX}-1.out.offdiag_frac" \
             pf1_lam="f.${PF_MK_PFX}-1.out.last_lam" \
             pf1_eff="f.${PF_MK_PFX}-1.out.eff_samples" \
             pf1_phy="f.${PF_MK_PFX}-1.out.phys_active" \
             pf1_fx="f.${PF_MK_PFX}-1.out.fx_active" \
             pf1_rk="f.${PF_MK_PFX}-1.out.regime_k" \
             pf1_sw="f.${PF_MK_PFX}-1.out.wl_switches" \
             pf1_rzo="f.${PF_MK_PFX}-1.out.rms_zoh_oos" \
             pf1_rpo="f.${PF_MK_PFX}-1.out.rms_pred_oos" \
             pf1_vro="f.${PF_MK_PFX}-1.out.var_red_oos_pct" \
             pf1_ovr="f.${PF_MK_PFX}-1.out.overfit_ratio" \
             pf1_rhod="f.${PF_MK_PFX}-1.out.oos_rho_d_b0" \
             pf2_ea="f.${PF_MK_PFX}-2.out.eof_active" \
             pf2_neu="f.${PF_MK_PFX}-2.out.n_eof_updates" \
             pf2_odf="f.${PF_MK_PFX}-2.out.offdiag_frac" \
             pf2_lam="f.${PF_MK_PFX}-2.out.last_lam" \
             pf2_eff="f.${PF_MK_PFX}-2.out.eff_samples" \
             pf2_phy="f.${PF_MK_PFX}-2.out.phys_active" \
             pf2_fx="f.${PF_MK_PFX}-2.out.fx_active" \
             pf2_rk="f.${PF_MK_PFX}-2.out.regime_k" \
             pf2_sw="f.${PF_MK_PFX}-2.out.wl_switches" \
             pf2_rzo="f.${PF_MK_PFX}-2.out.rms_zoh_oos" \
             pf2_rpo="f.${PF_MK_PFX}-2.out.rms_pred_oos" \
             pf2_vro="f.${PF_MK_PFX}-2.out.var_red_oos_pct" \
             pf2_ovr="f.${PF_MK_PFX}-2.out.overfit_ratio" \
             pf2_rhod="f.${PF_MK_PFX}-2.out.oos_rho_d_b0" 2>/dev/null || true
    fi
    cat > "${OUT_DIR}/pf_stats.json" <<EOF
{
  "enabled": true,
  "pf_mode": "${PF_MODE}",
  "pf_blocksize": ${PF_BLOCKSIZE},
  "pf_order": ${PF_ORDER},
  "pf_mix": ${PF_MIX},
  "pf_mix2": ${PF_MIX2},
  "pf_reg": ${PF_REG},
  "pf_reg2": ${PF_REG2},
  "pf_warmup_sec": ${PF_WARMUP_SEC},
  "pf_mgain_exp": ${PF_MGAIN_EXP},
  "stage1": {
    "pflatency_fr": ${pf1_lat:-0},
    "wfsfact": ${pf1_wf:-1},
    "n_updates": ${pf1_nu:-0},
    "n_eof_updates": ${pf1_neu:-0},
    "eof_active": ${pf1_ea:-0},
    "n_samples": ${pf1_ns:-0},
    "eff_samples": ${pf1_eff:-0},
    "phys_active": ${pf1_phy:-0},
    "fx_active": ${pf1_fx:-0},
    "regime_k": ${pf1_rk:-0},
    "wl_switches": ${pf1_sw:-0},
    "rms_ol": ${pf1_rol:-0},
    "rms_zoh": ${pf1_rz:-0},
    "rms_pred": ${pf1_rp:-0},
    "var_red_pct": ${pf1_vr:-0},
    "rms_zoh_oos": ${pf1_rzo:-0},
    "rms_pred_oos": ${pf1_rpo:-0},
    "var_red_oos_pct": ${pf1_vro:-0},
    "overfit_ratio": ${pf1_ovr:-0},
    "oos_rho_d_b0": ${pf1_rhod:-0},
    "offdiag_frac": ${pf1_odf:-0},
    "last_lam": ${pf1_lam:-0},
    "active_frames": ${pf1_af:-0},
    "timeout_cnt": ${pf1_to:-0}
  },
  "stage2": {
    "pflatency_fr": ${pf2_lat:-0},
    "wfsfact": ${pf2_wf:-1},
    "n_updates": ${pf2_nu:-0},
    "n_eof_updates": ${pf2_neu:-0},
    "eof_active": ${pf2_ea:-0},
    "n_samples": ${pf2_ns:-0},
    "eff_samples": ${pf2_eff:-0},
    "phys_active": ${pf2_phy:-0},
    "fx_active": ${pf2_fx:-0},
    "regime_k": ${pf2_rk:-0},
    "wl_switches": ${pf2_sw:-0},
    "rms_ol": ${pf2_rol:-0},
    "rms_zoh": ${pf2_rz:-0},
    "rms_pred": ${pf2_rp:-0},
    "var_red_pct": ${pf2_vr:-0},
    "rms_zoh_oos": ${pf2_rzo:-0},
    "rms_pred_oos": ${pf2_rpo:-0},
    "var_red_oos_pct": ${pf2_vro:-0},
    "overfit_ratio": ${pf2_ovr:-0},
    "oos_rho_d_b0": ${pf2_rhod:-0},
    "offdiag_frac": ${pf2_odf:-0},
    "last_lam": ${pf2_lam:-0},
    "active_frames": ${pf2_af:-0},
    "timeout_cnt": ${pf2_to:-0}
  }
}
EOF
    pf1_vr_mr=0
    if [[ "${PF_MODE}" == "eof" ]]; then
        @get pf1_vr_mr="f.${PF_MK_PFX}-1.out.mr_vel_rms" 2>/dev/null || true
    fi
    mp1_in=0 mp1_out=0 mp1_pk=0
    if (( MR_DM1 )) && @exists "f.mvalpacer-1"; then
        @get mp1_in="f.mvalpacer-1.out.in_cnt" \
             mp1_out="f.mvalpacer-1.out.out_cnt" \
             mp1_pk="f.mvalpacer-1.out.peak_ramp" 2>/dev/null || true
    fi
    ps1_in=0 ps1_out=0 ps1_pk=0 ps1_cl=0 ps1_hz=0
    if [[ -n "${DM1_PRESHAPER}" ]] && @exists "f.dmpreshaper-01"; then
        @get ps1_in="f.dmpreshaper-01.out.in_cnt" \
             ps1_out="f.dmpreshaper-01.out.out_cnt" \
             ps1_pk="f.dmpreshaper-01.out.peak_corr" \
             ps1_cl="f.dmpreshaper-01.out.clip_cnt" \
             ps1_hz="f.dmpreshaper-01.out.rate_hz" 2>/dev/null || true
    fi
    cat > "${OUT_DIR}/multirate_preshaper_stats.json" <<EOF
{
  "wfs1_rate_hz": ${WFS1_RATE},
  "wfs1_decim": ${WFS1_DECIM},
  "mr_dm1": ${MR_DM1},
  "mr_substeps": ${MR_SUBSTEPS},
  "mr_dm1_hz": ${MR_DM1_HZ},
  "mr_vel_gain": ${MR_VEL_GAIN},
  "mr_vel_reg_mult": ${MR_VEL_REG_MULT},
  "mk_mr_vel_rms": ${pf1_vr_mr:-0},
  "mvalpacer1": {
    "in_cnt": ${mp1_in:-0},
    "out_cnt": ${mp1_out:-0},
    "peak_ramp": ${mp1_pk:-0}
  },
  "dmpreshaper01": {
    "enabled": $( [[ -n "${DM1_PRESHAPER}" ]] && echo "true" || echo "false" ),
    "rate_hz": ${ps1_hz:-0},
    "in_cnt": ${ps1_in:-0},
    "out_cnt": ${ps1_out:-0},
    "peak_corr": ${ps1_pk:-0},
    "clip_cnt": ${ps1_cl:-0}
  }
}
EOF
    echo "[ao3k-scexao]      Multi-rate/Pre-shaper: WFS1=${WFS1_RATE}Hz, MR=${MR_DM1} (K=${MR_SUBSTEPS}, pacer in=${mp1_in} out=${mp1_out} pk_ramp=${mp1_pk}, vel_rms=${pf1_vr_mr}) | preshaper in=${ps1_in} out=${ps1_out} pk_corr=${ps1_pk} clip=${ps1_cl}"
    if (( SELFLEARN )); then
        sl1_fr=0 sl1_up=0 sl1_gr=0 sl1_nc=0 sl1_a0=0 sl1_a1=0 sl1_v0=0 sl1_vt=0 sl1_tr=0 sl1_l1=0
        sl2_fr=0 sl2_up=0 sl2_gr=0 sl2_nc=0 sl2_a0=0 sl2_a1=0 sl2_v0=0 sl2_vt=0 sl2_tr=0 sl2_l1=0
        if @exists "f.selflearn-1"; then
            @get sl1_fr="f.selflearn-1.out.frames" sl1_up="f.selflearn-1.out.updates" \
                 sl1_gr="f.selflearn-1.out.gric_active" sl1_nc="f.selflearn-1.out.n_clusters" \
                 sl1_a0="f.selflearn-1.out.alpha_l0" sl1_a1="f.selflearn-1.out.alpha_l1" \
                 sl1_v0="f.selflearn-1.out.oos_vr_l0_pct" sl1_vt="f.selflearn-1.out.oos_vr_tot_pct" \
                 sl1_tr="f.selflearn-1.out.tweak_rms" sl1_l1="f.selflearn-1.out.l1_rms" 2>/dev/null || true
        fi
        if @exists "f.selflearn-2"; then
            @get sl2_fr="f.selflearn-2.out.frames" sl2_up="f.selflearn-2.out.updates" \
                 sl2_gr="f.selflearn-2.out.gric_active" sl2_nc="f.selflearn-2.out.n_clusters" \
                 sl2_a0="f.selflearn-2.out.alpha_l0" sl2_a1="f.selflearn-2.out.alpha_l1" \
                 sl2_v0="f.selflearn-2.out.oos_vr_l0_pct" sl2_vt="f.selflearn-2.out.oos_vr_tot_pct" \
                 sl2_tr="f.selflearn-2.out.tweak_rms" sl2_l1="f.selflearn-2.out.l1_rms" 2>/dev/null || true
        fi
        cat > "${OUT_DIR}/selflearn_stats.json" <<EOF
{
  "enabled": true,
  "nbmodemax": ${SELFLEARN_MODES},
  "kmax": ${SELFLEARN_KMAX},
  "stage1": {
    "frames": ${sl1_fr:-0},
    "updates": ${sl1_up:-0},
    "gric_active": ${sl1_gr:-0},
    "n_clusters": ${sl1_nc:-0},
    "alpha_l0": ${sl1_a0:-0},
    "alpha_l1": ${sl1_a1:-0},
    "oos_vr_l0_pct": ${sl1_v0:-0},
    "oos_vr_tot_pct": ${sl1_vt:-0},
    "tweak_rms": ${sl1_tr:-0},
    "l1_rms": ${sl1_l1:-0}
  },
  "stage2": {
    "frames": ${sl2_fr:-0},
    "updates": ${sl2_up:-0},
    "gric_active": ${sl2_gr:-0},
    "n_clusters": ${sl2_nc:-0},
    "alpha_l0": ${sl2_a0:-0},
    "alpha_l1": ${sl2_a1:-0},
    "oos_vr_l0_pct": ${sl2_v0:-0},
    "oos_vr_tot_pct": ${sl2_vt:-0},
    "tweak_rms": ${sl2_tr:-0},
    "l1_rms": ${sl2_l1:-0}
  }
}
EOF
        echo "[ao3k-scexao]      Cascaded Self-Learning (libgric): Stg1[K=${sl1_nc}, a0=${sl1_a0}, a1=${sl1_a1}, vr=${sl1_vt}%] | Stg2[K=${sl2_nc}, a0=${sl2_a0}, a1=${sl2_a1}, vr=${sl2_vt}%]"
    fi
fi

if (( ! PREDICTIVE )); then
    ps1_in=0 ps1_out=0 ps1_pk=0 ps1_cl=0 ps1_hz=0
    if [[ -n "${DM1_PRESHAPER}" ]] && @exists "f.dmpreshaper-01"; then
        @get ps1_in="f.dmpreshaper-01.out.in_cnt" \
             ps1_out="f.dmpreshaper-01.out.out_cnt" \
             ps1_pk="f.dmpreshaper-01.out.peak_corr" \
             ps1_cl="f.dmpreshaper-01.out.clip_cnt" \
             ps1_hz="f.dmpreshaper-01.out.rate_hz" 2>/dev/null || true
    fi
    cat > "${OUT_DIR}/multirate_preshaper_stats.json" <<EOF
{
  "wfs1_rate_hz": ${WFS1_RATE},
  "wfs1_decim": ${WFS1_DECIM},
  "mr_dm1": ${MR_DM1},
  "mr_substeps": ${MR_SUBSTEPS},
  "mr_dm1_hz": ${MR_DM1_HZ},
  "mr_vel_gain": ${MR_VEL_GAIN},
  "mr_vel_reg_mult": ${MR_VEL_REG_MULT},
  "mk_mr_vel_rms": 0,
  "mvalpacer1": {"in_cnt": 0, "out_cnt": 0, "peak_ramp": 0},
  "dmpreshaper01": {
    "enabled": $( [[ -n "${DM1_PRESHAPER}" ]] && echo "true" || echo "false" ),
    "rate_hz": ${ps1_hz:-0},
    "in_cnt": ${ps1_in:-0},
    "out_cnt": ${ps1_out:-0},
    "peak_corr": ${ps1_pk:-0},
    "clip_cnt": ${ps1_cl:-0}
  }
}
EOF
    echo "[ao3k-scexao]      Pre-shaper (integrator): WFS1=${WFS1_RATE}Hz | preshaper in=${ps1_in} out=${ps1_out} pk_corr=${ps1_pk} clip=${ps1_cl}"
fi

if (( ONLINE_OG1 )); then
    og1_med=1 og1_lo=1 og1_hi=1 og1_nv=0 og1_ns=0 og1_ac=0
    @get og1_med="f.modalog-1.out.og_med" og1_lo="f.modalog-1.out.og_lo_med" \
         og1_hi="f.modalog-1.out.og_hi_med" og1_nv="f.modalog-1.out.n_valid_modes" \
         og1_ns="f.modalog-1.out.n_samples" og1_ac="f.modalog-1.out.applied_cnt" \
         2>/dev/null || true
    cat > "${OUT_DIR}/online_og_stg1.json" <<EOF
{
  "og_med": ${og1_med:-1},
  "og_lo_med": ${og1_lo:-1},
  "og_hi_med": ${og1_hi:-1},
  "n_valid_modes": ${og1_nv:-0},
  "n_samples": ${og1_ns:-0},
  "applied_cnt": ${og1_ac:-0}
}
EOF
    if @exists "s.aol1_mWFSfact"; then
        fpspipe.savefits "aol1_mWFSfact" "${OUT_DIR}/aol1_mWFSfact.fits"
    fi
    @set "f.mfilt-1.comp.ogprobe.enable=OFF" >/dev/null 2>&1 || true
    milk-fps-runstop -q modalog-1 >/dev/null 2>&1 || true
fi
if @exists "s.aol2_mWFSfact"; then
    fpspipe.savefits "aol2_mWFSfact" "${OUT_DIR}/aol2_mWFSfact.fits"
fi
if (( WINDLAYERS1 )); then
    milk-fps-runstop -q wl-1 >/dev/null 2>&1 || true
    milk-fps-wait -q -t 10 wl-1 >/dev/null 2>&1 || true
    for _wls in wl1_layers wl1_vmapk wl1_vmapi wl1_vmapx wl1_pupgeom; do
        if @exists "s.${_wls}"; then
            fpspipe.savefits "${_wls}" "${OUT_DIR}/${_wls}.fits"
        fi
    done
    milk-fps-info wl-1 > "${OUT_DIR}/wl1_info.txt" 2>/dev/null || true
    rm -f "${WL1_LINK}" >/dev/null 2>&1 || true
fi

if (( RUN_MODALWHITE )) && command -v cacao-fpsexec-modalwhite >/dev/null 2>&1; then
    sysmon.mark "modalwhite" "Run closed-loop modal whiteness monitor (cacao-fpsexec-modalwhite)"
    echo "[ao3k-scexao]   -> Running closed-loop modal whiteness audit (modalwhite)..."
    _mw_run_stage() {
        local _stg="$1" _lat="$2" _outjson="$3"
        local _wfs="aol${_stg}_modevalWFS_buff" _dm="aol${_stg}_modevalDM_buff"
        local _unit="mw-${_stg}" _nbwin=4096 _tmp_loaded=0
        if [[ "${SAVE_TELEMETRY}" != "none" && -d "${TELEM_DIR}" ]]; then
            local _mw_wfs_f="${WORK_ROOT}/mw${_stg}_wfs.fits"
            local _mw_dm_f="${WORK_ROOT}/mw${_stg}_dm.fits"
            local _mw_n=""
            _mw_n="$("${PYTHON_BIN:-python3}" - "${TELEM_DIR}" "${_stg}" "${_mw_wfs_f}" "${_mw_dm_f}" <<'PY'
import glob, os, sys
import numpy as np
from astropy.io import fits
tdir, stg, out_w, out_d = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
wf = sorted(glob.glob(os.path.join(tdir, f"aol{stg}_modevalWFS_*.fits")))
df = sorted(glob.glob(os.path.join(tdir, f"aol{stg}_modevalDM_*.fits")))
if not wf:
    print("0"); raise SystemExit(0)
def load_cat(paths):
    cs = []
    for p in paths:
        a = np.asarray(fits.getdata(p), dtype=np.float32)
        if a.ndim == 3:
            a = a.reshape(a.shape[0], -1)
        if a.ndim == 2 and a.shape[0] > 0:
            cs.append(a)
    return np.concatenate(cs, axis=0) if cs else None
wc = load_cat(wf)
if wc is None or wc.shape[0] < 64:
    print("0"); raise SystemExit(0)
n_fr = min(int(wc.shape[0]), 4096)
n_m = min(int(wc.shape[1]), 256)
fits.writeto(out_w, np.ascontiguousarray(wc[-n_fr:, :n_m], dtype=np.float32), overwrite=True)
dc = load_cat(df) if df else None
if dc is not None and dc.shape[0] >= n_fr:
    fits.writeto(out_d, np.ascontiguousarray(dc[-n_fr:, :n_m], dtype=np.float32), overwrite=True)
print(n_fr)
PY
            )"
            if [[ -n "${_mw_n}" && "${_mw_n}" -ge 64 && -f "${_mw_wfs_f}" ]]; then
                fpspipe.loadfits "mw${_stg}_wfs" "${_mw_wfs_f}" .force=1
                _wfs="mw${_stg}_wfs"
                _nbwin="${_mw_n}"
                _dm="none"
                if [[ -f "${_mw_dm_f}" ]]; then
                    fpspipe.loadfits "mw${_stg}_dm" "${_mw_dm_f}" .force=1
                    _dm="mw${_stg}_dm"
                fi
                _tmp_loaded=1
            fi
        fi
        if ! @exists "s.${_wfs}"; then
            return 0
        fi
        local _dm_arg="none"
        if [[ "${_dm}" != "none" ]] && @exists "s.${_dm}"; then
            _dm_arg="${_dm}"
        fi
        milk-fps-rm -f -q --ignore-missing "${_unit}" >/dev/null 2>&1 || true
        milk-fps-init -q "${_unit}" cacao-fpsexec-modalwhite >/dev/null
        milk-fps-set -q \
            "${_unit}.AOloopindex=${_stg}" \
            "${_unit}.inWFSbuff=${_wfs}" \
            "${_unit}.inDMbuff=${_dm_arg}" \
            "${_unit}.latency_fr=${_lat}" \
            "${_unit}.NBwin=${_nbwin}" \
            "${_unit}.K_lags=16" \
            "${_unit}.P_recov=8" \
            "${_unit}.P_ctrl=${PF_ORDER:-14}" \
            "${_unit}.blocksize=${PF_BLOCKSIZE:-128}" \
            "${_unit}.procinfo.triggermode=0" \
            "${_unit}.procinfo.loopcntMax=1"
        milk-fps-runstart -q "${_unit}"
        milk-fps-wait -q -t 25 "${_unit}" >/dev/null 2>&1 || true
        local _ns=0 _dc=0 _wrms=0 _rwfe=0 _rvar=0 _b0r=0 _qall=0 _qb0=0 _qlo=0 _qby=0 _qxm=0 _qxb=0 _rhod=0 _clf=0 _rwu=0 _qwu=0 _wur=0 _af=0
        @get _ns="f.${_unit}.out.n_samples" _dc="f.${_unit}.out.d_ceil" \
             _wrms="f.${_unit}.out.wfs_rms_nm" _rwfe="f.${_unit}.out.recov_wfe_nm" \
             _rvar="f.${_unit}.out.recov_var_pct" _b0r="f.${_unit}.out.b0_recov_wfe_nm" \
             _qall="f.${_unit}.out.Q_vw_all" _qb0="f.${_unit}.out.Q_vw_b0" \
             _qlo="f.${_unit}.out.Q_lo20" _qby="f.${_unit}.out.Q_beyond_b0" \
             _qxm="f.${_unit}.out.Q_xmode_b0" _qxb="f.${_unit}.out.Q_xblk_b01" \
             _rhod="f.${_unit}.out.rho_d_b0" _clf="f.${_unit}.out.cliff_ratio_b0" \
             _rwu="f.${_unit}.out.rwu_d_lo20" _qwu="f.${_unit}.out.Q_wu_lo20" \
             _wur="f.${_unit}.out.wu_recov_wfe_nm" _af="f.${_unit}.out.alert_flags" \
             2>/dev/null || true
        milk-fps-info "${_unit}" > "${OUT_DIR}/modalwhite_stg${_stg}_info.txt" 2>/dev/null || true
        milk-fps-rm -f -q --ignore-missing "${_unit}" >/dev/null 2>&1 || true
        if (( _tmp_loaded )); then
            milk-stream-rm -f -q --ignore-missing "mw${_stg}_wfs" "mw${_stg}_dm" >/dev/null 2>&1 || true
        fi
        cat > "${_outjson}" <<MWEOF
{
  "stage": ${_stg},
  "latency_fr": ${_lat},
  "n_samples": ${_ns:-0},
  "d_ceil": ${_dc:-0},
  "wfs_rms_nm": ${_wrms:-0},
  "recov_wfe_nm": ${_rwfe:-0},
  "recov_var_pct": ${_rvar:-0},
  "b0_recov_wfe_nm": ${_b0r:-0},
  "Q_vw_all": ${_qall:-0},
  "Q_vw_b0": ${_qb0:-0},
  "Q_lo20": ${_qlo:-0},
  "Q_beyond_b0": ${_qby:-0},
  "Q_xmode_b0": ${_qxm:-0},
  "Q_xblk_b01": ${_qxb:-0},
  "rho_d_b0": ${_rhod:-0},
  "cliff_ratio_b0": ${_clf:-0},
  "rwu_d_lo20": ${_rwu:-0},
  "Q_wu_lo20": ${_qwu:-0},
  "wu_recov_wfe_nm": ${_wur:-0},
  "alert_flags": ${_af:-0}
}
MWEOF
        echo "[ao3k-scexao]      modalwhite Stg${_stg}: N=${_ns} d=${_dc} Q_vw_b0=${_qb0} Q_xmode_b0=${_qxm} rho_d=${_rhod} recov=${_rwfe}nm (${_rvar}%) Q_wu_lo20=${_qwu} alerts=${_af}"
    }
    _mw_run_stage 1 "${tol1_lat:-2.5}" "${WORK_ROOT}/mw_stg1.json"
    if (( ENABLE_STAGE2 )); then
        _mw_run_stage 2 "${tol2_lat:-2.0}" "${WORK_ROOT}/mw_stg2.json"
    fi
    "${PYTHON_BIN:-python3}" - "${OUT_DIR}/modalwhite_stats.json" \
        "${WORK_ROOT}/mw_stg1.json" "${WORK_ROOT}/mw_stg2.json" <<'PY'
import json, os, sys
out_p, s1_p, s2_p = sys.argv[1], sys.argv[2], sys.argv[3]
res = {"enabled": True, "stages": {}}
for k, p in (("stage1", s1_p), ("stage2", s2_p)):
    if os.path.isfile(p):
        with open(p, "r", encoding="utf-8") as fh:
            res["stages"][k] = json.load(fh)
with open(out_p, "w", encoding="utf-8") as fh:
    json.dump(res, fh, indent=2)
    fh.write("\n")
PY
fi

if (( RUN_SELFRM )); then
    sysmon.mark "selfrm_onsky" "Closed-loop on-sky selfRM probing (Stage 1, 2 & 3)"
    echo "[ao3k-scexao] Step 6b/7: Acquiring on-sky closed-loop selfRM (${SEEING}\" seeing)..."
    t_srms_0="$(date +%s)"
    if (( PREDICTIVE )); then
        CACAO_LOOPROOTDIR="${STG1_ROOT}" CACAO_PF_MODE="${PF_MODE}" "${LOOP_CTRL}" --stage 1 pf-off
        CACAO_LOOPROOTDIR="${STG2_ROOT}" CACAO_PF_MODE="${PF_MODE}" "${LOOP_CTRL}" --stage 2 pf-off
    fi
    SRM_ONSKY_DT="${ATM_TRIG_DT}"
    if [[ "${BENCH_MODE}" == "fused" ]]; then
        @set "f.csim_htsim.enable_fpcam=OFF"
    fi
    milk-fps-set -q "csim_atmturb.procinfo.triggerdelay=${SRM_ONSKY_DT}"
    milk-stream-wait -q -t 30 "csim_wfs_vis+40"

    CACAO_LOOPROOTDIR="${STG1_ROOT}" "${LOOP_CTRL}" --stage 1 selfrm \
        "${OUT_DIR}/selfRM_onsky_stg1.fits" \
        --nbmode "${SELFRM_MODES}" --ampl 0.030 --nbiter "${SELFRM_ONSKY_ITER}" --nbsettle 6
    milk-stream-wait -q -t 30 "csim_wfs_vis+40"

    CACAO_LOOPROOTDIR="${STG2_ROOT}" "${LOOP_CTRL}" --stage 2 selfrm \
        "${OUT_DIR}/selfRM_onsky_stg2.fits" \
        --nbmode "${SELFRM_MODES}" --ampl 0.020 --nbiter "${SELFRM_ONSKY_ITER}" --nbsettle 6
    milk-stream-wait -q -t 30 "csim_wfs_lowfs+20"

    CACAO_LOOPROOTDIR="${STG3_ROOT}" "${LOOP_CTRL}" --stage 3 selfrm \
        "${OUT_DIR}/selfRM_onsky_stg3.fits" \
        --nbmode 14 --ampl 0.025 --nbiter "${SELFRM_ONSKY_ITER}" --nbsettle 6

    if (( PREDICTIVE )); then
        WFS_DARKSUB_EFF="OFF"
WFS_DARK_ADU_EFF="0.0"
WFS_NORMFLOOR_EFF="1.0"
